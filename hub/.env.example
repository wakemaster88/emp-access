# URL der EMP-Access-Cloud (Vercel-Deployment)
HUB_API_URL=https://emp-access.vercel.app

# Account-API-Token (in der App unter Einstellungen / API zu finden)
HUB_API_TOKEN=

# Name dieses Hubs (eindeutig pro Standort/Rechner)
HUB_NAME=imac-technikraum

# Intervalle in Sekunden (optional)
HUB_HEARTBEAT_INTERVAL=60
HUB_TASK_INTERVAL=5
HUB_UPDATE_INTERVAL=300
# Automatischer Netzwerk-Scan mit Cloud-Upload (Sekunden)
HUB_SCAN_INTERVAL=1800

# SNMP (NETGEAR): komma-getrennte Switch-IPs, Community
# HUB_SNMP_TARGETS=192.168.1.2
# HUB_SNMP_COMMUNITY=public
# HUB_SNMP_INTERVAL=900

# Port des lokalen Dashboards (http://localhost:8787, optional)
HUB_DASHBOARD_PORT=8787

# Dashboard vom Handy/Tablet erreichbar machen. Ohne Token bleibt es strikt
# auf 127.0.0.1. Mit Token bindet der Server ans LAN und verlangt ihn bei
# jedem Zugriff von aussen (Aufruf einmal mit ?token=…, danach Cookie).
# Kein HTTPS – nur im vertrauenswuerdigen Heimnetz verwenden.
# HUB_DASHBOARD_TOKEN=langes-zufaelliges-geheimnis
# HUB_DASHBOARD_HOST=0.0.0.0

# Automatisches Verbesserungslog (JSONL + Snapshot alle N Sekunden)
# HUB_IMPROVE_LOG=0
# HUB_IMPROVE_INTERVAL=300

# fast-alpr (YOLO-Plattendetektor + Plate-OCR, hub/alpr) – primäre Stufe
# Setup: hub/alpr/setup.sh (braucht Python 3.12: brew install python@3.12)
# HUB_ALPR=0                   # deaktivieren (dann nur macOS Vision)
# HUB_ALPR_MIN_CONF=0.88       # Auto-Übernahme ohne Whitelist-Treffer
# HUB_ALPR_TIMEOUT_MS=20000

# Kennzeichen-OCR (macOS Vision, hub/plate) – Fallback nach fast-alpr
# HUB_PLATE_OCR=never          # deaktivieren
# HUB_PLATE_MIN_CONF=0.8       # Mindest-Confidence ohne Whitelist-Treffer
# HUB_PLATE_TIMEOUT_MS=45000
# HUB_PLATE_EARLY_STOP_CONF=0.85

# Fahrzeug-Burst (Testphase): dichter lokal, OCR wählt Frame
# HUB_VEHICLE_BURST_COUNT=20   # max Frames solange VEHICLE aktiv
# HUB_VEHICLE_BURST_GAP_MS=400
# HUB_VEHICLE_GRACE_FRAMES=3   # weiter snappen wenn Alarm kurz flackert
# HUB_VEHICLE_DUMP_DIR=        # Default: hub/.cache/veh-burst (nicht /tmp)
# HUB_VEHICLE_DUMP=0           # lokalen Burst-Dump aus
# HUB_VEHICLE_DUMP_MAX=150     # Rotation: max Ordner
# HUB_VEHICLE_DUMP_MAX_AGE_H=48
# HUB_VEHICLE_VISION=auto      # always|never|auto (Fallback ohne Plate)
# HUB_VISION_TIMEOUT_MS=5000   # YOLO /classify Timeout (4K-JPEGs)
# HUB_VEHICLE_MIN_AREA=0.02    # Fahrzeug-Box muss >= 2 % der Bildfläche sein,
#                              # sonst zählt sie als Hintergrund (Parkplatz, Straße)
# HUB_VEHICLE_ZONE=            # optional: Einfahrtszone als Polygon, normiert 0..1,
#                              # z. B. 0.05,0.15;0.75,0.05;0.95,0.7;0.1,0.95
# HUB_VEHICLE_ZONE_9=          # dasselbe nur für Kamera-ID 9 (hat Vorrang)
# HUB_PLATE_REPEAT_MS=60000    # gleiches Kennzeichen je Kamera nur einmal pro Minute melden
# HUB_ALPR_STARTUP_TIMEOUT_MS=60000  # danach Pause 5→30 min, dann neuer Startversuch

# Log-Abruf aus der Cloud (Task HUB_LOG): Pfade nur setzen, wenn sie vom
# launchd-Standard (~/Library/Logs/emp-hub.log) abweichen
# HUB_LOG_DIR=
# HUB_LOG_FILE=
# HUB_ERROR_LOG_FILE=
