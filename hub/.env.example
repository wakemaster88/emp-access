# URL der EMP-Access-Cloud (Vercel-Deployment)
HUB_API_URL=https://emp-access.vercel.app

# Account-API-Token (in der App unter Einstellungen / API zu finden)
HUB_API_TOKEN=

# Name dieses Hubs (eindeutig pro Standort/Rechner)
HUB_NAME=imac-technikraum

# Intervalle in Sekunden (optional)
HUB_HEARTBEAT_INTERVAL=30
HUB_TASK_INTERVAL=5
HUB_UPDATE_INTERVAL=300
# Automatischer Netzwerk-Scan mit Cloud-Upload (Sekunden)
HUB_SCAN_INTERVAL=300

# Port des lokalen Dashboards (http://localhost:8787, optional)
HUB_DASHBOARD_PORT=8787

# Kennzeichen-OCR (macOS Vision, hub/plate) – after Fahrzeug-Snap
# HUB_PLATE_OCR=never          # deaktivieren
# HUB_PLATE_MIN_CONF=0.55      # Mindest-Confidence ohne Whitelist-Treffer
# HUB_PLATE_TIMEOUT_MS=45000
