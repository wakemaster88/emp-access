generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum DeviceType {
  RASPBERRY_PI
  SHELLY
  NUKI_SMARTLOCK
  GARDENA_VALVE
  AUDIO_PLAYER
  /// LOQED Touch bzw. Pure – Schloss mit drei Riegelzustaenden (offen,
  /// Tagverriegelung, abgeschlossen). Laeuft ueber die LOQED Integrations-API,
  /// NICHT ueber die Shelly Cloud: Die kennt das Schloss zwar und liefert
  /// seinen Zustand, nimmt aber keine Befehle dafuer an.
  LOQED_SMARTLOCK
  /// Philips-Hue-Lampe hinter einer Hue Bridge. Nur im LAN erreichbar: Der
  /// Hub schaltet sie, Befehle aus der Cloud gehen als Hub-Task (HUE_SET).
  HUE_LIGHT
  /// Mammotion-Maehroboter (Luba). Haengt an der Mammotion-Cloud; der Hub
  /// meldet Zustand und Karte (POST /api/hub/mower-sync) und fuehrt Befehle
  /// aus der Cloud als Hub-Task MOWER_ACTION aus.
  MAMMOTION_MOWER
}

enum DeviceCategory {
  DREHKREUZ
  TUER
  SENSOR
  SCHALTER
  BELEUCHTUNG
  AUDIO
  /// Markise – Antrieb mit zwei Fahrtrichtungen (Auf/Stopp/Zu).
  MARKISE
  /// Rolltor, Rollladen oder Sektionaltor – gleiche Steuerlogik wie MARKISE.
  ROLLTOR
  /// Taster – schaltet auf Knopfdruck fuer eine feste Dauer ein und faellt
  /// danach von selbst wieder ab (Aussendusche, Wasserhahn, Torimpuls).
  TASTER
}

enum TicketStatus {
  VALID
  REDEEMED
  INVALID
  PROTECTED
  PAUSED
  CANCELED
}

enum ValidityType {
  DATE_RANGE
  TIME_SLOT
  DURATION
}

enum VoucherKind {
  ACCESS
  BENEFIT
}

/// Gamification: was ein Meilenstein zaehlt.
enum GamiMetric {
  VISIT_DAYS
  STARTS
  STREAK_WEEKS
  /// Besuchstage mit Start in der ersten Stunde nach dem ersten Start des Tages.
  EARLY_DAYS
  /// Wochenenden in Folge mit mindestens einem Besuchstag.
  WEEKENDS
  /// Besuchstage an Aktionstagen (`Milestone.eventDays`), z. B. Opening.
  EVENT_DAYS
  /// Saisons mit mindestens einem Besuchstag (nur mit Zeitraum ALL_TIME).
  SEASONS
  /// Start am ersten Tag des Jahres, an dem ueberhaupt ein Abo gestartet ist
  /// (automatisch). Ein in `Milestone.eventDays` eingetragener Tag geht vor.
  OPENING_DAY
  /// Besuchstage, an denen das Wasser kaelter war als `Milestone.tempBelow`
  /// (Fuehler aus `GamificationConfig.waterSensorDeviceId`).
  COLD_DAYS
}

/// Gamification: Zeitraum, in dem gezaehlt wird (Saison = Kalenderjahr).
enum GamiPeriod {
  SEASON
  MONTH
  /// Ohne Ende: zaehlt ueber alle Jahre, der Award wird einmal vergeben.
  ALL_TIME
}

/// Gamification: Seltenheit eines Awards, bestimmt das Metall des Abzeichens.
enum GamiTier {
  BRONZE
  SILVER
  GOLD
  LEGENDARY
}

enum ScanResult {
  GRANTED
  DENIED
  PROTECTED
}

enum NetworkDeviceType {
  SWITCH
  ROUTER
  ACCESS_POINT
  FIREWALL
  OTHER
}

enum NetworkPortStatus {
  ACTIVE
  INACTIVE
  RESERVED
  FAULTY
}

enum NetworkOutletType {
  WALL_OUTLET
  PATCH_PANEL
}

enum NetworkClientType {
  PC
  PRINTER
  CAMERA
  NAS
  PHONE
  IOT
  MONITOR
  OTHER
}

enum ApiProvider {
  ANNY
  WAKESYS
  BINARYTEC
  EMP_CONTROL
  SHELLY
  NUKI
  GARDENA
  LOQED
}

model Account {
  id                     Int                     @id @default(autoincrement())
  subdomain              String                  @unique
  name                   String
  apiToken               String                  @unique
  isActive               Boolean                 @default(true)
  // Standort für Sonnenauf-/-untergangs-Automationen (Default: Berlin).
  latitude               Float?
  longitude              Float?
  timezone               String? // IANA TZ, z.B. "Europe/Berlin"; null = Europe/Berlin
  /// JSON: Löschfristen in Tagen pro Bereich, null = unbegrenzt.
  /// Keys: vehicleSightings, personSightings, cameraEvents, scans,
  /// irrigationRuns, automationRuns, emailSends, hubTasks, discoveredDevices
  dataRetention          Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  admins                 Admin[]
  devices                Device[]
  tickets                Ticket[]
  scans                  Scan[]
  scanSnapshots          ScanSnapshot[]
  areas                  AccessArea[]
  apiConfigs             ApiConfig[]
  monitors               MonitorConfig[]
  subscriptions          Subscription[]
  services               Service[]
  vouchers               Voucher[]
  telegramConfigs        TelegramConfig[]
  vereine                Verein[]
  vereinSlotBookings     VereinSlotBooking[]
  lockers                Locker[]
  emailConfig            EmailConfig?
  emailRules             EmailRule[]
  emailSends             EmailSend[]
  announcements          MonitorAnnouncement[]
  monitorAlerts          MonitorAlert[]
  slotBlocks             SlotBlock[]
  lostItems              LostItem[]
  articles               Article[]
  stocktakes             Stocktake[]
  stocktakeLines         StocktakeLine[]
  stocktakeSignatures    StocktakeSignature[]
  stocktakeEvents        StocktakeEvent[]
  inventoryAssets        InventoryAsset[]
  inventoryAssetCounts   InventoryAssetCount[]
  inventoryCountLinks    InventoryCountLink[]
  irrigationSchedules    IrrigationSchedule[]
  irrigationRuns         IrrigationRun[]
  pushSubscriptions      PushSubscription[]
  infoFormTemplates      InfoFormTemplate[]
  infoRequests           InfoRequest[]
  networkVlans           NetworkVlan[]
  networkDevices         NetworkDevice[]
  networkOutlets         NetworkOutlet[]
  networkClients         NetworkClient[]
  networkAreas           NetworkArea[]
  hubAgents              HubAgent[]
  hubAlerts              HubAlert[]
  hubTasks               HubTask[]
  gamificationConfig     GamificationConfig?
  riderProfiles          RiderProfile[]
  riderFamilies          RiderFamily[]
  customers              Customer[]
  chips                  Chip[]
  chipEvents             ChipEvent[]
  riderPasskeys          RiderPasskey[]
  riderPushSubscriptions RiderPushSubscription[]
  riderDayStats          RiderDayStat[]
  riderMusicVotes        RiderMusicVote[]
  riderSkills            RiderSkill[]
  riderSkillGrants       RiderSkillGrant[]
  riderSkillUses         RiderSkillUse[]
  milestones             Milestone[]
  milestoneAwards        MilestoneAward[]
  challenges             Challenge[]
  challengeAwards        ChallengeAward[]
  challengeOptions       ChallengeOption[]
  challengeEntries       ChallengeEntry[]
  challengeVotes         ChallengeVote[]
  riderOffers            RiderOffer[]
  riderHolidays          RiderHoliday[]
  riderHolidayGifts      RiderHolidayGift[]
  riderBirthday          RiderBirthday?
  riderBirthdayGifts     RiderBirthdayGift[]
  discoveredDevices      DiscoveredDevice[]
  knownNetworkDevices    KnownNetworkDevice[]
  blockedNetworkDevices  BlockedNetworkDevice[]
  cameras                Camera[]
  cameraEvents           CameraEvent[]
  allowedVehicles        AllowedVehicle[]
  vehicleSightings       VehicleSighting[]
  listedPersons          ListedPerson[]
  personSightings        PersonSighting[]
  personFaceEmbeddings   PersonFaceEmbedding[]
  surveillanceConfig     SurveillanceConfig?
  audioZones             AudioZone[]
  audioTracks            AudioTrack[]
  audioPlaylists         AudioPlaylist[]
  audioStreams           AudioStream[]
  audioAnnouncements     AudioAnnouncement[]
  audioSchedules         AudioSchedule[]
  audioJobs              AudioJob[]
  audioLiveSessions      AudioLiveSession[]
  soundwebDevices        SoundwebDevice[]
  soundwebControls       SoundwebControl[]
  keyRooms               KeyRoom[]
  operatingSchedules     OperatingSchedule[]
  roomRules              RoomRule[]
  roomRuleRuns           RoomRuleRun[]
  roomClimates           RoomClimate[]
  climateSamples         ClimateSample[]
  weatherHours           WeatherHour[]
  roomMotionEvents       RoomMotionEvent[]
  keyDoors               KeyDoor[]
  keyLocks               KeyLock[]
  keyItems               KeyItem[]
  keyHolders             KeyHolder[]
  keyHandovers           KeyHandover[]
  keyPolicyTemplates     KeyPolicyTemplate[]
  keySignatures          KeySignature[]
  mcpTokens              McpToken[]
  eventPartners          EventPartner[]
  venueExtras            VenueExtra[]
  venueEvents            VenueEvent[]
  venueEventDocuments    VenueEventDocument[]
}

model Admin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(USER)
  lastLogin DateTime?
  accountId Int?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// TOTP-Secret, verschluesselt mit AUTH_SECRET (siehe src/lib/secret-box.ts).
  /// Wird schon beim Start der Einrichtung gesetzt; scharf ist der zweite
  /// Faktor erst mit twoFactorEnabledAt.
  twoFactorSecret        String?
  twoFactorEnabledAt     DateTime?
  /// bcrypt-Hashes der Wiederherstellungscodes. Ein benutzter Code wird aus
  /// der Liste entfernt, damit er kein zweites Mal funktioniert.
  twoFactorRecoveryCodes String[]  @default([])
  /// Zuletzt akzeptierter TOTP-Zeitschritt. Verhindert, dass ein abgefangener
  /// Code innerhalb seiner Gueltigkeit ein zweites Mal eingeloest wird.
  twoFactorLastStep      Int?
  twoFactorFailures      Int       @default(0)
  twoFactorLockedUntil   DateTime?

  /// Fehlgeschlagene Passwort-Anmeldungen; nach LOGIN_MAX_FAILURES
  /// (src/lib/account-security.ts) ist das Konto fuer LOGIN_LOCK_MINUTES gesperrt.
  loginFailures    Int       @default(0)
  loginLockedUntil DateTime?

  /// Wird bei jedem Passwortwechsel erhoeht. Das Sitzungs-JWT traegt den Stand
  /// vom Anmelden; weicht er ab, endet die Sitzung bei der naechsten Pruefung
  /// (src/lib/auth.ts). So meldet ein Passwortwechsel alle Geraete ab.
  sessionVersion Int @default(0)

  passkeys            Passkey[]
  stocktakeSignatures StocktakeSignature[]

  @@index([accountId])
  @@index([email])
}

/// Passkey (WebAuthn) eines Admins: Anmeldung ohne Passwort per Face ID,
/// Fingerabdruck oder Sicherheitsschluessel. Gespeichert wird nur der
/// oeffentliche Schluessel; der private bleibt im Geraet bzw. Schluesselbund.
/// Haengt am Admin, nicht am Account (wie Passwort und 2FA).
model Passkey {
  id           Int       @id @default(autoincrement())
  adminId      Int
  admin        Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// Credential-ID, base64url.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// "singleDevice" oder "multiDevice" (synchronisiert, z. B. iCloud-Schluesselbund).
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([adminId])
}

/// Einmal-Challenge fuer eine Passkey-Zeremonie. Liegt in der Datenbank statt
/// im Prozessspeicher, weil auf Vercel Optionen und Antwort bei verschiedenen
/// Instanzen landen koennen. Wird beim Pruefen geloescht (nur einmal gueltig).
model PasskeyChallenge {
  id        Int      @id @default(autoincrement())
  challenge String   @unique
  /// "login" oder "register"
  purpose   String
  /// Nur bei "register": wer den Passkey anlegt.
  adminId   Int?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Device {
  id                   Int                  @id @default(autoincrement())
  name                 String
  type                 DeviceType
  /// Geraete-eigenes Token fuer Scanner- und Audio-Pis. Gilt nur fuer die
  /// Geraete-Endpunkte (/api/devices/pi, /api/devices/audio) und nur fuer
  /// dieses Geraet. Null = Geraet nutzt noch das Account-Token.
  /// Skills der Kunden-App, die dieses Geraet schalten.
  riderSkills          RiderSkill[]
  apiToken             String?              @unique
  category             DeviceCategory?
  ipAddress            String?
  shellyId             String?
  shellyAuthKey        String?
  /// HUE_LIGHT: Bridge-ID (aus /api/config) und Lampen-ID auf der Bridge.
  hueBridgeId          String?
  hueLightId           String?
  /// MAMMOTION_MOWER: Geraetename bei Mammotion (z. B. "Luba-VA6C39PZ").
  /// Der Zustand (Akku, Status, Aufgaben) steht in `systemInfo`.
  mowerName            String?
  /// MAMMOTION_MOWER: Karte (Zonen, Hindernisse, Station) in Bildkoordinaten,
  /// vom Hub vereinfacht. Format siehe `src/lib/mower.ts`.
  mowerMap             Json?
  /// Antriebe (MARKISE/ROLLTOR) mit zwei getrennten Relais: Shelly-Kanal, der
  /// die Fahrtrichtung "Auf" schaltet (0-basiert). NULL = Gerät ist kein
  /// Antrieb bzw. noch nicht eingerichtet.
  coverUpChannel       Int?
  /// Shelly-Kanal fuer "Zu". Muss sich von coverUpChannel unterscheiden – beide
  /// Relais duerfen nie gleichzeitig anziehen (Motor faehrt sonst gegen sich
  /// selbst). Die Verriegelung erzwingt das in `src/lib/shelly-cover.ts`.
  coverDownChannel     Int?
  /// Volle Fahrzeit in Sekunden. Wird als Shelly-eigener Auto-Off-Timer
  /// mitgesendet, damit das Relais auch bei Netzwerkausfall wieder abfaellt.
  coverRuntimeSec      Int?
  /// Taster (TASTER): Wie lange das Relais nach einem Druck eingeschaltet
  /// bleibt. Geht als Shelly-eigener Auto-Off-Timer mit, damit es auch dann
  /// wieder abfaellt, wenn die Verbindung danach abreisst. NULL = Standardwert
  /// aus `src/lib/pulse-constants.ts`.
  pulseSeconds         Int?
  /// Nuki Smart Lock ID (numerische ID aus der Nuki Web API).
  /// Wird beim Sync aus `GET /smartlock` befuellt; identifiziert das Geraet
  /// fuer `POST /smartlock/{id}/action` und Webhook-Events.
  nukiSmartlockId      String?
  /// LOQED Lock-ID (20-stellige Zeichenfolge, z. B. "QnZk1ldDbpR82jVA47oL").
  /// Wird beim Sync aus `GET /api/locks/` befuellt; identifiziert das Schloss
  /// fuer `GET /api/locks/{id}/bolt_state/{zustand}` und Webhook-Events.
  ///
  /// Achtung: Steht dasselbe Schloss auch in der Shelly Cloud, tragt es dort
  /// eine eigene, laengere ID mit Praefix – die beiden sind nicht dasselbe.
  loqedLockId          String?
  /// GARDENA smart system Service-ID des VALVE-Service (z. B.
  /// "ee5b3996-defe-4903-934a-a33822e85b0c:2"). Identifiziert Ventil bzw.
  /// Pumpe fuer `PUT /v1/command/{serviceId}` und den Status-Abgleich ueber
  /// die Location-Details. Wird beim Import aus der GARDENA Cloud befuellt.
  gardenaServiceId     String?
  /// Verweist auf die GARDENA-Verbindung (ApiConfig, provider = GARDENA), mit
  /// der dieses Ventil/diese Pumpe gesteuert und abgefragt wird. Ermoeglicht
  /// mehrere GARDENA-Konten (Application Key/Secret) pro Mandant.
  gardenaConfigId      Int?
  gardenaConfig        ApiConfig?           @relation("GardenaConfigDevices", fields: [gardenaConfigId], references: [id], onDelete: SetNull)
  /// Durchflussrate der Zone in Liter/Stunde (Bewaesserung) – so wie die
  /// GARDENA-Pumpe den Wert anzeigt. Grundlage fuer Verbrauchsstatistik und
  /// die exakte Wasserbilanz-Dauer.
  flowLph              Float?
  /// Bewaesserte Flaeche der Zone in m². Zusammen mit flowLph kann die Dauer
  /// aus dem Wasserdefizit (mm) exakt berechnet werden.
  areaSqm              Float?
  /// Optionale Zuordnung Ventil → Pumpe (beide sind GARDENA_VALVE-Geraete):
  /// wird das Ventil aktiviert, schaltet die zugeordnete Pumpe automatisch mit
  /// an. Self-Relation innerhalb der Device-Tabelle.
  pumpDeviceId         Int?
  pump                 Device?              @relation("ValvePump", fields: [pumpDeviceId], references: [id], onDelete: SetNull)
  valves               Device[]             @relation("ValvePump")
  isActive             Boolean              @default(true)
  task                 Int                  @default(0)
  /// Zeitpunkt, zu dem task zuletzt auf einen Wert ungleich 0 gesetzt wurde
  /// (null bei 0 oder alten Zeilen). Einmal-Oeffnen (1) verfaellt am Pi nach 60 s.
  taskSetAt            DateTime?
  accessIn             Int?
  accessOut            Int?
  allowReentry         Boolean              @default(false)
  /// Nach einem GRANTED-Scan: so viele Sekunden darf DASSELBE Ticket an
  /// diesem Geraet nicht erneut gültig scannen (Missbrauchsschutz).
  /// Andere Tickets bleiben frei. NULL/0 = keine Sperre.
  /// Austritte und Dashboard-Oeffnungen sind ausgenommen.
  scanLockSeconds      Int?
  /// Gamification: ein GRANTED-Scan eines Abo-Tickets an diesem Geraet zaehlt
  /// als Start (z. B. Drehkreuz an der Seilbahn). Siehe src/lib/gamification.ts.
  countsAsStart        Boolean              @default(false)
  /// Gamification, nur für die Rückrechnung: ein früheres Start-Gerät
  /// (z. B. der alte Scanner an Seilbahn A vor dem Drehkreuz). Seine
  /// GRANTED-Scans VOR diesem Zeitpunkt zählen in „Statistik neu berechnen“
  /// als Starts, auch wenn `countsAsStart` aus ist. Live-Scans zählen nie.
  legacyStartsUntil    DateTime?
  /// Optionale Kamera-Zuordnung: Kamera, die diesen Zugang im Blick hat
  /// (z. B. Drehkreuz "Eingang A" → Kamera Eingang). Scans dieses Geraets
  /// werden in der UI mit der Kamera verknuepft (Live-Bild/Schnappschuss).
  cameraId             Int?
  camera               Camera?              @relation("DeviceCamera", fields: [cameraId], references: [id], onDelete: SetNull)
  firmware             String?
  systemInfo           Json?
  lastUpdate           DateTime?
  /// Offline-Push-Tracking: Zeitpunkt, zu dem fuer die AKTUELLE Offline-
  /// Episode eine Push-Benachrichtigung gesendet wurde. NULL = Geraet gilt
  /// als online bzw. Episode beendet. Wird ausschliesslich vom Cron
  /// `/api/cron/device-offline-check` gesetzt und geloescht.
  offlineNotifiedAt    DateTime?
  /// Opt-in pro Geraet: nur wenn true, prueft der Offline-Cron dieses Geraet
  /// und sendet Push-Benachrichtigungen bei offline/wieder-online.
  offlineAlertsEnabled Boolean              @default(false)
  accountId            Int
  account              Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scans                Scan[]
  irrigationSchedules  IrrigationSchedule[]
  irrigationRuns       IrrigationRun[]
  /// Tickets, die diesem Geraet direkt zugewiesen sind (additiv zu Bereichen).
  /// Wird vor allem fuer Mitarbeiter verwendet, die ohne Bereich-Zugehoerigkeit
  /// nur ein einzelnes Geraet bedienen sollen.
  ticketDevices        TicketDevice[]
  /// Optionale Netzwerk-Zuordnung (Switch-Port/VLAN) dieses IoT-Geraets.
  networkClient        NetworkClient?
  allowedVehicles      AllowedVehicle[]
  listedPersons        ListedPerson[]
  /// Beschallungszone, die dieser Abspieler (type = AUDIO_PLAYER) bedient.
  audioZone            AudioZone?           @relation("AudioZoneDevice")
  /// Raum der Schliessanlage, in dem dieses Geraet physisch haengt (Shelly im
  /// Technikraum, Taster im Flur). NULL = keinem Raum zugeordnet.
  keyRoomId            Int?
  keyRoom              KeyRoom?             @relation(fields: [keyRoomId], references: [id], onDelete: SetNull)
  /// Schliesspunkte, die dieses Geraet elektronisch bedient (Nuki/LOQED auf dem
  /// Zylinder, Shelly-Relais am Tueroeffner).
  keyLocks             KeyLock[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  ruleTriggers         RoomRule[]           @relation("RoomRuleTriggerDevice")
  ruleActions          RoomRuleAction[]     @relation("RoomRuleActionDevice")
  climateSensors       RoomClimate[]        @relation("RoomClimateSensor")
  climateSamples       ClimateSample[]
  gamificationWater    GamificationConfig[] @relation("GamificationWaterSensor")
  motionEvents         RoomMotionEvent[]

  @@index([accountId])
  @@index([gardenaConfigId])
  @@index([keyRoomId])
  @@index([accountId, hueBridgeId, hueLightId])
  @@index([accountId, mowerName])
  @@index([accessIn])
  @@index([accessOut])
  @@index([pumpDeviceId])
  @@index([cameraId])
}

model Ticket {
  id                      Int                  @id @default(autoincrement())
  name                    String
  qrCode                  String?
  rfidCode                String?
  startDate               DateTime?
  endDate                 DateTime?
  validityType            ValidityType         @default(DATE_RANGE)
  slotStart               String? // HH:mm for TIME_SLOT
  slotEnd                 String? // HH:mm for TIME_SLOT
  validityDurationMinutes Int? // minutes for DURATION
  firstScanAt             DateTime? // auto-set on first GRANTED scan for DURATION
  accessAreaId            Int?
  subscriptionId          Int?
  serviceId               Int?
  vereinId                Int?
  status                  TicketStatus         @default(VALID)
  version                 Int                  @default(0)
  uuid                    String?              @unique
  barcode                 String?              @unique
  firstName               String?
  lastName                String?
  birthDate               DateTime?
  ticketTypeName          String?
  profileImage            String?              @db.Text
  extras                  Json?
  email                   String? // optionale Email-Adresse für automatische Mails (Aboablauf, Followup …)
  source                  ApiProvider?
  /// UUID einer Bulk-Erstellung (alle Tickets aus einem Bulk-Run teilen sich
  /// die gleiche `bulkBatchId`). Erlaubt Liste/Reprint im Backoffice.
  /// NULL = kein Bulk-Ticket (manuell oder von Anny synchronisiert).
  bulkBatchId             String?
  /// Wochenplan (gleiches Format wie `Device.schedule` -> `WeekSchedule`):
  /// {monday: {enabled, on: "HH:MM", off: "HH:MM"}, ...}
  /// Wenn gesetzt, wird ein Scan nur freigegeben, wenn die aktuelle Berliner
  /// Zeit am betreffenden Wochentag im on/off-Fenster liegt. Vor allem fuer
  /// Mitarbeiter-Tickets gedacht (Arbeitszeiten).
  weekSchedule            Json?
  /// Persoenlicher Mobile-PWA-Token. Wer den Token hat, kann auf der
  /// `/m/<token>`-Seite die ihm zugewiesenen Geraete bedienen. Wird im
  /// Mitarbeiter-Editor erzeugt/rotiert und kann per QR an den Mitarbeiter
  /// geteilt werden. NULL = noch kein Token erzeugt.
  mobileToken             String?              @unique
  /// UUID der ANNY-Booking, die bei Ticket-Verkauf erzeugt wurde (Slot-
  /// Kapazitaet in ANNY blocken). Wird gespeichert, um spaeter beim Storno
  /// die Booking in ANNY cancelen zu koennen. NULL = nicht via ANNY
  /// gebucht (Tagesticket, manuelle Eingabe, oder Sync vor diesem Feature).
  annyBookingId           String?
  /// ID der ANNY-Ressource, auf die diese Buchung laeuft (z.B. "176390" =
  /// Aquapark, "176385" = Strandbad). `accessAreaId` taugt dafuer NICHT: es
  /// wird beim Sync auf die Hauptressource des Service ueberschrieben, damit
  /// der DURATION-Timer an der richtigen Stelle startet.
  /// Kombi-Services buchen pro Gast eine Booking je Ressource; erst dieses
  /// Feld macht die zusammengehoerenden Tickets als EIN Gast erkennbar.
  /// NULL = nicht von ANNY, oder Sync vor diesem Feature.
  annyResourceId          String?
  /// Freitext-Notiz, die das Personal am Shop-Monitor zum Ticket hinterlegen
  /// kann (z. B. "kommt morgen mit Kind", "Schluessel nicht zurueckgegeben").
  /// Wird im Ticket-Overlay sichtbar/editierbar; hat keine Auswirkung auf
  /// die Zugriffslogik.
  notes                   String?              @db.Text
  /// Antworten aus einer Info-Anfrage (Gaeste-Formular), als Key-Value-JSON:
  /// {"participantName": "Lena Vogt", "sport": "Wakeboard", "schuhgroesse": "36", ...}
  /// Die Feld-Definitionen (Label, Typ, Optionen) stehen im zugehoerigen
  /// `InfoFormTemplate`. Wird im Check-in-Monitor als Badges angezeigt und
  /// kann dort auch manuell editiert werden. NULL = keine Infos erfasst.
  guestInfo               Json?
  /// Vom Gast in ANNY zugebuchte Zusatzartikel/Verleihmaterial (Neoprenanzug,
  /// Wakeboard, Helm, Flex-Option ...) als Array:
  /// [{"name": "Neoprenanzug", "quantity": 2, "note": "2 Stunden"}]
  /// ANNY liefert Add-Ons NICHT an der Booking selbst; sie stehen nur als
  /// Positionen auf der Auftragsrechnung. Der Sync liest sie ueber
  /// /invoices?include=items,reference und ordnet sie per Order-ID den
  /// Buchungen zu. Bewusst ein eigenes Feld statt `extras`, weil `extras`
  /// bereits die Pause-/Zahlungs-Flags als Objekt traegt.
  /// NULL = keine Zusatzartikel gebucht.
  addOns                  Json?
  /// ID des ANNY-Auftrags (Order) dieser Buchung. Ein Auftrag umfasst oft eine
  /// ganze Buchungsgruppe (Bucher + Begleitpersonen = mehrere Tickets), und
  /// `addOns` gilt immer fuer den GESAMTEN Auftrag. Ohne diese ID wuerde eine
  /// Tagessumme das Material je Ticket zaehlen und damit vervielfachen.
  /// NULL = nicht von ANNY, oder Sync vor diesem Feature.
  annyOrderId             String?
  accountId               Int
  account                 Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessArea              AccessArea?          @relation(fields: [accessAreaId], references: [id], onDelete: SetNull)
  subscription            Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  service                 Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  verein                  Verein?              @relation(fields: [vereinId], references: [id], onDelete: SetNull)
  ticketAreas             TicketArea[]
  /// Direkt zugewiesene Geraete (additiv zu `ticketAreas`).
  ticketDevices           TicketDevice[]
  vereinAccess            VereinAccessTicket[] // Vereine, die über DIESES Ticket Zutritt erhalten
  vereinSlotBookings      VereinSlotBooking[] // Vereinsbuchung, deren Zutritt dieses Ticket traegt
  lockerRentals           LockerRental[] // Schließfach-Vermietungen, in denen dieses Ticket Mieter ist (jahresweise)
  keyHolders              KeyHolder[] // Schlüsselnehmer-Einträge, die auf dieses Mitarbeiter-Ticket zeigen
  emailSends              EmailSend[] // Historie der an dieses Ticket gesendeten Automation-Mails
  scans                   Scan[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  /// Kunden-App: Profil, das mehrere Abo-Tickets derselben Person buendelt.
  /// Bei Abos die Person, die damit faehrt; NULL = „Fahrer offen“.
  riderProfileId     Int?
  riderProfile       RiderProfile?     @relation(fields: [riderProfileId], references: [id], onDelete: SetNull)
  /// Kundenkonto (E-Mail-Adresse), dem das Abo gehoert. Siehe `Customer`.
  customerId         Int?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Fahrer ist aus der Gamification ausgestiegen: es wird nichts gezaehlt.
  gamificationOptOut Boolean           @default(false)
  riderDayStats      RiderDayStat[]
  milestoneAwards    MilestoneAward[]
  skillGrants        RiderSkillGrant[]
  challengeAwards    ChallengeAward[]

  @@index([riderProfileId])
  @@index([customerId])
  @@index([accountId])
  @@index([rfidCode])
  @@index([qrCode])
  @@index([barcode])
  @@index([accessAreaId])
  @@index([subscriptionId])
  @@index([serviceId])
  @@index([vereinId])
  @@index([status])
  @@index([accountId, uuid])
  @@index([accountId, status])
  @@index([accountId, source])
  @@index([accountId, bulkBatchId])
  @@index([annyOrderId])
  // Kiosk-, Monitor- und Dashboard-Abfragen filtern "Tickets des Tages" ueber
  // Status + Datumsbereich. Ohne Datums-Index liest jede dieser Abfragen alle
  // jemals eingeloesten Tickets des Mandanten.
  @@index([accountId, endDate])
  @@index([accountId, createdAt])
}

model Scan {
  id        Int           @id @default(autoincrement())
  code      String
  note      String?
  deviceId  Int?
  scanTime  DateTime      @default(now())
  result    ScanResult
  ticketId  Int?
  accountId Int
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // SetNull statt Cascade: wird ein Geraet geloescht, bleibt seine
  // Scan-Historie (Statistik, Nachvollziehbarkeit) erhalten.
  device    Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  ticket    Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// Kamera-Schnappschuss zum Scan-Zeitpunkt (vom Hub aufgenommen).
  snapshot  ScanSnapshot?
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@index([deviceId])
  @@index([scanTime])
  @@index([code])
  @@index([ticketId])
  @@index([accountId, scanTime])
  @@index([accountId, scanTime, result])
}

/// Schnappschuss der verknuepften Kamera zum Scan-Zeitpunkt. Wird vom Hub
/// ueber den Task SCAN_SNAPSHOT aufgenommen (wenige Sekunden nach dem Scan)
/// und dem zeitlich naechsten Scan des Geraets zugeordnet. Eigene Tabelle,
/// damit Scan-Listen die Bilddaten nicht mitladen.
model ScanSnapshot {
  id           Int      @id @default(autoincrement())
  scanId       Int      @unique
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  cameraId     Int?
  camera       Camera?  @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// JPEG-Bilddaten – nur noch fuer Altbestand; neue Bilder liegen im
  /// Blob-Speicher (`blobPathname`). `scripts/migrate-images-to-blob.ts` zieht um.
  image        Bytes?
  blobPathname String?
  /// Zeitpunkt der Aufnahme durch den Hub.
  capturedAt   DateTime @default(now())
  accountId    Int
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([accountId])
  @@index([cameraId])
  @@index([blobPathname])
}

model AccessArea {
  id                 Int                @id @default(autoincrement())
  name               String
  parentId           Int?
  allowReentry       Boolean            @default(false)
  personLimit        Int?
  /// Sperrzeit in Sekunden fuer dasselbe Ticket, bereichsweit ueber ALLE
  /// Eingaenge dieses Bereichs. Anders als `Device.scanLockSeconds` (gilt nur
  /// pro Leser) laesst sich diese Sperre nicht dadurch umgehen, dass man den
  /// naechsten Eingang nimmt oder zwischendurch am Ausgang scannt.
  ///
  /// Notwendig, weil `Service.allowReentry` ein Ticket nach einem Ausgangs-Scan
  /// wieder gueltig macht: der Ausgangs-Scan dauert zwei Sekunden und setzt
  /// kein tatsaechliches Verlassen voraus. Ohne diese Sperre laesst eine
  /// weitergegebene Strandbad-Tageskarte beliebig viele Gaeste hintereinander
  /// durch.
  ///
  /// NULL oder 0 = keine bereichsweite Sperre.
  scanLockSeconds    Int?
  showOnDashboard    Boolean            @default(true)
  openingHours       String?
  /// Veranstaltungsraum (z. B. Rooftop Lounge): Belegung ueber
  /// /veranstaltungen, Partner tragen Termine ueber ihren Link ein.
  eventVenue         Boolean            @default(false)
  /// Puffer in Minuten zwischen zwei Veranstaltungen (Auf- und Abbau).
  eventBufferMinutes Int                @default(60)
  /// Hoechstens so viele Gaeste je Veranstaltung. NULL = ohne Grenze.
  eventCapacity      Int?
  venueEvents        VenueEvent[]
  venueExtras        VenueExtra[]
  accountId          Int
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent             AccessArea?        @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           AccessArea[]       @relation("AreaHierarchy")
  tickets            Ticket[]
  ticketAreas        TicketArea[]
  subscriptions      Subscription[]
  serviceAreas       ServiceArea[]
  servicesAsMain     Service[]          @relation("ServiceMainArea")
  annyLinks          AnnyResourceLink[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  scanRules          RoomRule[]

  @@index([accountId])
  @@index([parentId])
}

model TicketArea {
  id           Int        @id @default(autoincrement())
  ticketId     Int
  accessAreaId Int
  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  accessArea   AccessArea @relation(fields: [accessAreaId], references: [id], onDelete: Cascade)

  @@unique([ticketId, accessAreaId])
  @@index([ticketId])
  @@index([accessAreaId])
}

/// Direkter Zugang Ticket -> Geraet (additiv zu `TicketArea`).
/// Heisst: Ein Ticket bekommt Zugang am Geraet, wenn entweder seine Bereiche
/// `Device.accessIn`/`accessOut` matchen **oder** ein passender Eintrag in
/// dieser Tabelle existiert. Vor allem fuer Mitarbeiter gedacht, die nur ein
/// einzelnes Geraet (z. B. Nebeneingang) bedienen sollen, ohne dass dafuer ein
/// eigener Bereich angelegt werden muss.
model TicketDevice {
  id       Int    @id @default(autoincrement())
  ticketId Int
  deviceId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([ticketId, deviceId])
  @@index([ticketId])
  @@index([deviceId])
}

model Subscription {
  id                             Int           @id @default(autoincrement())
  name                           String
  annyNames                      String?
  defaultValidityType            ValidityType?
  defaultStartDate               DateTime?
  defaultEndDate                 DateTime?
  defaultSlotStart               String? // HH:mm
  defaultSlotEnd                 String? // HH:mm
  defaultValidityDurationMinutes Int?
  requiresPhoto                  Boolean       @default(false)
  requiresRfid                   Boolean       @default(false)
  accountId                      Int
  account                        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  areas                          AccessArea[]
  tickets                        Ticket[]
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  @@index([accountId])
}

/// Art der Schließfach-Sicherung.
enum LockerType {
  /// Klassisches Schlüsselschloss – meist 2 Schlüssel pro Schließfach.
  KEY
  /// Vorhängeschloss – wird häufig nur als ein Stück ausgegeben.
  PADLOCK
}

/// Schließfach (locker). Vermietung läuft jahresweise über `LockerRental`
/// (1 Mieter-Ticket pro Schließfach pro Jahr) – damit ergibt sich automatisch
/// eine Historie, welcher Mieter das Schließfach in welchem Jahr hatte.
model Locker {
  id         Int            @id @default(autoincrement())
  /// Bezeichnung des Schließfachs (frei wählbar, z. B. „Spind 12“).
  name       String
  /// Optionaler Standort (z. B. „Umkleide UG“, „Halle Ost“).
  location   String?
  /// Schließfach-Nummer (frei: „A12“, „007“ etc.). Eindeutig pro Account.
  number     String
  /// Optionale Notiz / Kommentar (z. B. Schloss-Code).
  notes      String?
  /// Art der Sicherung (Schlüssel- oder Vorhängeschloss).
  lockType   LockerType     @default(KEY)
  /// Wie viele Schlüssel/Vorhängeschlösser gehören insgesamt zu diesem
  /// Schließfach (Soll-Bestand). Default: 2 für Schlüssel, 1 für Vorhänge.
  keyCount   Int            @default(2)
  /// Aufgedruckte Schloss-/Zylindernummer (nur sinnvoll bei Schlüsselschloss).
  lockNumber String?
  accountId  Int
  account    Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rentals    LockerRental[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([accountId, number])
  @@index([accountId])
}

/// Eine Vermietung eines Schließfachs an einen Mieter (Abo-Ticket) für ein
/// bestimmtes Kalenderjahr. Pro `(lockerId, year)` ist nur ein Eintrag möglich.
/// Beim Löschen des Tickets verschwindet auch der Vermietungs-Eintrag (Cascade);
/// der Verlauf für andere Jahre bleibt erhalten.
model LockerRental {
  id           Int       @id @default(autoincrement())
  lockerId     Int
  /// Optional: verknuepftes Mieter-Ticket (Abo). Mindestens eines von
  /// `ticketId` oder `renterName` muss gesetzt sein (App-Validator).
  /// Wird das Ticket geloescht, bleibt die Vermietung als Historie erhalten
  /// (ticketId -> NULL); fuer Anzeige greift dann `renterName` (sofern gesetzt).
  ticketId     Int?
  /// Manuell eingegebener Mietername (Fallback ohne Abo-Ticket).
  renterName   String?
  /// Vermietungsjahr als Kalenderjahr (z. B. 2026).
  year         Int
  /// Optionale Notiz für genau diese Vermietungs-Periode.
  notes        String?
  /// Anzahl bei Mietbeginn ausgegebener Schlüssel/Vorhängeschlösser.
  keysIssued   Int       @default(0)
  /// Anzahl davon, die bisher zurückgegeben wurden.
  keysReturned Int       @default(0)
  /// Zeitpunkt der Schlüssel-/Schlossausgabe (NULL = noch nicht ausgegeben).
  issuedAt     DateTime?
  /// Zeitpunkt der vollständigen Rücknahme (NULL = noch nicht zurück).
  returnedAt   DateTime?
  locker       Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  ticket       Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([lockerId, year])
  @@index([lockerId])
  @@index([ticketId])
  @@index([year])
}

model ServiceArea {
  id                             Int           @id @default(autoincrement())
  serviceId                      Int
  accessAreaId                   Int
  defaultValidityType            ValidityType?
  defaultStartDate               DateTime?
  defaultEndDate                 DateTime?
  defaultSlotStart               String? // HH:mm
  defaultSlotEnd                 String? // HH:mm
  defaultValidityDurationMinutes Int?
  service                        Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  area                           AccessArea    @relation(fields: [accessAreaId], references: [id], onDelete: Cascade)

  @@unique([serviceId, accessAreaId])
  @@index([serviceId])
  @@index([accessAreaId])
}

model Service {
  id                             Int                     @id @default(autoincrement())
  name                           String
  annyNames                      String?
  defaultValidityType            ValidityType?
  defaultStartDate               DateTime?
  defaultEndDate                 DateTime?
  defaultSlotStart               String? // HH:mm
  defaultSlotEnd                 String? // HH:mm
  defaultValidityDurationMinutes Int?
  allowReentry                   Boolean                 @default(false)
  allowManualCheckin             Boolean                 @default(true)
  requiresPhoto                  Boolean                 @default(false)
  requiresRfid                   Boolean                 @default(false)
  /// Hauptressource des Service. Wenn gesetzt, wird sie beim Verkauf als
  /// `Ticket.accessAreaId` (Hauptressource) verwendet - die anderen
  /// `serviceAreas` werden als Transit/Nebenressourcen behandelt. Beispiel
  /// "Wake&Ski 2 Stunden": Hauptressource = Seilbahn A, Nebenressourcen
  /// = Strandbad. Nach Ablauf der DURATION wird nur die Hauptressource
  /// blockiert; das Strandbad bleibt als Tagesticket-Aequivalent offen.
  /// MUSS Teil der `serviceAreas` sein - wird im API/Frontend abgesichert.
  /// NULL = Service hat keine eindeutige Hauptressource (Fallback: erste
  /// `serviceArea` nach ID).
  mainAccessAreaId               Int?
  mainAccessArea                 AccessArea?             @relation("ServiceMainArea", fields: [mainAccessAreaId], references: [id], onDelete: SetNull)
  /// Plaetze pro Slot, die EMP selbst verwaltet. Wenn gesetzt, ignorieren wir
  /// ANNYs `number_available` und rechnen die Belegung selbst aus den
  /// ANNY-Buchungen DIESES Service plus den EMP-Tickets.
  ///
  /// Notwendig, wenn sich mehrere EMP-Services in ANNY eine Resource teilen:
  /// ANNY zaehlt Buchungen pro Resource, nicht pro Service. Beispiel
  /// "Anfaengerkurs Uebungslift" (10 Plaetze) und "Anfaengerkurs Seilbahn B"
  /// (15 Plaetze) haengen beide an der Resource "Wake & Ski - Anfaengerkurse" -
  /// ohne dieses Feld senkt jede Buchung die freien Plaetze bei BEIDEN Kursen.
  ///
  /// NULL = ANNYs Verfuegbarkeit ist maßgeblich (Normalfall).
  slotCapacity                   Int?
  accountId                      Int
  account                        Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceAreas                   ServiceArea[]
  tickets                        Ticket[]
  slotBlocks                     SlotBlock[]
  vereinBookableServices         VereinBookableService[]
  vereinSlotBookings             VereinSlotBooking[]
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  @@index([accountId])
  @@index([mainAccessAreaId])
}

/// Manuelle Slot-Sperre vom Shop-/Check-in-Monitor. Beim Anlegen wird die
/// volle Restkapazitaet des Slots in ANNY per Platzhalter-Buchung belegt
/// (`annyBookingIds`), damit der Slot auch in ANNY nicht mehr buchbar ist.
/// Beim Aufheben werden diese ANNY-Buchungen storniert.
model SlotBlock {
  id             Int                 @id @default(autoincrement())
  accountId      Int
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceId      Int?
  service        Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Snapshot des Service-Namens fuer die Anzeige (falls Service spaeter
  /// umbenannt/geloescht wird).
  serviceName    String
  /// Tag der Sperre in Berlin-Zeit (YYYY-MM-DD).
  date           String
  /// Slot-Start/-Ende als HH:mm (Berlin), zum Matchen gegen die Slot-Liste.
  slotStart      String
  slotEnd        String
  /// Exakte Start-/Endzeit der gesperrten Buchung (ISO mit Offset).
  startDate      DateTime
  endDate        DateTime
  /// Wieviele Plaetze in ANNY belegt wurden (= Restkapazitaet beim Sperren).
  quantity       Int                 @default(1)
  /// Optionaler Sperrgrund (Anzeige + ANNY-Beschreibung).
  reason         String?
  /// JSON-Array der in ANNY angelegten Booking-UUIDs (fuer Storno beim
  /// Aufheben). "[]" wenn ANNY beim Anlegen nicht erreichbar war.
  annyBookingIds String?
  /// UUID des ANNY-Orders (Diagnose).
  annyOrderId    String?
  /// Vereinsbuchung, zu der diese Sperre gehoert (leer = manuelle Sperre).
  vereinBookings VereinSlotBooking[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([accountId, date])
  @@index([serviceId, date, slotStart])
}

model MonitorConfig {
  id               Int      @id @default(autoincrement())
  name             String
  token            String   @unique
  type             String   @default("MONITOR") // MONITOR | CHECKIN | RESOURCE_MONITOR | SCANNER | VOUCHER
  deviceIds        Json     @default("[]")
  // Optionale Bereichs-Eingrenzung fuer Scan-Monitore (Typ MONITOR), deren
  // Personenliste sonst nur ueber die Geraete-Bereiche gefiltert wird. Damit
  // laesst sich ein Monitor auch fuer Bereiche OHNE eigenes Scan-Geraet
  // erstellen (z.B. Seilbahn B / Uebungslift). Enthaelt AccessArea-IDs.
  areaIds          Json     @default("[]")
  /// Geraete, die vom oeffentlichen Scan-Monitor aus geschaltet werden
  /// duerfen – unabhaengig von `deviceIds` (Scan-Quellen). Beispiel:
  /// Monitor Seilbahn A steuert einen Shelly, der das Drehkreuz stromlos schaltet.
  controlDeviceIds Json     @default("[]")
  isActive         Boolean  @default(true)
  accountId        Int
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([accountId])
  @@index([token])
}

/// Kurznachricht, die ein Mitarbeiter vom Shop-/Check-in-Monitor an alle
/// Public-Monitore desselben Accounts schickt (z. B. "Anfaengerkurs gleich an
/// Seilbahn A"). Wird im Public-Monitor als Banner oben angezeigt, bis ein
/// Mitarbeiter dort manuell auf X klickt -> `dismissedAt` wird gesetzt und
/// der Banner verschwindet auf allen Monitoren.
model MonitorAnnouncement {
  id          Int       @id @default(autoincrement())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  message     String
  /// Optional: Name des Quell-Monitors (Shop-Monitor), rein informativ fuer
  /// die Anzeige ("Hinweis vom Shop"). Wird kein Fremdschluessel, weil der
  /// Monitor zwischenzeitlich umbenannt / geloescht werden koennte.
  sourceLabel String?
  createdAt   DateTime  @default(now())
  /// Wenn != null, wurde der Hinweis manuell geschlossen und ist fuer alle
  /// Public-Monitore aus dem Banner verschwunden.
  dismissedAt DateTime?

  @@index([accountId, dismissedAt])
}

/// Warnung von aussen an den Kassen-/Check-in-Monitor, aktuell vom lokalen
/// Kamera-Server: an der Drehkreuz-Kamera ist jemand durchgegangen, ohne dass
/// ein gueltiger Scan dazu passt. Wird im Check-in als Popup angezeigt, bis
/// ein Mitarbeiter es quittiert -> `acknowledgedAt`.
///
/// Bewusst getrennt von MonitorAnnouncement: Das sind Kurznachrichten von
/// Mensch zu Mensch, die als Banner auf allen Public-Monitoren stehen. Ein
/// Alarm hat einen Ausloeser, eine Dringlichkeit und einen anderen Adressaten.
model MonitorAlert {
  id             Int       @id @default(autoincrement())
  accountId      Int
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Art des Alarms, damit die Anzeige sie unterscheiden kann (z. B. TAILGATE).
  kind           String
  message        String
  /// Woher der Alarm kam, rein informativ (z. B. Kameraname).
  source         String?
  /// Wann der Vorfall war — kann vor `createdAt` liegen, weil die Erkennung
  /// dem Ereignis ein paar Sekunden hinterherlaeuft.
  occurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  images MonitorAlertImage[]

  @@index([accountId, acknowledgedAt])
}

/// Bild zum Vorfall, damit am Kassen-Monitor erkennbar ist, um wen es geht.
/// Eigene Tabelle, damit das Polling des Monitors die Bilddaten nicht bei
/// jedem Durchlauf mitlaedt.
model MonitorAlertImage {
  id           Int          @id @default(autoincrement())
  alertId      Int
  alert        MonitorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  /// Anzeigereihenfolge; 0 ist der Blick, in dem der Vorfall erkannt wurde.
  position     Int          @default(0)
  /// Woher das Bild stammt, z. B. der Kameraname.
  label        String?
  /// JPEG-Bilddaten – nur Altbestand, neue Bilder liegen im Blob-Speicher.
  image        Bytes?
  blobPathname String?
  createdAt    DateTime     @default(now())

  @@unique([alertId, position])
  @@index([blobPathname])
}

// ── Email-Automationen ───────────────────────────────────────────────────────

/// Pro Account genau eine Konfiguration. Aktuell wird Resend (HTTP API) als
/// Provider unterstützt – das Feld `provider` ist als Erweiterungspunkt für
/// SMTP o. ä. vorbereitet.
model EmailConfig {
  id          Int      @id @default(autoincrement())
  accountId   Int      @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "GMAIL" (default, SMTP via App-Passwort). Erweiterungspunkt fuer weitere
  /// Provider in Zukunft.
  provider    String   @default("GMAIL")
  /// Provider-Credential. Bei GMAIL: das Google-App-Passwort. Wir behandeln
  /// es analog zum Telegram-Bot-Token (Klartext-Spalte, RLS-isoliert).
  apiKey      String?
  /// Optionaler Bot-Mail-Absender, z. B. "no-reply@deindomain.de".
  fromEmail   String
  fromName    String?
  replyTo     String?
  isActive    Boolean  @default(true)
  /// Branding-Farbe für HTML-Templates (Hex, z. B. "#4F46E5").
  brandColor  String?
  /// Optionale Logo-URL und Website (für Footer/Header in HTML).
  logoUrl     String?
  websiteUrl  String?
  /// Pflichtangaben des Absenders (Firma, Anschrift, Geschäftsführung,
  /// Registergericht, USt-IdNr.), eine Angabe je Zeile. Steht unter förmlichen
  /// Mails wie den Mahnungen (lib/dunning-mail).
  legalFooter String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

/// Welcher Lebenszyklus-Event triggert die Mail?
enum EmailRuleTrigger {
  /// Tage VOR `Ticket.endDate` einer Subscription (Aboablauf-Erinnerung).
  SUBSCRIPTION_EXPIRING
  /// Tage NACH `Ticket.endDate` einer Subscription (Win-Back).
  SUBSCRIPTION_EXPIRED
  /// Tage NACH dem ersten Scan eines Tagestickets (Followup mit Voucher).
  DAY_VISIT_FOLLOWUP
  /// Tage NACH `Ticket.createdAt` (Welcome / Onboarding).
  TICKET_WELCOME
}

/// Eine Regel definiert, wann an welche Tickets eine Email automatisch
/// verschickt wird. Templates verwenden Platzhalter wie `{{firstName}}`.
model EmailRule {
  id                     Int              @id @default(autoincrement())
  accountId              Int
  account                Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                   String
  trigger                EmailRuleTrigger
  /// Tage relativ zum Trigger-Ereignis. Beispiel:
  ///   SUBSCRIPTION_EXPIRING, daysOffset=7  → 7 Tage vor endDate
  ///   DAY_VISIT_FOLLOWUP,    daysOffset=2  → 2 Tage nach erstem Scan
  daysOffset             Int              @default(0)
  /// Optionaler Filter: nur Tickets mit dieser Subscription bzw. Service.
  subscriptionId         Int?
  serviceId              Int?
  /// Subject + HTML-Body. Body wird in einen Mail-Wrapper eingebettet.
  subject                String
  bodyHtml               String           @db.Text
  /// Wenn true, wird vor dem Versand ein `Voucher` mit `discountPercent` und
  /// optionalem Verfallsdatum erzeugt – Code/Url stehen in den Platzhaltern
  /// `{{voucherCode}}` und `{{voucherUrl}}` zur Verfügung.
  createVoucher          Boolean          @default(false)
  voucherDiscountPercent Int?
  voucherValidDays       Int?
  voucherTicketTypeName  String?
  /// Optionale URL, z. B. zum Abo-Renew-Formular. `{{renewUrl}}` im Template.
  renewUrl               String?
  isActive               Boolean          @default(true)
  /// Mindest-Abstand in Tagen zwischen 2 Sends derselben Regel an dasselbe
  /// Ticket. Verhindert Doppel-Versand bei Cron-Reruns oder Datenkorrekturen.
  cooldownDays           Int              @default(30)
  /// Rückwärts-Fenster in Tagen, in dem verpasste Trigger-Tage nachgeholt werden.
  /// `lookbackDays = 0` ⇒ Mail geht NUR am exakten Soll-Sendetag raus (altes Verhalten).
  /// `lookbackDays = 7` ⇒ Mail geht auch noch raus, wenn der Soll-Sendetag bis zu
  /// 7 Tage in der Vergangenheit liegt (z. B. weil Cron einen Tag verpasst hat
  /// oder die Regel später aktiviert wurde). Cooldown sichert Idempotenz.
  lookbackDays           Int              @default(7)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  emailSends             EmailSend[]

  @@index([accountId])
  @@index([accountId, isActive])
  @@index([trigger, isActive])
}

/// Persistentes Versand-Log, dient zugleich als Idempotenz-Guard.
model EmailSend {
  id           Int        @id @default(autoincrement())
  accountId    Int
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId       Int?
  rule         EmailRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ticketId     Int?
  ticket       Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  voucherId    Int?
  voucher      Voucher?   @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  /// Empfänger (kopiert, falls Ticket gelöscht wird).
  to           String
  subject      String
  /// "SENT" | "FAILED" | "TEST"
  status       String
  errorMessage String?
  sentAt       DateTime   @default(now())

  @@index([accountId, sentAt])
  @@index([ticketId])
  @@index([ruleId])
  @@index([accountId, ruleId, ticketId])
}

/// Wiederverwendbare Formular-Definition fuer Info-Anfragen an Gaeste
/// (z. B. Ferienkurs: Wasserski/Wakeboard, Schuhgroesse, Level, Neopren).
/// `fields` ist ein JSON-Array von Feld-Definitionen:
///   [{ key, label, type: "choice"|"text"|"number"|"boolean",
///      options?: string[], required?: boolean, showIfKey?: string }]
/// `showIfKey` blendet das Feld nur ein, wenn das referenzierte
/// boolean-Feld mit "Ja" beantwortet wurde (z. B. Neopren-Groesse).
model InfoFormTemplate {
  id                 Int           @id @default(autoincrement())
  accountId          Int
  account            Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  /// Einleitungstext, der im oeffentlichen Formular ueber den Feldern steht.
  introText          String?       @db.Text
  fields             Json
  /// Wenn true, wird pro Platz zusaetzlich der Teilnehmername abgefragt
  /// (Ticket-Name ist oft der buchende Elternteil, nicht das Kind).
  askParticipantName Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  infoRequests       InfoRequest[]

  @@index([accountId])
}

/// Eine versendete Info-Anfrage an EINE Email-Adresse. Buendelt alle
/// Wochen-Tickets (Kursplaetze) dieser Adresse: der Empfaenger beantwortet
/// das Formular pro Ticket, die Antworten landen in `Ticket.guestInfo`.
/// `token` ist das Zugriffsgeheimnis der oeffentlichen /info/<token>-Seite.
model InfoRequest {
  id          Int              @id @default(autoincrement())
  accountId   Int
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  templateId  Int
  template    InfoFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  token       String           @unique
  /// Empfaenger-Adresse (Snapshot).
  email       String
  /// JSON-Array der Ticket-IDs, die diese Anfrage abdeckt.
  ticketIds   Json
  /// "SENT" | "COMPLETED" | "FAILED"
  status      String           @default("SENT")
  sentAt      DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([accountId])
  @@index([accountId, status])
  @@index([token])
}

/// Web-Push-Abonnement eines Browsers/PWA-Geraets (Dashboard). Ein Admin kann
/// auf mehreren Geraeten abonnieren – jede Kombination Browser+Geraet erzeugt
/// einen eigenen Endpoint. Abgelaufene Endpoints (HTTP 404/410 beim Senden)
/// werden vom Versand-Helper automatisch geloescht.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  /// Push-Service-URL (FCM/Mozilla/APNs-Proxy) – eindeutig pro Abo.
  endpoint  String   @unique
  /// Client-Public-Key (ECDH) fuer die Payload-Verschluesselung.
  p256dh    String
  /// Auth-Secret des Clients fuer die Payload-Verschluesselung.
  auth      String
  /// User-Agent beim Abonnieren – rein informativ ("welches Geraet ist das?").
  userAgent String?
  /// Admin, der das Abo erstellt hat (informativ, kein FK-Zwang noetig).
  adminId   Int?
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model TelegramConfig {
  id                    Int       @id @default(autoincrement())
  botToken              String
  chatId                String
  isActive              Boolean   @default(true)
  dailyReport           Boolean   @default(true)
  dailyReportTime       String    @default("20:00") // HH:mm Berlin time
  /// Wann der letzte Tagesbericht rausging – verhindert Doppelversand und
  /// erlaubt das Nachholen bei verspaetetem Cron-Tick.
  dailyReportLastSentAt DateTime?
  /// Hinweis, sobald der Hub ein bisher unbekanntes Geraet im Netz sieht.
  notifyNewDevices      Boolean   @default(true)
  /// Ausfaelle melden: Hub, Kameras, Soundweb und Befunde der Switch-Pruefung.
  notifyOutages         Boolean   @default(true)
  accountId             Int
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([accountId])
}

model AnnyResourceLink {
  id                Int        @id @default(autoincrement())
  accessAreaId      Int
  accessArea        AccessArea @relation(fields: [accessAreaId], references: [id], onDelete: Cascade)
  annyResourceId    String
  annyName          String
  label             String
  isPublic          Boolean    @default(false)
  splitSlots        Boolean    @default(false)
  bookingInterval   Int?
  priceLabel        String?
  priceLabelWeekend String?
  accountId         Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([accessAreaId, annyName])
  @@index([accountId])
  @@index([accessAreaId])
}

model Voucher {
  id                      Int                 @id @default(autoincrement())
  code                    String              @unique
  ticketTypeName          String?
  serviceId               Int?
  accessAreaId            Int?
  validityType            ValidityType        @default(DATE_RANGE)
  validityDurationMinutes Int?
  sourceTicketId          Int?
  redeemedAt              DateTime?
  redeemedTicketId        Int?
  /// Optionaler Rabatt-Anteil (z. B. 10 = 10% Rabatt). Nur informativ – wird beim
  /// nächsten Besuch manuell durch das Personal eingelöst (kein Auto-Redeem).
  discountPercent         Int?
  /// Optionales Verfallsdatum (z. B. 60 Tage nach Versand). NULL = unbegrenzt.
  expiresAt               DateTime?
  /// Freitextnotiz, etwa "Followup Tagesgast 04/2026".
  notes                   String?
  /// Wenn gesetzt: Gutschein wurde manuell deaktiviert (z. B. als
  /// ungueltig erklaert). Beim Scan wird er wie "bereits eingeloest"
  /// behandelt und erlaubt keine Ticket-Erstellung mehr.
  disabledAt              DateTime?
  /// ACCESS: Scan am Drehkreuz/Check-in erzeugt ein Ticket (bisheriges Verhalten).
  /// BENEFIT: Leistungs-Gutschein (z. B. Freigetraenk) – wird nur entwertet,
  /// es entsteht kein Ticket und kein Zutritt.
  kind                    VoucherKind         @default(ACCESS)
  /// BENEFIT: was der Gast bekommt, z. B. "Freigetränk".
  label                   String?
  /// BENEFIT: Abo-Ticket, dem der Gutschein gehoert (Gamification).
  ownerTicketId           Int?
  /// BENEFIT: wo entwertet wurde ("ADMIN" oder "CHECKIN").
  redeemedVia             String?
  accountId               Int
  account                 Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  emailSends              EmailSend[]
  milestoneAwards         MilestoneAward[]
  challengeAwards         ChallengeAward[]
  holidayGifts            RiderHolidayGift[]
  birthdayGifts           RiderBirthdayGift[]
  createdAt               DateTime            @default(now())

  @@index([accountId])
  @@index([code])
  @@index([accountId, expiresAt])
  @@index([accountId, kind])
  @@index([ownerTicketId])
}

model ApiConfig {
  id             Int         @id @default(autoincrement())
  provider       ApiProvider
  /// Optionales Label, um mehrere Verbindungen desselben Providers zu
  /// unterscheiden (v. a. GARDENA: mehrere Konten pro Mandant).
  name           String?
  token          String
  eventId        String?
  baseUrl        String?
  extraConfig    String?
  lastUpdate     DateTime?
  lastPostUpdate DateTime?
  accountId      Int
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gardenaDevices Device[]    @relation("GardenaConfigDevices")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([accountId])
  @@index([provider])
  @@index([accountId, provider])
}

// ── Shelly-Automationen ──────────────────────────────────────────────────────

enum ShellyAction {
  ON
  OFF
  TOGGLE
  /// Antriebe (MARKISE/ROLLTOR): auffahren.
  OPEN
  /// Antriebe: zufahren.
  CLOSE
  /// Antriebe: beide Fahrtrichtungen abschalten.
  STOP
}

/// Vereinigung mehrerer Mitglieds-Tickets. Über `VereinAccessTicket` werden
/// dem Verein ein oder mehrere "Zutritts-Tickets" (z. B. Bahnmiete) zugeordnet
/// – alle Mitglieder erben beim Scan automatisch die Areas dieser Tickets.
/// Mitglieder bleiben eigenständige Tickets (eigener QR/RFID).
model Verein {
  id                 Int                     @id @default(autoincrement())
  name               String
  description        String?
  accountId          Int
  account            Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members            Ticket[] // Mitglieds-Tickets via Ticket.vereinId
  accessTickets      VereinAccessTicket[] // Zutritts-Tickets, deren Areas alle Mitglieder erben
  /// Vereinsportal: geheimer Link `/verein/<portalToken>`, ueber den der
  /// Verein selbst Slots bucht. NULL = noch kein Link erzeugt.
  portalToken        String?                 @unique
  /// Portal an/aus. Aus = Link liefert 404, bestehende Buchungen bleiben.
  portalEnabled      Boolean                 @default(false)
  /// Bis wie viele Stunden vor Slot-Beginn der Verein selbst kostenlos
  /// stornieren darf. Danach nur noch ueber das Backoffice.
  portalCancelHours  Int                     @default(48)
  /// Wie viele Tage im Voraus der Verein buchen darf.
  portalHorizonDays  Int                     @default(60)
  /// Zugang ausserhalb des Betriebs: Minuten vor Slot-Beginn (Vorbereitung)
  /// und nach Slot-Ende (Nachbereitung), in denen Mitglieder rein-/rauskommen
  /// und das Portal die freigegebenen Tueren oeffnen darf.
  portalLeadMinutes  Int                     @default(30)
  portalTrailMinutes Int                     @default(30)
  /// Geraete (Device.id, z. B. Shelly-Tuer Technikraum), die der Verein im
  /// Zugangsfenster seiner Buchung ueber das Portal oeffnen darf.
  portalDeviceIds    Int[]                   @default([])
  /// DoorBird-Tore (Camera.id, kind DOORBIRD), ebenso.
  portalDoorbirdIds  Int[]                   @default([])
  /// Ansprechpartner/Rechnungsadresse fuer die Abrechnung (Freitext).
  billingContact     String?
  bookableServices   VereinBookableService[]
  slotBookings       VereinSlotBooking[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

/// Service, den ein Verein im Vereinsportal buchen darf, mit Preis pro Slot.
model VereinBookableService {
  id         Int     @id @default(autoincrement())
  vereinId   Int
  serviceId  Int
  /// Preis pro gebuchtem Slot in Cent (brutto). 0 = kostenlos.
  priceCents Int     @default(0)
  /// Bei Tageslicht buchbar: eigene Slots von Sonnenaufgang bis
  /// Sonnenuntergang (Konto-Standort), unabhaengig von den anny-Zeiten.
  /// Belegt ist, was in anny auf der Resource liegt oder schon gebucht ist.
  daylight   Boolean @default(false)
  /// Inklusivmiete waehlbar: der Verein kann je Buchung statt des Preises
  /// 0 EUR waehlen (Vorstand, Trainer, Familie 1. Grades; Jahrespauschale).
  inclusive  Boolean @default(false)
  verein     Verein  @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([vereinId, serviceId])
  @@index([vereinId])
  @@index([serviceId])
}

enum VereinBookingStatus {
  BOOKED
  CANCELED
  /// Wunschzeit-Anfrage des Vereins, wartet auf Freigabe im Backoffice.
  REQUESTED
  /// Anfrage abgelehnt (`rejectReason`).
  REJECTED
}

/// Slot-Buchung eines Vereins aus dem Vereinsportal. Sperrt den Slot in ANNY
/// (ueber `slotBlockId`), gibt den Mitgliedern Zutritt (ueber das
/// Zutritts-Ticket `accessTicketId`) und wird spaeter abgerechnet
/// (`billedAt`). Service-Name und Preis sind Schnappschuesse zum Buchungs-
/// zeitpunkt, damit die Abrechnung stabil bleibt.
model VereinSlotBooking {
  id             Int                 @id @default(autoincrement())
  accountId      Int
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vereinId       Int
  verein         Verein              @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  serviceId      Int?
  service        Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName    String
  /// Tag in Berlin-Zeit (YYYY-MM-DD) und Slot als HH:mm.
  date           String
  slotStart      String
  slotEnd        String
  startDate      DateTime
  endDate        DateTime
  priceCents     Int                 @default(0)
  status         VereinBookingStatus @default(BOOKED)
  /// Name, den die buchende Person im Portal angegeben hat.
  bookedBy       String?
  /// Fuer wen gebucht wurde (Fahrer, Gruppe), Pflicht im Portal seit 22.11.2026.
  bookedFor      String?
  /// Inklusivmiete (0 EUR, ueber die Jahrespauschale des Vereins).
  inclusive      Boolean             @default(false)
  note           String?
  canceledAt     DateTime?
  /// "VEREIN" (selbst storniert) oder "ADMIN" (vom Backoffice).
  canceledBy     String?
  /// Begruendung einer abgelehnten Anfrage (fuer den Verein sichtbar).
  rejectReason   String?
  /// Zeitpunkt der Freigabe bzw. Ablehnung einer Anfrage.
  decidedAt      DateTime?
  slotBlockId    Int?
  slotBlock      SlotBlock?          @relation(fields: [slotBlockId], references: [id], onDelete: SetNull)
  accessTicketId Int?
  accessTicket   Ticket?             @relation(fields: [accessTicketId], references: [id], onDelete: SetNull)
  /// Zeitpunkt der Abrechnung. NULL = noch offen.
  billedAt       DateTime?
  /// Rechnungsnummer o. ae., frei.
  invoiceRef     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([accountId, date])
  @@index([vereinId, date])
  @@index([serviceId, date, slotStart])
}

/// Verknüpfung Verein ↔ Ticket: Mitglieder des Vereins erben beim Scan die
/// Areas dieses Tickets (eigener accessAreaId + alle ticketAreas), sofern
/// das Ticket aktuell gültig ist (Status, Datumsrange, TIME_SLOT, DURATION).
/// Restriktionen werden direkt vom Ticket selbst übernommen.
model VereinAccessTicket {
  id       Int    @id @default(autoincrement())
  vereinId Int
  ticketId Int
  verein   Verein @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([vereinId, ticketId])
  @@index([vereinId])
  @@index([ticketId])
}

enum LostItemKind {
  FOUND
  LOST_REPORT
}

/// Fundsache: wird im Backend oder am Shop-/Check-in-Monitor angelegt und
/// verwaltet. Bild als Base64-Data-URL (gleiches Muster wie Ticket.profileImage).
/// LOST_REPORT = jemand meldet einen verlorenen Gegenstand (Name + Rückrufnummer).
model LostItem {
  id            Int          @id @default(autoincrement())
  kind          LostItemKind @default(FOUND)
  description   String
  foundDate     DateTime
  image         String?      @db.Text
  contact       String?
  reporterName  String?
  callbackPhone String?
  pickedUp      Boolean      @default(false)
  pickedUpAt    DateTime?
  accountId     Int
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([accountId, kind, pickedUp])
}

/// Automatischer Bewässerungs-Zeitplan fuer ein GARDENA-Ventil/eine Pumpe
/// (Device mit type = GARDENA_VALVE). Wird vom Cron (`/api/cron/irrigation`,
/// alle 5 Min) ausgewertet: passt der aktuelle Wochentag + die Startzeit und
/// wird nicht wegen Regen ausgesetzt, startet der Cron die Bewässerung fuer
/// `durationMinutes`. `lastRunAt` dient als Idempotenz-Guard.
model IrrigationSchedule {
  id                   Int             @id @default(autoincrement())
  accountId            Int
  account              Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId             Int
  device               Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Wochentage als Bitmaske: bit0=Mo, bit1=Di, …, bit6=So. 127 = jeden Tag.
  daysOfWeek           Int             @default(127)
  /// "HH:mm" Startzeit in Berliner Zeit.
  startTime            String
  /// Bewässerungsdauer in Minuten.
  durationMinutes      Int             @default(15)
  isActive             Boolean         @default(true)
  /// Bei erwartetem Regen (Wetter-Check) aussetzen.
  skipOnRain           Boolean         @default(true)
  /// Smart-Regen: Dauer anhand der Wetterlage skalieren (heiss → laenger,
  /// Regenrisiko → kuerzer). Unabhaengig vom harten skipOnRain-Aussetzer.
  smartRain            Boolean         @default(false)
  /// GARDENA SENSOR-Service-ID (Bodenfeuchte-Sensor). Wenn gesetzt, prueft der
  /// Cron vor dem Lauf die Bodenfeuchte und passt die Bewässerung smart an.
  sensorServiceId      String?
  /// Boden ist "feucht genug" ab dieser Bodenfeuchte in Prozent – der Lauf wird
  /// dann uebersprungen. Bei trockenerem Boden wird die Dauer skaliert.
  moistureThresholdPct Int?
  /// Geordnete Ventil-Sequenz (Device-IDs). Wenn gesetzt, ist deviceId die
  /// Pumpe und die Ventile laufen nacheinander je durationMinutes.
  valveSequence        Json?
  /// Laufender Sequenz-Plan (vom Cron abgearbeitet):
  /// { startedAt, steps: [{ deviceId, minutes, offsetMin, startedAt? }] }
  runState             Json?
  /// Letzter erfolgreicher Lauf – verhindert Doppel-Ausführung im 5-Min-Cron.
  lastRunAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  runs                 IrrigationRun[]

  @@index([accountId, isActive])
  @@index([deviceId])
}

/// Protokolliert jeden erfolgreichen Bewässerungs-Lauf eines Ventils (Dauer,
/// Quelle, geschaetzter Verbrauch). Basis fuer die Statistik-Ansicht.
model IrrigationRun {
  id              Int                 @id @default(autoincrement())
  accountId       Int
  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId        Int
  device          Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scheduleId      Int?
  schedule        IrrigationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  startedAt       DateTime            @default(now())
  /// Geplante Laufzeit in Minuten (wie an GARDENA gesendet).
  durationMinutes Int
  /// "schedule" = Cron-Zeitplan, "schedule_now" = Zeitplan „Jetzt", "manual" = UI-Knopf/Smart-Run
  source          String
  /// Geschaetzter Verbrauch in Liter (Durchfluss × Laufzeit), null wenn unbekannt.
  litersEstimate  Float?

  @@index([accountId, startedAt])
  @@index([deviceId, startedAt])
  @@index([scheduleId])
}

// ── Netzwerk-Verwaltung ──────────────────────────────────────────────────────

/// VLAN (Netz-Segment), z. B. Management, IoT, Gaeste-WLAN.
model NetworkVlan {
  id          Int               @id @default(autoincrement())
  /// IEEE 802.1Q VLAN-ID (1-4094).
  vlanId      Int
  name        String
  /// CIDR-Notation, z. B. "192.168.10.0/24".
  subnet      String?
  gateway     String?
  description String?
  accountId   Int
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Ports mit diesem VLAN als untagged/PVID.
  ports       NetworkPort[]
  /// Ports, auf denen dieses VLAN tagged anliegt (Trunk).
  taggedPorts NetworkPortVlan[]
  clients     NetworkClient[]
  areas       NetworkArea[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([accountId, vlanId])
  @@index([accountId])
}

/// Physischer/organisatorischer Bereich innerhalb eines VLANs
/// (z. B. „Imbisscontainer“, „Imbiss“, „Strandbad“ im VLAN Kassen).
model NetworkArea {
  id          Int             @id @default(autoincrement())
  name        String
  /// Sortierung in der UI (aufsteigend).
  sortOrder   Int             @default(0)
  description String?
  /// Typischerweise einem VLAN zugeordnet (kann leer sein).
  vlanId      Int?
  vlan        NetworkVlan?    @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  /// Optionale IP-Range fuer Auto-Zuordnung (inklusive), z. B. 192.168.20.10 .. 192.168.20.39.
  ipFrom      String?
  ipTo        String?
  accountId   Int
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clients     NetworkClient[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
  @@index([vlanId])
}

/// Netzwerk-Infrastruktur-Hardware (Switch, Router, Access Point, Firewall).
/// Beim Anlegen eines Switches werden die Ports automatisch aus `portCount`
/// generiert (API-Logik).
model NetworkDevice {
  id         Int               @id @default(autoincrement())
  name       String
  type       NetworkDeviceType @default(SWITCH)
  vendor     String?
  model      String?
  ipAddress  String?
  macAddress String?
  /// Freitext-Standort, z. B. "Serverraum", "Technikraum Nord".
  location   String?
  notes      String?
  /// Zuletzt vom Hub-Netzwerk-Scan gesehen (MAC-Abgleich). Basis fuer den
  /// Online-/Offline-Status in der UI.
  lastSeenAt DateTime?
  /// Raum, in dem das Geraet steht (Raumuebersicht, Widget "Netzwerk").
  keyRoomId  Int?
  keyRoom    KeyRoom?          @relation(fields: [keyRoomId], references: [id], onDelete: SetNull)
  accountId  Int
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ports      NetworkPort[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([accountId])
  @@index([keyRoomId])
}

/// Physischer Port eines Switches/Routers.
model NetworkPort {
  id          Int               @id @default(autoincrement())
  /// Port-Nummer am Geraet (1..n).
  number      Int
  /// Optionale Beschriftung (Aufdruck/Etikett).
  label       String?
  deviceId    Int
  device      NetworkDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Untagged VLAN (PVID) des Ports.
  vlanId      Int?
  vlan        NetworkVlan?      @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  /// Tagged VLANs (Trunk-Konfiguration).
  taggedVlans NetworkPortVlan[]
  poe         Boolean           @default(false)
  /// Uplink/Zuleitung: Verbindung zu einem anderen Switch/Router statt zu
  /// einem Endgeraet - wird in der Port-Matrix gesondert dargestellt.
  uplink      Boolean           @default(false)
  status      NetworkPortStatus @default(ACTIVE)
  /// Verkabelung: mit welcher Dose / welchem Patchfeld-Port verbunden.
  outletId    Int?              @unique
  outlet      NetworkOutlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)
  notes       String?
  client      NetworkClient?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([deviceId, number])
  @@index([deviceId])
  @@index([vlanId])
}

/// m:n Port <-> VLAN fuer tagged VLANs (Trunk-Ports).
model NetworkPortVlan {
  id     Int         @id @default(autoincrement())
  portId Int
  port   NetworkPort @relation(fields: [portId], references: [id], onDelete: Cascade)
  vlanId Int
  vlan   NetworkVlan @relation(fields: [vlanId], references: [id], onDelete: Cascade)

  @@unique([portId, vlanId])
  @@index([portId])
  @@index([vlanId])
}

/// Physischer Anschluss: Wanddose oder Patchpanel-Port.
model NetworkOutlet {
  id        Int               @id @default(autoincrement())
  /// Beschriftung, z. B. "Dose 2.OG-14" oder "Patch A-07".
  label     String
  /// Raum/Bereich, z. B. "Shop", "Technikraum".
  location  String?
  type      NetworkOutletType @default(WALL_OUTLET)
  notes     String?
  accountId Int
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  port      NetworkPort?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([accountId, label])
  @@index([accountId])
}

/// Endgeraet im Netzwerk (Kassen-PC, Drucker, Kamera, NAS, ...). Kann
/// optional auf ein bestehendes IoT-`Device` verweisen – dann kommen Name/
/// IP/Status aus dem Device-Datensatz und hier wird nur die Netzwerk-
/// Zuordnung (Port/VLAN) gepflegt.
model NetworkClient {
  id         Int               @id @default(autoincrement())
  name       String
  type       NetworkClientType @default(OTHER)
  ipAddress  String?
  macAddress String?
  /// true = feste IP, false = DHCP.
  isStatic   Boolean           @default(false)
  /// Optionaler Link auf ein bestehendes IoT-/Zutritts-Geraet.
  deviceId   Int?              @unique
  device     Device?           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// An welchem Switch-Port das Geraet haengt (NULL = WLAN/unbekannt).
  portId     Int?              @unique
  port       NetworkPort?      @relation(fields: [portId], references: [id], onDelete: SetNull)
  /// Logisch zugeordnetes VLAN (auch ohne Port-Zuordnung moeglich, z. B. WLAN).
  vlanId     Int?
  vlan       NetworkVlan?      @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  /// Physischer Bereich (Imbiss, Container, Strandbad, …).
  areaId     Int?
  area       NetworkArea?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Zuletzt vom Hub-Netzwerk-Scan gesehen (MAC-Abgleich).
  lastSeenAt DateTime?
  notes      String?
  /// Raum, in dem das Endgeraet steht (Raumuebersicht, Widget "Netzwerk").
  keyRoomId  Int?
  keyRoom    KeyRoom?          @relation(fields: [keyRoomId], references: [id], onDelete: SetNull)
  accountId  Int
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([accountId])
  @@index([vlanId])
  @@index([areaId])
  @@index([keyRoomId])
}

// ── Lokaler Hub (On-Site-Agent) ──────────────────────────────────────────────

/// Ein lokal (z. B. auf einem iMac/Mini-PC) laufender Agent, der sich per
/// Account-API-Token mit der Cloud verbindet: Heartbeat, Task-Abholung,
/// Netzwerk-Scans, spaeter Kameras/lokale KI. Online-Status ergibt sich aus
/// `lastSeenAt` (gleiches 5-Minuten-Muster wie bei den Pi-Geraeten).
model HubAgent {
  id                Int       @id @default(autoincrement())
  /// Eindeutiger Name des Agents pro Account (z. B. "imac-technikraum").
  name              String
  hostname          String?
  /// Git-Commit/Version des laufenden Hub-Codes (fuer Update-Diagnose).
  version           String?
  /// Aktivierte Module, z. B. ["network-scan", "tasks"].
  modules           Json?
  /// Live-Status vom Hub, z. B. Parkplatz-Belegung aus dem Kiosk-Tracker.
  status            Json?
  lastSeenAt        DateTime?
  /// Gesetzt, sobald der Offline-Push raus ist; geleert beim Online-Push
  /// (Zustandsuebergang, kein Dauerfeuer) – wie Device.offlineNotifiedAt.
  offlineNotifiedAt DateTime?
  accountId         Int
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

/// Offene Befunde, die der Hub meldet (z. B. VLAN-Fehler an einem Switch-Port
/// oder ein Switch ohne SNMP-Antwort). Der Hub schickt je Quelle immer die
/// komplette aktuelle Liste; neu → Meldung, verschwunden → Entwarnung.
model HubAlert {
  id          Int       @id @default(autoincrement())
  /// Quelle, deren Liste der Hub komplett meldet, z. B. "switch".
  source      String
  /// Stabiler Schluessel, z. B. "vlan:192.168.1.20:7:pvid-nomember".
  key         String
  title       String
  detail      String?
  severity    String    @default("warn")
  hubName     String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// NULL = offen. Kommt der Befund wieder, wird das Feld geleert.
  resolvedAt  DateTime?
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, key])
  @@index([accountId, source, resolvedAt])
}

/// Task-Queue Cloud -> Hub. Die Cloud (UI/Cron) legt Tasks an, der Hub holt
/// sie per Polling ab (PENDING -> RUNNING) und meldet das Ergebnis zurueck
/// (DONE/FAILED). `type` z. B. "PING", "NETWORK_SCAN", "WAKE_ON_LAN".
model HubTask {
  id         Int       @id @default(autoincrement())
  type       String
  payload    Json?
  /// "PENDING" | "RUNNING" | "DONE" | "FAILED"
  status     String    @default("PENDING")
  result     Json?
  error      String?
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([accountId, status])
  @@index([accountId, createdAt])
}

/// IP-Kamera (Reolink) im lokalen Netz. Der Hub spricht sie ueber die
/// CGI-HTTP-API an: Event-Polling (Bewegung/KI) und Schnappschuesse.
/// Zugangsdaten werden nur vom Hub verwendet.
model Camera {
  id                  Int                  @id @default(autoincrement())
  name                String
  /// Geraetetyp: "REOLINK" (CGI-Polling) | "DOORBIRD" (LAN-API, Klingel + Tueroeffner).
  kind                String               @default("REOLINK")
  /// IP oder Hostname im lokalen Netz.
  host                String
  /// MAC-Adresse (vom Hub automatisch gelernt). Erlaubt IP-Re-Mapping bei
  /// DHCP-Wechsel: Hub sucht die MAC im ARP-Scan und aktualisiert `host`.
  macAddress          String?
  httpPort            Int                  @default(80)
  https               Boolean              @default(false)
  username            String
  password            String
  /// Kanal: 0 bei Einzelkameras, 0..n hinter einem NVR/Home Hub.
  channel             Int                  @default(0)
  enabled             Boolean              @default(true)
  /// Fahrzeug-Erkennung (Burst + Plate-OCR + Sichtungen) auf dieser Kamera.
  vehicleDetection    Boolean              @default(true)
  /// Fahrzeug-Box muss mindestens diesen Anteil der Bildflaeche belegen
  /// (0..1), sonst gilt sie als Hintergrundverkehr. null = Hub-Standard (2 %).
  vehicleMinArea      Float?
  /// Einfahrtszone als Polygon [[x,y],...] normiert 0..1; nur Boxen mit
  /// Mittelpunkt in der Zone zaehlen. null = keine Zone.
  vehicleZone         Json?
  /// Halteverbot: Fahrzeuge melden, die zu lange in einer gesperrten Flaeche
  /// stehen. Braucht `noParkZone`, sonst prueft der Hub nichts.
  noParkDetection     Boolean              @default(false)
  /// Gesperrte Flaeche als Polygon [[x,y],...] normiert 0..1. Anders als bei
  /// `vehicleZone` zaehlt der Radaufstandspunkt (Unterkante Mitte) der Box,
  /// damit Fahrzeuge davor nicht mitgezaehlt werden.
  noParkZone          Json?
  /// Standzeit in Minuten, ab der gemeldet wird. null = Hub-Standard (2 min).
  noParkMinutes       Float?
  /// Lieferdienste (DHL, UPS, GLS, Amazon, DPD, Hermes) an der Aufschrift
  /// erkennen: null = aus, "NOTIFY" = nur melden, "OPEN" = Tor oeffnen.
  deliveryMode        String?
  /// Zeitfenster "HH:mm" fuer das Oeffnen; null = Hub-Standard 07:00–20:00.
  deliveryFrom        String?
  deliveryTo          String?
  notes               String?
  /// Letzter Schnappschuss (JPEG) + Zeitpunkt.
  snapshot            Bytes?
  snapshotAt          DateTime?
  /// Zuletzt vom Hub erfolgreich erreicht (Basis fuer Online-Status).
  lastSeenAt          DateTime?
  /// Gesetzt, sobald die Ausfall-Meldung raus ist; geleert bei „wieder
  /// erreichbar“ (Zustandsuebergang, kein Dauerfeuer) – wie bei Device.
  offlineNotifiedAt   DateTime?
  /// Tor offen halten (DoorBird): Bis zu diesem Zeitpunkt loest der Hub das
  /// Tueroeffner-Relais im Takt erneut aus (das Tor schliesst sonst nach ~1 min).
  /// NULL oder vergangen = aus. Quelle der Wahrheit fuer Hub und UI.
  doorHoldUntil       DateTime?
  /// Letzter erfolgreicher Offenhalte-Impuls, vom Hub gemeldet.
  doorHoldPulseAt     DateTime?
  /// Fehler des letzten Offenhalte-Impulses (DoorBird nicht erreichbar o. ae.), NULL = ok.
  doorHoldError       String?
  accountId           Int
  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events              CameraEvent[]
  vehicleSightings    VehicleSighting[]
  allowedVehicles     AllowedVehicle[]     @relation("VehicleTriggerCamera")
  doorbirdVehicles    AllowedVehicle[]     @relation("VehicleDoorbird")
  listedPersons       ListedPerson[]
  personSightings     PersonSighting[]
  surveillanceCameras SurveillanceCamera[]
  /// Zugangsgeraete (Drehkreuze/Tueren), denen diese Kamera zugeordnet ist.
  devices             Device[]             @relation("DeviceCamera")
  scanSnapshots       ScanSnapshot[]
  /// Raum der Schliessanlage, den diese Kamera abdeckt. NULL = keinem Raum
  /// zugeordnet.
  keyRoomId           Int?
  keyRoom             KeyRoom?             @relation(fields: [keyRoomId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  motionRules         RoomRule[]
  ruleActions         RoomRuleAction[]     @relation("RoomRuleActionCamera")

  @@unique([accountId, name])
  @@index([accountId])
  @@index([keyRoomId])
}

/// Account-weiter Überwachungsmodus: manuell und/oder per Zeitplan scharf,
/// Push bei PERSON/VEHICLE auf ausgewählten Kameras.
model SurveillanceConfig {
  id              Int                  @id @default(autoincrement())
  accountId       Int                  @unique
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Manueller Schalter (AN = scharf, unabhängig vom Zeitplan).
  manualArmed     Boolean              @default(false)
  /// Zeitplan aktiv: in Fenster + Wochentag ebenfalls scharf.
  scheduleEnabled Boolean              @default(false)
  /// Bitmaske: Bit0=Mo … Bit6=So.
  daysOfWeek      Int                  @default(127)
  windowStart     String?
  windowEnd       String?
  cooldownMinutes Int                  @default(5)
  alertOnPerson   Boolean              @default(true)
  alertOnVehicle  Boolean              @default(true)
  /// Bei Sighting mit Snapshot per Telegram (Foto + Caption) benachrichtigen.
  alertTelegram   Boolean              @default(true)
  /// JSON-Map letzter Pushes: { "10:PERSON": "ISO8601", ... }
  lastPushByKey   Json?
  cameras         SurveillanceCamera[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model SurveillanceCamera {
  configId Int
  cameraId Int
  config   SurveillanceConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  camera   Camera             @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([configId, cameraId])
  @@index([cameraId])
}

/// Erlaubtes Fahrzeug (Kennzeichen-Whitelist). Bei Erkennung kann ein
/// Shelly geschaltet werden (z. B. Tor oeffnen).
model AllowedVehicle {
  id                Int               @id @default(autoincrement())
  accountId         Int
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Anzeige-Kennzeichen, z. B. "BOR-AB 123".
  plate             String
  /// Normalisiert fuer Abgleich (ohne Leerzeichen/Bindestriche, Grossbuchstaben).
  plateNormalized   String
  name              String
  isActive          Boolean           @default(true)
  notes             String?
  /// Nur diese Kamera darf den Shelly ausloesen. null = alle Kameras.
  cameraId          Int?
  camera            Camera?           @relation("VehicleTriggerCamera", fields: [cameraId], references: [id], onDelete: SetNull)
  /// DoorBird, deren Tueroeffner bei Erkennung geschaltet wird (Hub-Task).
  doorbirdCameraId  Int?
  doorbird          Camera?           @relation("VehicleDoorbird", fields: [doorbirdCameraId], references: [id], onDelete: SetNull)
  /// Shelly, der bei Erkennung geschaltet wird.
  shellyDeviceId    Int?
  shellyDevice      Device?           @relation(fields: [shellyDeviceId], references: [id], onDelete: SetNull)
  /// ON | OFF | TOGGLE
  shellyAction      String            @default("ON")
  /// Optionaler Auto-Off-Timer in Sekunden (sinnvoll fuer Tore/Impulse).
  timerSeconds      Int?
  /// Mindestabstand zwischen zwei Ausloesungen (Minuten).
  cooldownMinutes   Int               @default(2)
  lastTriggeredAt   DateTime?
  /// Bei Kennzeichen-Match Web-Push an Account-Geraete senden.
  notifyOnDetection Boolean           @default(false)
  sightings         VehicleSighting[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([accountId, plateNormalized])
  @@index([accountId, isActive])
  @@index([shellyDeviceId])
  @@index([cameraId])
  @@index([doorbirdCameraId])
}

/// Historie: wann ein Fahrzeug (ggf. mit Kennzeichen) gesehen wurde.
model VehicleSighting {
  id               Int             @id @default(autoincrement())
  accountId        Int
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cameraId         Int?
  camera           Camera?         @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// Rohes Kennzeichen falls bekannt.
  plate            String?
  plateNormalized  String?
  allowedVehicleId Int?
  allowedVehicle   AllowedVehicle? @relation(fields: [allowedVehicleId], references: [id], onDelete: SetNull)
  /// CAMERA_VEHICLE | CAMERA_PLATE | MANUAL | NO_PARKING (steht im Halteverbot)
  source           String          @default("CAMERA_VEHICLE")
  matched          Boolean         @default(false)
  shellyTriggered  Boolean         @default(false)
  shellyOk         Boolean?
  /// Lieferdienst an der Aufschrift erkannt (z. B. "DHL"), sonst null.
  deliveryBrand    String?
  /// Hub hat fuer den Lieferdienst das Tor geoeffnet.
  deliveryOpened   Boolean         @default(false)
  /// Schnappschuss bei Fahrzeugerkennung (JPEG).
  snapshot         Bytes?
  /// Pfad im Blob-Speicher; gesetzt statt `snapshot` bei neuen Sichtungen.
  snapshotBlob     String?
  seenAt           DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([accountId, seenAt])
  @@index([cameraId, seenAt])
  @@index([plateNormalized])
  @@index([allowedVehicleId])
  @@index([snapshotBlob])
}

/// Person auf White- oder Blacklist (z. B. VIP / Hausverbot).
/// Ohne Gesichtserkennung: Automatik nur "jede Person an Kamera X";
/// namentliche Zuordnung erfolgt manuell oder spaeter per Face-ID.
model ListedPerson {
  id                 Int                   @id @default(autoincrement())
  accountId          Int
  account            Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  /// WHITELIST | BLACKLIST
  listType           String
  isActive           Boolean               @default(true)
  notes              String?
  /// Optionale bevorzugte/Heim-Kamera (Face-Match gilt immer account-weit).
  cameraId           Int?
  camera             Camera?               @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// PERSON-Ereignisse in die Historie schreiben (alle Kameras).
  trackHistory       Boolean               @default(true)
  /// Bei Face-Match dieser Person Shelly ausloesen.
  triggerOnDetection Boolean               @default(false)
  /// Bei Face-Match Web-Push an Account-Geraete senden.
  notifyOnDetection  Boolean               @default(false)
  shellyDeviceId     Int?
  shellyDevice       Device?               @relation(fields: [shellyDeviceId], references: [id], onDelete: SetNull)
  shellyAction       String                @default("ON")
  timerSeconds       Int?
  cooldownMinutes    Int                   @default(5)
  lastTriggeredAt    DateTime?
  sightings          PersonSighting[]
  faceEmbeddings     PersonFaceEmbedding[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([accountId, listType, isActive])
  @@index([cameraId])
  @@index([shellyDeviceId])
}

/// Face-Embedding (ArcFace/buffalo_l) einer List-Person fuer lokales Matching am Hub.
model PersonFaceEmbedding {
  id               Int          @id @default(autoincrement())
  accountId        Int
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  listedPersonId   Int
  listedPerson     ListedPerson @relation(fields: [listedPersonId], references: [id], onDelete: Cascade)
  /// Float32-Vektor (typ. 512 dims) als Bytes.
  embedding        Bytes
  model            String       @default("buffalo_l")
  sourceSightingId Int?
  createdAt        DateTime     @default(now())

  @@index([accountId, listedPersonId])
  @@index([listedPersonId])
}

/// Historie von Personenerkennungen (anonym oder einer ListedPerson zugeordnet).
model PersonSighting {
  id              Int           @id @default(autoincrement())
  accountId       Int
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cameraId        Int?
  camera          Camera?       @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  listedPersonId  Int?
  listedPerson    ListedPerson? @relation(fields: [listedPersonId], references: [id], onDelete: SetNull)
  /// CAMERA_PERSON | MANUAL
  source          String        @default("CAMERA_PERSON")
  /// WHITELIST | BLACKLIST falls zugeordnet, sonst null
  listType        String?
  matched         Boolean       @default(false)
  /// Cosine-Similarity 0..1 bei Face-Match.
  matchScore      Float?
  /// FACE_EMBEDDING | MANUAL | null
  matchMethod     String?
  shellyTriggered Boolean       @default(false)
  shellyOk        Boolean?
  notes           String?
  /// Schnappschuss bei klarer Personen-/Gesichtserkennung (JPEG).
  snapshot        Bytes?
  /// Pfad im Blob-Speicher; gesetzt statt `snapshot` bei neuen Sichtungen.
  snapshotBlob    String?
  /// Face-Embedding (Float32, buffalo_l) des Schnappschusses, vom Hub.
  /// Leere Bytes = analysiert, aber kein Gesicht gefunden. Basis fuer das
  /// Gruppieren unbekannter Personen und fuer Ein-Klick-Zuordnung.
  faceEmbedding   Bytes?
  seenAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([accountId, seenAt])
  @@index([cameraId, seenAt])
  @@index([listedPersonId])
  @@index([listType, seenAt])
  @@index([snapshotBlob])
}

/// Bewegungs-/KI-Ereignis einer Kamera, vom Hub per Polling gemeldet.
model CameraEvent {
  id        Int       @id @default(autoincrement())
  cameraId  Int
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  /// "MOTION" | "PERSON" | "VEHICLE" | "ANIMAL" | "OTHER"
  type      String
  startedAt DateTime
  endedAt   DateTime?
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([accountId, startedAt])
  @@index([cameraId, startedAt])
}

/// Vom Hub automatisch entdecktes Geraet im lokalen Netz (ARP-Scan).
/// Wird per (accountId, macAddress) upserted; `lastSeenAt` zeigt, wann das
/// Geraet zuletzt in einem Scan auftauchte.
/// Jede MAC, die der Hub je im Netz gesehen hat. Anders als DiscoveredDevice
/// (unzugeordnete Eintraege verschwinden nach zwei Scans ohne Treffer) bleibt
/// dieser Eintrag bestehen. Er entscheidet, ob ein Geraet "neu" ist und eine
/// Telegram-Meldung ausloest. Beim allerersten Scan wird der Bestand ohne
/// Meldung angelegt.
model KnownNetworkDevice {
  id          Int       @id @default(autoincrement())
  macAddress  String
  /// Zeitpunkt der Telegram-Meldung; null = still uebernommen (Bestand).
  notifiedAt  DateTime?
  firstSeenAt DateTime  @default(now())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, macAddress])
}

/// Gesperrtes Geraet (Sperrliste im Hub). Die Sperre selbst setzt NETGEAR
/// Insight (WLAN > SSID > MAC ACL, Richtlinie "Verbieten"), weil Insight keine
/// offizielle Schnittstelle hat. Der Hub-Scan meldet per Telegram, wenn eine
/// gesperrte MAC trotzdem wieder im Netz auftaucht. Freigeben = Eintrag loeschen.
model BlockedNetworkDevice {
  id         Int       @id @default(autoincrement())
  /// Normalisiert (AA:BB:CC:DD:EE:FF).
  macAddress String
  name       String
  reason     String?
  /// Wann die Sperre in Insight eingetragen wurde (null = nur in der Liste).
  enforcedAt DateTime?
  /// Zuletzt trotz Sperre vom Hub-Scan gesehen.
  lastSeenAt DateTime?
  lastSeenIp String?
  /// Letzte Telegram-Meldung "gesperrtes Geraet wieder im Netz" (Drossel).
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, macAddress])
}

model DiscoveredDevice {
  id          Int      @id @default(autoincrement())
  macAddress  String
  ipAddress   String?
  /// Netzwerk-Interface des Hubs, auf dem das Geraet gesehen wurde (z. B. "en0").
  iface       String?
  /// Hostname aus Reverse-DNS/mDNS (falls aufloesbar).
  hostname    String?
  /// Hersteller aus dem MAC-OUI-Praefix (falls bekannt).
  vendor      String?
  /// Offene TCP-Ports, z. B. [22, 80, 443].
  openPorts   Json?
  /// Vermuteter Geraetetyp aus offenen Ports/Hostname (Heuristik).
  deviceType  String?
  /// Antwortzeit des letzten Pings in Millisekunden.
  responseMs  Int?
  /// true, wenn das Geraet im letzten Scan auf Ping/Port geantwortet hat.
  reachable   Boolean  @default(true)
  /// Wie oft das Geraet in Folge beim Hub-Scan gefehlt hat (bei Treffer = 0).
  /// Unzugeordnete Eintraege werden ab 2 entfernt.
  absentScans Int      @default(0)
  /// Fruehere IP-Adressen (neueste zuerst): [{ ip, seenUntil }]. Wird beim
  /// IP-Wechsel gefuellt; eine IP "gehoert" immer nur dem zuletzt gesehenen
  /// Geraet, aeltere Eintraege geben sie hierhin ab.
  ipHistory   Json?
  /// Name des Hubs, der das Geraet zuletzt gemeldet hat.
  hubName     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, macAddress])
  @@index([accountId, lastSeenAt])
}

// ── Audio: Musik & Durchsagen ────────────────────────────────────────────────

/// Dauerquelle, die eine Zone im Hintergrund abspielt.
enum AudioSourceKind {
  SILENCE
  PLAYLIST
  STREAM
}

/// Empfaenger, der eine Zone vom Sender aus uebernehmen kann. Bewusst kein
/// Wert von AudioSourceKind: die eingestellte Quelle bleibt bestehen, ein
/// Sender legt sich nur voruebergehend darueber und gibt danach wieder frei.
enum AudioExternalKind {
  AIRPLAY
  BLUETOOTH
}

enum AudioTrackKind {
  MUSIC
  JINGLE
  /// Gong/Signal vor einer Durchsage.
  CHIME
  /// Fertige Ansage – hochgeladen oder aus TTS gerendert.
  ANNOUNCEMENT
}

enum AudioAnnouncementSource {
  /// Text wird serverseitig zu Sprache gerendert und als Track gecacht.
  TTS
  /// Vorproduzierte Datei aus der Bibliothek.
  FILE
  /// Im Browser aufgenommene Live-Durchsage (Push-to-Talk).
  LIVE
}

enum AudioJobKind {
  ANNOUNCE
  PLAY
  STOP
  VOLUME
  /// Zone soll ihren lokalen Dateicache mit der Bibliothek abgleichen.
  SYNC_LIBRARY
  /// Live-Durchsage: die Zone spielt den Ton einer AudioLiveSession ab, bis
  /// sie beendet wird.
  LIVE
}

enum AudioJobStatus {
  PENDING
  SENT
  PLAYING
  DONE
  FAILED
}

enum AudioScheduleAction {
  ANNOUNCE
  PLAY
  STOP
  VOLUME
}

/// Woran sich der Zeitpunkt eines Audio-Zeitplans bemisst.
enum AudioScheduleTrigger {
  /// Feste Uhrzeit `timeOfDay`.
  TIME
  /// Betriebsbeginn der zustaendigen Betriebszeit, plus/minus `offsetMinutes`.
  OPENING
  /// Betriebsende, plus/minus `offsetMinutes`.
  CLOSING
}

/// Wann die Musik einer Zone von selbst an- und ausgeht.
enum AudioMusicMode {
  /// Keine Automatik: Musik laeuft, bis jemand stoppt.
  MANUAL
  /// Eigene Musikzeiten der Zone (`musicTimes`), ein Fenster je Wochentag.
  TIMES
  /// Betriebszeit des Raums, je Ende mit Versatz.
  OPERATING
}

/// Eine Beschallungszone = ein Raspberry-Pi-Abspieler mit angeschlossenem
/// Verstaerker. Haelt Soll-Zustand (Quelle, Lautstaerken) und den vom Pi
/// gemeldeten Ist-Zustand.
model AudioZone {
  id                 Int                @id @default(autoincrement())
  accountId          Int
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  /// Abspieler-Geraet (Device.type = AUDIO_PLAYER). Zonen koennen auch ohne
  /// Hardware angelegt werden (Planung) – sie spielen dann nichts ab.
  deviceId           Int?               @unique
  device             Device?            @relation("AudioZoneDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  sortOrder          Int                @default(0)
  isActive           Boolean            @default(true)
  /// Snapcast-Gruppe: Zonen mit demselben Namen spielen synchron. Noetig, wenn
  /// sich Bereiche akustisch ueberlappen (Aussengelaende). null = eigenstaendig.
  syncGroup          String?
  /// Grundlautstaerke der Musik (0–100).
  volume             Int                @default(50)
  /// Lautstaerke der Durchsage selbst (0–100).
  announcementVolume Int                @default(85)
  /// Musiklautstaerke waehrend einer Durchsage (Ducking, 0–100).
  duckVolume         Int                @default(15)
  /// Ist-Zustand: was gerade laeuft. Ein Stopp setzt das Feld auf SILENCE; der
  /// Abspieler nimmt es nach Neustart oder Durchsage als Vorgabe, um die Musik
  /// wieder aufzunehmen.
  sourceKind         AudioSourceKind    @default(SILENCE)
  /// Quelle, die "Start" ohne weitere Angabe abspielt. Anders als sourceKind
  /// eine Einstellung der Zone – sie ueberlebt einen Stopp. SILENCE heisst:
  /// Diese Zone macht nur Durchsagen.
  defaultSource      AudioSourceKind    @default(PLAYLIST)
  playlistId         Int?
  playlist           AudioPlaylist?     @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  /// Gewaehlter Webradio-Sender. Die URL steht zusaetzlich in streamUrl, damit
  /// Abspieler und aeltere Jobs sie ohne Join lesen koennen.
  streamId           Int?
  stream             AudioStream?       @relation(fields: [streamId], references: [id], onDelete: SetNull)
  /// Webradio-/Stream-URL fuer sourceKind = STREAM (Kopie des gewaehlten Senders).
  streamUrl          String?
  /// Musik-Automatik: im Fenster startet die Quelle von selbst, an dessen Ende
  /// stoppt sie, ausserhalb startet keine eigene Musik. Durchsagen laufen
  /// immer. Ein Stopp im Fenster gilt bis zum naechsten Fensterbeginn.
  musicMode          AudioMusicMode     @default(MANUAL)
  /// Fenster je Wochentag fuer musicMode = TIMES:
  /// `[{ weekday: 0..6 (Mo..So), from: "HH:mm", to: "HH:mm" }]`. `to` vor
  /// `from` laeuft ueber Mitternacht.
  musicTimes         Json               @default("[]")
  /// Versatz in Minuten fuer musicMode = OPERATING (negativ = vorher). Ohne
  /// Raum mit Betriebszeit wirkt die Kopplung nicht.
  musicOpenOffset    Int                @default(0)
  musicCloseOffset   Int                @default(0)
  /// musicMode = OPERATING: Musik auch zu Bahnmieten und Kursen (Unterprofile)?
  musicExtent        OperatingExtent    @default(SELF)
  /// Manuelles Play ausserhalb des Musikfensters: Bis hierhin gilt die Zone
  /// als "Musik erlaubt" (naechster Fensterbeginn, laengstens Tagesende).
  /// Ein manueller Stopp loescht den Wert. Manuell geht vor Automatik.
  musicOverrideUntil DateTime?
  /// Letzte Quellenwahl des Personals (Start/Stopp von Hand, auch ueber
  /// emp-control). Die Playlist-Abstimmung der Fahrer pausiert danach fuer
  /// `GamificationConfig.musicVoteHoldMinutes`: Personal geht vor.
  staffChoiceAt      DateTime?
  /// Musik-Skill der Kunden-App: bis hierhin spielt die Wahl eines Fahrers,
  /// die Abstimmung ruht so lange (lib/rider-skills).
  riderChoiceUntil   DateTime?
  /// AirPlay-Empfaenger aktiv: ein Sender im WLAN darf die Zone uebernehmen.
  airplayEnabled     Boolean            @default(false)
  /// Bluetooth-Empfaenger (A2DP-Sink) aktiv.
  bluetoothEnabled   Boolean            @default(false)
  /// Name, unter dem die Zone als AirPlay-/Bluetooth-Ziel erscheint.
  /// null = Zonenname.
  externalName       String?
  /// Bis wann die Zone neue Bluetooth-Kopplungen annimmt. Ausserhalb dieses
  /// Fensters ist sie nicht sichtbar und nur bereits gekoppelte Geraete
  /// koennen sich verbinden.
  pairableUntil      DateTime?
  /// Ist-Zustand, vom Pi im Heartbeat gemeldet.
  isPlaying          Boolean            @default(false)
  currentTitle       String?
  reportedVolume     Int?
  /// Empfaenger, der die Zone gerade uebernommen hat – null = niemand.
  /// Solange gesetzt, ist die eigene Musik pausiert.
  externalActive     AudioExternalKind?
  /// Name des Senders, der uebernommen hat (z. B. "iPhone von Anna").
  externalSender     String?
  lastStateAt        DateTime?
  /// Raum, den diese Zone beschallt. Ueber ihn erbt die Zone die Betriebszeit,
  /// auf die sich Zeitplaene mit Betriebsbeginn/-ende beziehen. NULL = keinem
  /// Raum zugeordnet.
  keyRoomId          Int?
  keyRoom            KeyRoom?           @relation(fields: [keyRoomId], references: [id], onDelete: SetNull)
  jobs               AudioJob[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  ruleActions        RoomRuleAction[]

  @@index([accountId, sortOrder])
  @@index([playlistId])
  @@index([streamId])
  @@index([keyRoomId])
}

/// Audiodatei in der Mediathek. Die Datei liegt im Blob-Storage; die Zonen-Pis
/// laden sie einmal herunter und halten sie lokal vor, damit die Wiedergabe
/// auch ohne Internetverbindung funktioniert.
model AudioTrack {
  id            Int                 @id @default(autoincrement())
  accountId     Int
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title         String
  artist        String?
  kind          AudioTrackKind      @default(MUSIC)
  url           String
  /// Blob-Pfad, damit die Datei beim Loeschen des Tracks mit entfernt wird.
  blobPathname  String?
  contentType   String?
  sizeBytes     Int?
  durationSec   Int?
  /// Cache-Schluessel fuer TTS: Hash aus Text + Stimme. Gleicher Text ergibt
  /// denselben Track, sodass keine erneuten TTS-Kosten anfallen.
  ttsHash       String?
  playlistItems AudioPlaylistItem[]
  announcements AudioAnnouncement[]
  birthdayAnnouncements RiderBirthday[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([accountId, ttsHash])
  @@index([accountId, kind])
}

model AudioPlaylist {
  id           Int                 @id @default(autoincrement())
  accountId    Int
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  shuffle      Boolean             @default(true)
  /// Uebergangszeit zwischen zwei Titeln in Sekunden (0 = hart schneiden).
  crossfadeSec Int                 @default(3)
  items        AudioPlaylistItem[]
  zones        AudioZone[]
  schedules    AudioSchedule[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  ruleActions  RoomRuleAction[]

  @@index([accountId])
}

/// Benannter Webradio-Sender. Zonen waehlen ihn aus einer Liste, statt die
/// Stream-URL je Zone zu hinterlegen.
model AudioStream {
  id        Int         @id @default(autoincrement())
  accountId Int
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  url       String
  zones     AudioZone[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([accountId])
}

model AudioPlaylistItem {
  id         Int           @id @default(autoincrement())
  playlistId Int
  playlist   AudioPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    Int
  track      AudioTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)

  @@index([playlistId, sortOrder])
  @@index([trackId])
}

/// Eine Durchsage – entweder als wiederverwendbare Vorlage (Betriebsschluss,
/// Kursbeginn) oder einmalig aus dem Dashboard abgeschickt.
model AudioAnnouncement {
  id           Int                     @id @default(autoincrement())
  accountId    Int
  account      Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  source       AudioAnnouncementSource @default(TTS)
  /// Ansagetext fuer source = TTS.
  text         String?
  /// Stimmen-ID des TTS-Anbieters. null = Account-Standard.
  voice        String?
  /// Gerenderte bzw. hochgeladene Audiodatei. Bei TTS wird sie beim ersten
  /// Abspielen erzeugt und danach wiederverwendet.
  trackId      Int?
  track        AudioTrack?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  /// Gong vor der Ansage abspielen.
  chime        Boolean                 @default(true)
  repeatCount  Int                     @default(1)
  /// Hoehere Prioritaet unterbricht eine laufende Durchsage (Notfall = 100).
  priority     Int                     @default(0)
  /// Zielzonen als AudioZone-ID-Array. Leeres Array = alle aktiven Zonen.
  zoneIds      Json                    @default("[]")
  /// Vorlage = im Dashboard als Schnellwahl sichtbar und in Zeitplaenen nutzbar.
  isTemplate   Boolean                 @default(false)
  lastPlayedAt DateTime?
  schedules    AudioSchedule[]
  jobs         AudioJob[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  ruleActions  RoomRuleAction[]

  @@index([accountId, isTemplate])
  @@index([trackId])
}

/// Zeitgesteuerte Aktion: Oeffnungsmusik, Kursdurchsage, Betriebsschluss.
/// Wird vom selben Cron-Muster ausgewertet wie die Shelly-Automationen.
model AudioSchedule {
  id                  Int                    @id @default(autoincrement())
  accountId           Int
  account             Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                String
  isActive            Boolean                @default(true)
  action              AudioScheduleAction
  /// Wochentage als Bitmaske: bit0=Mo, bit1=Di, …, bit6=So. 127 = jeden Tag.
  /// Bei Betriebsbeginn/-ende zaehlt der Betriebstag, nicht der Kalendertag,
  /// an dem ein Ende nach Mitternacht faellt.
  daysOfWeek          Int                    @default(127)
  /// Woran sich der Zeitpunkt bemisst: Uhrzeit oder Betriebszeit.
  trigger             AudioScheduleTrigger   @default(TIME)
  /// "HH:mm" in der Account-Zeitzone (nur trigger = TIME).
  timeOfDay           String?
  /// Verschiebung in Minuten gegenueber Betriebsbeginn/-ende (OPENING, CLOSING).
  offsetMinutes       Int                    @default(0)
  /// Welche Betriebszeit gilt; null = die des Raums der jeweiligen Zielzone.
  /// Dieselbe Regel wie bei `RoomRule.operatingScheduleId`.
  operatingScheduleId Int?
  operatingSchedule   OperatingSchedule?     @relation(fields: [operatingScheduleId], references: [id], onDelete: SetNull)
  /// Bedingung an die Betriebszeit der Zielzone: nur waehrend / nur ausserhalb.
  /// Zonen, auf die sie nicht zutrifft, bleiben beim Lauf aussen vor.
  operating           RuleOperatingCondition @default(ANY)
  /// Zielzonen als AudioZone-ID-Array. Leeres Array = alle aktiven Zonen.
  zoneIds             Json                   @default("[]")
  announcementId      Int?
  announcement        AudioAnnouncement?     @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  playlistId          Int?
  playlist            AudioPlaylist?         @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  /// Ziellautstaerke fuer action = VOLUME (0–100).
  volume              Int?
  /// Letzter Lauf – Idempotenz-Guard im Cron gegen Doppelausfuehrung.
  lastRunAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([accountId, isActive])
  @@index([announcementId])
  @@index([playlistId])
  @@index([operatingScheduleId])
}

/// Kommando an eine Zone plus Verlaufseintrag. Der Zonen-Pi holt offene Jobs
/// ueber den Realtime-Kanal ab und meldet den Status zurueck.
model AudioJob {
  id             Int                @id @default(autoincrement())
  accountId      Int
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  zoneId         Int
  zone           AudioZone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  kind           AudioJobKind
  status         AudioJobStatus     @default(PENDING)
  announcementId Int?
  announcement   AudioAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  /// Live-Durchsage, deren Ton dieser Job abspielt (nur kind = LIVE).
  liveSessionId  Int?
  liveSession    AudioLiveSession?  @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  /// Kommandoparameter, z. B. { url, volume, playlistId, trackUrls, chime }.
  payload        Json?
  /// Ausloeser: "MANUAL" | "SCHEDULE" | "MONITOR" | "EMERGENCY".
  triggerKind    String             @default("MANUAL")
  errorMessage   String?
  createdAt      DateTime           @default(now())
  sentAt         DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([accountId, createdAt])
  @@index([zoneId, status])
  @@index([announcementId])
  @@index([liveSessionId])
}

enum AudioLiveStatus {
  LIVE
  ENDED
}

/// Live-Durchsage aus dem Browser. Der Browser schickt den Mikrofonton in
/// kurzen Stuecken (AudioLiveChunk), die Zonen-Pis holen sie fortlaufend ab
/// und spielen sie sofort ab – bis jemand stoppt oder der Browser verstummt.
model AudioLiveSession {
  id            Int              @id @default(autoincrement())
  accountId     Int
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status        AudioLiveStatus  @default(LIVE)
  /// Wer spricht – fuer den Hinweis, wenn eine zweite Live-Durchsage dieselbe
  /// Zone will.
  startedByName String?
  /// Rohes PCM, 16 Bit little-endian, mono, mit dieser Abtastrate.
  sampleRate    Int              @default(16000)
  chime         Boolean          @default(true)
  /// Hoehere Prioritaet unterbricht eine laufende Durchsage (Notfall = 100).
  priority      Int              @default(0)
  /// Hoechste bisher empfangene Stueck-Nummer; 0 = noch kein Ton.
  lastSeq       Int              @default(0)
  /// Letztes Lebenszeichen des Browsers. Bleibt es aus, gilt die Sitzung als
  /// beendet, damit keine Zone an einem geschlossenen Tab haengen bleibt.
  lastChunkAt   DateTime?
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  chunks        AudioLiveChunk[]
  jobs          AudioJob[]

  @@index([accountId, status])
}

/// Ein Stueck Ton einer Live-Durchsage (einige hundert Millisekunden). Wird
/// nur kurz vorgehalten: die Pis holen es sofort ab.
model AudioLiveChunk {
  id        Int              @id @default(autoincrement())
  sessionId Int
  session   AudioLiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  data      Bytes
  createdAt DateTime         @default(now())

  @@unique([sessionId, seq])
}

// ─── Soundweb London (BSS) ───────────────────────────────────────────────────
// DSP-Prozessoren der BLU-Serie, die der Hub ueber das London-DI-Protokoll
// (TCP 1023) steuert. Das Design selbst entsteht weiter in Audio Architect;
// hier stehen nur die Regler, die im Alltag bedient werden – als Ersatz fuer
// den Windows-Rechner mit Custom Panel.

/// Art eines Soundweb-Reglers – bestimmt Bedienelement und Kodierung des
/// 32-Bit-Werts der State Variable (siehe `src/lib/soundweb.ts`).
enum SoundwebControlKind {
  /// Pegel in dB eines Gain-Objekts (Fader-Law: linear zwischen -10 und
  /// +10 dB, darunter logarithmisch).
  GAIN
  /// Stummschaltung: 0 = an, 1 = stumm.
  MUTE
  /// Regler ohne dB-Law als Prozent des Reglerwegs (DI_SETSVPERCENT).
  PERCENT
  /// Ganzzahlige Auswahl, z. B. Eingang eines Source Selectors.
  SELECT
  /// Parameter-Preset abrufen (Broadcast, braucht keine Adresse).
  PRESET
}

model SoundwebDevice {
  id                Int               @id @default(autoincrement())
  accountId         Int
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  /// IP-Adresse oder Hostname im LAN des Hubs.
  host              String
  port              Int               @default(1023)
  /// HiQnet-Node-Adresse (16 Bit), wie Audio Architect sie im Netzwerkfenster
  /// zeigt (z. B. 0x0001 = 1). Steht auch vorn in der HiQnet-Adresse jedes
  /// Objekts (0xNNNNvvoooooo).
  node              Int
  sortOrder         Int               @default(0)
  isActive          Boolean           @default(true)
  /// Ist-Zustand der DI-Verbindung, vom Hub gemeldet (alle 60 s und bei
  /// jedem Wechsel). Gilt nur zusammen mit einem frischen lastSeenAt.
  connected         Boolean           @default(false)
  lastSeenAt        DateTime?
  lastError         String?
  /// Seit wann die Verbindung getrennt ist (NULL = verbunden). Erst nach
  /// einer Karenzzeit gibt es eine Ausfall-Meldung.
  disconnectedAt    DateTime?
  /// Gesetzt, sobald die Ausfall-Meldung raus ist; geleert bei „wieder da“.
  offlineNotifiedAt DateTime?
  /// Name des Hubs, der die Verbindung haelt.
  hubName           String?
  controls          SoundwebControl[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([accountId, sortOrder])
}

/// Ein Bedienelement auf der Soundweb-Karte: eine State Variable eines
/// Objekts im Audio-Architect-Design (Gain, Mute, Quellenwahl) oder ein Preset.
model SoundwebControl {
  id            Int                 @id @default(autoincrement())
  accountId     Int
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId      Int
  device        SoundwebDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name          String
  /// Abschnitt auf der Karte (z. B. "Halle", "Gastro"). null = ohne Abschnitt.
  group         String?
  kind          SoundwebControlKind
  /// HiQnet-Node der State Variable; null = Node des Geraets. Ueber das
  /// HiQnet-Netz lassen sich auch Objekte anderer Einheiten ansprechen.
  node          Int?
  /// Virtual Device – fuer alle Audio-Objekte 0x03.
  virtualDevice Int                 @default(3)
  /// Objekt-Adresse (24 Bit), z. B. 0x000100 fuer das erste Objekt im Design.
  objectId      Int                 @default(0)
  /// State-Variable-ID im Objekt (Gain-Objekt: 0 = Gain, 1 = Mute, 2 = Polaritaet).
  stateVariable Int                 @default(0)
  /// GAIN: Reglerbereich in dB. Am unteren Anschlag zeigt die Karte "-inf".
  minDb         Float               @default(-80)
  maxDb         Float               @default(10)
  /// SELECT: Auswahlwerte als [{ "value": 0, "label": "CD" }, ...].
  options       Json?
  /// PRESET: Preset-ID aus dem Design-Baum (Zahl in eckigen Klammern).
  presetId      Int?
  sortOrder     Int                 @default(0)
  /// Ist-Wert: Rohwert der State Variable (32 Bit signed) bzw. Prozent*65536
  /// bei PERCENT, vom Hub aus dem Abonnement gemeldet.
  value         Int?
  valueAt       DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([accountId])
  @@index([deviceId, sortOrder])
}

// ─── Schließanlage ───────────────────────────────────────────────────────────
// Hierarchie: Raum -> Tuer -> Schloss. Schluessel haengen ueber
// `KeyLockAssignment` an beliebig vielen Schloessern; ein Generalschluessel ist
// damit einfach ein Schluessel mit vielen Zuordnungen. Ausgabe/Ruecknahme laeuft
// ueber `KeyHandover` (Kopf) + `KeyHandoverItem` (je Schluessel).

/// Raum bzw. Bereich, in dem Tueren haengen.
model KeyRoom {
  id                  Int                @id @default(autoincrement())
  accountId           Int
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                String
  /// Symbol in der Raumuebersicht (Schluessel aus src/components/raeume/room-icons.tsx); null = aus dem Namen geraten.
  icon                String?
  /// Raumnummer/Kennung, z. B. "1.03".
  number              String?
  building            String?
  floor               String?
  notes               String?            @db.Text
  doors               KeyDoor[]
  /// IoT-Geraete, die in diesem Raum haengen (Shelly, Taster, Smart Lock).
  devices             Device[]
  /// Kameras, die diesen Raum abdecken.
  cameras             Camera[]
  /// Beschallungszonen, die diesen Raum beschallen.
  audioZones          AudioZone[]
  /// Betriebszeit, nach der sich dieser Raum richtet. Regeln fragen darueber,
  /// ob gerade geoeffnet ist; ohne Profil gilt der Raum als immer verfuegbar.
  operatingScheduleId Int?
  operatingSchedule   OperatingSchedule? @relation(fields: [operatingScheduleId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  rules               RoomRule[]
  /// Solltemperatur halten (Fuehler + Heizung), hoechstens eine je Raum.
  climate             RoomClimate?
  climateSamples      ClimateSample[]
  networkDevices      NetworkDevice[]
  networkClients      NetworkClient[]
  motionEvents        RoomMotionEvent[]

  @@index([accountId])
  @@index([accountId, building])
  @@index([operatingScheduleId])
}

/// Tuer. `roomId` ist optional, damit Aussen-/Gemeinschaftstueren (Haupteingang,
/// Treppenhaus) ohne Pseudo-Raum erfasst werden koennen.
model KeyDoor {
  id         Int       @id @default(autoincrement())
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roomId     Int?
  room       KeyRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  name       String
  doorNumber String?
  notes      String?   @db.Text
  locks      KeyLock[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([accountId])
  @@index([roomId])
}

/// Schloss/Zylinder in einer Tuer. Eine Tuer kann mehrere Schloesser haben.
model KeyLock {
  id           Int                 @id @default(autoincrement())
  accountId    Int
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  doorId       Int
  door         KeyDoor             @relation(fields: [doorId], references: [id], onDelete: Cascade)
  /// Schliessungs-/Zylindernummer aus dem Schliessplan.
  lockNumber   String?
  /// "CYLINDER" | "PADLOCK" | "ELECTRONIC" | "OTHER"
  lockType     String              @default("CYLINDER")
  /// Schliessystem/Anlage, z. B. "Hauptanlage 2024".
  system       String?
  manufacturer String?
  installedAt  DateTime?
  notes        String?             @db.Text
  /// Optionales IoT-Geraet, das diesen Schliesspunkt elektronisch oeffnet
  /// (Nuki/LOQED Smart Lock, Shelly am Tueroeffner). NULL = rein mechanisch.
  deviceId     Int?
  device       Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  keys         KeyLockAssignment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
  @@index([doorId])
  @@index([deviceId])
}

/// Physisches Schluessel-Exemplar. Jede Kopie ist ein eigener Datensatz, damit
/// das Protokoll eindeutig auf ein Stueck zeigt.
model KeyItem {
  id        Int                 @id @default(autoincrement())
  accountId Int
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Praegung/Kennzeichnung, eindeutig je Mandant.
  keyNumber String
  label     String?
  /// "SINGLE" | "GROUP" | "MAIN" | "GRAND" – reine Klassifizierung, die
  /// tatsaechliche Schliessberechtigung ergibt sich aus `locks`.
  level     String              @default("SINGLE")
  /// "AVAILABLE" | "ISSUED" | "LOST" | "DESTROYED"
  status    String              @default("AVAILABLE")
  notes     String?             @db.Text
  locks     KeyLockAssignment[]
  handovers KeyHandoverItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([accountId, keyNumber])
  @@index([accountId])
  @@index([accountId, status])
}

/// n:m zwischen Schluessel und Schloss.
model KeyLockAssignment {
  id        Int      @id @default(autoincrement())
  keyId     Int
  key       KeyItem  @relation(fields: [keyId], references: [id], onDelete: Cascade)
  lockId    Int
  lock      KeyLock  @relation(fields: [lockId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([keyId, lockId])
  @@index([lockId])
}

/// Schluesselnehmer. Entweder ein Mitarbeiter (`ticketId` auf ein Ticket mit
/// `source = EMP_CONTROL`) oder frei erfasst (Externe, Handwerker, Reinigung).
/// Name/Kontakt werden auch bei Mitarbeitern als Snapshot gehalten, damit das
/// Protokoll nach dem Loeschen des Tickets lesbar bleibt.
model KeyHolder {
  id        Int           @id @default(autoincrement())
  accountId Int
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticketId  Int?
  ticket    Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  firstName String?
  lastName  String?
  company   String?
  email     String?
  phone     String?
  notes     String?       @db.Text
  handovers KeyHandover[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([accountId])
  @@index([ticketId])
}

/// Protokollkopf einer Schluesselausgabe. Buendelt mehrere Schluessel, damit
/// eine Belehrung/Unterschrift fuer den gesamten Vorgang gilt.
model KeyHandover {
  id               Int                @id @default(autoincrement())
  accountId        Int
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  holderId         Int
  holder           KeyHolder          @relation(fields: [holderId], references: [id], onDelete: Cascade)
  policyTemplateId Int?
  policyTemplate   KeyPolicyTemplate? @relation(fields: [policyTemplateId], references: [id], onDelete: SetNull)
  issuedAt         DateTime           @default(now())
  /// Name des ausgebenden Admins (Snapshot, kein FK – Admins koennen wegfallen).
  issuedByName     String?
  /// Geplante Rueckgabe.
  dueAt            DateTime?
  /// Pfand in Euro.
  deposit          Float?
  /// "DRAFT" | "ISSUED" | "PARTIALLY_RETURNED" | "RETURNED" | "LOST"
  status           String             @default("ISSUED")
  notes            String?            @db.Text
  items            KeyHandoverItem[]
  signatures       KeySignature[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([accountId])
  @@index([accountId, status])
  @@index([holderId])
}

/// Ein Schluessel innerhalb eines Protokolls. Rueckgabe ist einzeln moeglich.
model KeyHandoverItem {
  id             Int         @id @default(autoincrement())
  handoverId     Int
  handover       KeyHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  keyId          Int
  key            KeyItem     @relation(fields: [keyId], references: [id], onDelete: Restrict)
  /// "ISSUED" | "RETURNED" | "LOST"
  itemStatus     String      @default("ISSUED")
  returnedAt     DateTime?
  returnedByName String?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())

  @@unique([handoverId, keyId])
  @@index([keyId])
}

/// Belehrungs-/Haftungstext. Append-only versioniert: eine Aenderung erzeugt
/// einen neuen Datensatz mit `version + 1`, damit bereits signierte Dokumente
/// reproduzierbar bleiben.
model KeyPolicyTemplate {
  id            Int            @id @default(autoincrement())
  accountId     Int
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  version       Int            @default(1)
  /// Belehrungstext (Umgang mit Schluesseln, Verlustmeldung, Rueckgabe).
  bodyText      String         @db.Text
  /// Haftungserklaerung, die separat bestaetigt wird.
  liabilityText String?        @db.Text
  isActive      Boolean        @default(true)
  handovers     KeyHandover[]
  signatures    KeySignature[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([accountId, name, version])
  @@index([accountId])
  @@index([accountId, isActive])
}

/// Signaturvorgang zu einem Protokoll. `token` ist das Zugriffsgeheimnis der
/// oeffentlichen `/schluessel/<token>`-Seite (QR-Code). Die Snapshots frieren
/// Text und Schluesseldaten zum Zeitpunkt der Ausstellung ein.
model KeySignature {
  id               Int                @id @default(autoincrement())
  accountId        Int
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  handoverId       Int
  handover         KeyHandover        @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  /// "HANDOVER" | "RETURN"
  kind             String             @default("HANDOVER")
  token            String             @unique
  expiresAt        DateTime
  policyTemplateId Int?
  policyTemplate   KeyPolicyTemplate? @relation(fields: [policyTemplateId], references: [id], onDelete: SetNull)
  /// Volltext-Kopie von Belehrung + Haftung zum Ausstellungszeitpunkt.
  policySnapshot   Json
  /// Schluesselliste + Empfaengerdaten als JSON-Snapshot.
  keySnapshot      Json
  signedName       String?
  /// Unterschrift als PNG-DataURL.
  signatureImage   String?            @db.Text
  signedAt         DateTime?
  signerIp         String?
  signerUserAgent  String?
  /// Archiviertes PDF, wird beim Signieren erzeugt.
  pdf              Bytes?
  /// Pfad des PDF im Blob-Speicher; gesetzt statt `pdf` bei neuen Protokollen.
  pdfBlob          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([accountId])
  @@index([handoverId])
  @@index([token])
  @@index([pdfBlob])
}

// ─────────────────────────────────────────────────────────────────────────────
// Betriebszeiten
// ─────────────────────────────────────────────────────────────────────────────
// Wann hat der Betrieb geoeffnet? Diese Frage war bisher nirgends beantwortbar:
// `AccessArea.openingHours` ist Freitext und wird nur angezeigt, maschinenlesbar
// lagen die Zeiten ausschliesslich extern in ANNY – und dort je Service, nicht
// je Betrieb. Automationen brauchen sie ausgewertet ("bei Betriebsbeginn Licht
// an", "ausserhalb der Betriebszeit alles aus"), deshalb dieses Modell.
//
// Aufbau: Profil -> Saison -> Oeffnungsperiode je Wochentag, dazu Ausnahmetage.
// Findet sich fuer einen Tag keine Saison, gilt der Betrieb als geschlossen.
// Die Kindtabellen tragen bewusst keinen `accountId`: sie haengen ueber Cascade
// am Profil, das die Mandantengrenze zieht.

/// Wofuer ein Bereich steht, wo das System ihn ohne Raum braucht. Hoechstens
/// ein Profil je Rolle und Mandant; ohne Rolle wird ueber den Namen gesucht.
enum OperatingRole {
  /// Lift: "Lift geoeffnet" und Auslastung in der Kunden-App, Skills.
  LIFT
  /// Shop: Oeffnungszeit im Check-in-Monitor.
  SHOP
  /// Strandbad: Oeffnungszeit im Beach Pass.
  BEACH
}

/// Wie weit eine Automation die Betriebszeit fasst, wenn der Bereich
/// Unterprofile (Bahnmieten, Kurse) hat.
enum OperatingExtent {
  /// Nur die Betriebszeit des Bereichs selbst (oeffentlicher Betrieb).
  SELF
  /// Dazu gebuchte Termine der Unterprofile (anny-Tickets ihrer Ressource),
  /// beschnitten auf deren Zeiten.
  BOOKED_SUBPROFILES
  /// Dazu alle Zeiten der Unterprofile, auch ohne Buchung.
  SUBPROFILES
}

/// Betriebszeit-Profil, z. B. "Strandbad" oder "Gastronomie". Ein Raum haengt an
/// hoechstens einem Profil; Regeln fragen darueber, ob gerade geoeffnet ist.
model OperatingSchedule {
  id             Int                  @id @default(autoincrement())
  accountId      Int
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// Vorbelegung fuer neue Raeume. Hoechstens ein Profil je Mandant.
  isDefault      Boolean              @default(false)
  sortOrder      Int                  @default(0)
  /// Unterprofil eines Bereichs, z. B. Bahnmiete A unter Wasserski. Nur eine
  /// Ebene. Unterprofile erscheinen nicht in der Kunden-App und zaehlen nicht
  /// fuer "Lift geoeffnet"; sie dienen der Belegung der Anlagen.
  parentId       Int?
  parent         OperatingSchedule?   @relation("OperatingSubprofiles", fields: [parentId], references: [id], onDelete: SetNull)
  children       OperatingSchedule[]  @relation("OperatingSubprofiles")
  /// Anlagen, die das Profil belegt ("Seilbahn A", "Übungslift"). Zwei Profile
  /// mit gleicher Anlage duerfen sich zeitlich nicht ueberschneiden.
  facilities     String[]             @default([])
  /// anny-Ressource fuer den Abgleich, z. B. "179480". Leer: ueber Website/Namen.
  annyResourceId String?
  /// Geteilte Zeit: zwei Profile mit diesem Haken duerfen sich auf derselben
  /// Anlage ueberschneiden (Bahnmiete und Kurs, anny verhindert Doppelbuchungen).
  sharedTime     Boolean              @default(false)
  /// Rolle des Bereichs (Lift, Shop, Strandbad); null = keine.
  role           OperatingRole?
  seasons        OperatingSeason[]
  exceptions     OperatingException[]
  rooms          KeyRoom[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  rules          RoomRule[]
  climates       RoomClimate[]
  audioSchedules AudioSchedule[]

  @@index([accountId])
  @@index([parentId])
}

/// Zeitraum im Jahr mit eigenem Wochenplan, z. B. "Sommer 01.05.–15.09.".
/// `startMmDd`/`endMmDd` sind "MM-TT" und gelten jedes Jahr erneut. Ein Ende vor
/// dem Start laeuft ueber den Jahreswechsel (Wintersaison 11-01 bis 03-31).
model OperatingSeason {
  id         Int               @id @default(autoincrement())
  scheduleId Int
  schedule   OperatingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name       String
  startMmDd  String
  endMmDd    String
  /// Bei Ueberschneidung gewinnt die Saison mit der kleineren Zahl.
  sortOrder  Int               @default(0)
  periods    OperatingPeriod[]

  @@index([scheduleId])
}

/// Oeffnungszeit an einem Wochentag. Mehrere Perioden je Tag sind erlaubt, damit
/// eine Mittagspause abbildbar bleibt. `closesAt` vor `opensAt` laeuft ueber
/// Mitternacht (18:00–02:00); gleiche Werte bedeuten durchgehend geoeffnet.
model OperatingPeriod {
  id       Int             @id @default(autoincrement())
  seasonId Int
  season   OperatingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  /// 0=Mo … 6=So, wie die `daysOfWeek`-Bitmasken der Automationen.
  weekday  Int
  opensAt  String
  closesAt String

  @@index([seasonId])
  @@index([seasonId, weekday])
}

/// Einzelner abweichender Tag: Feiertag, Betriebsferien, Sonderoeffnung.
/// Schlaegt jede Saison. `closed` heisst ganztaegig zu; sonst gelten die Zeiten.
model OperatingException {
  id         Int               @id @default(autoincrement())
  scheduleId Int
  schedule   OperatingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// Kalendertag "YYYY-MM-TT" in der Zeitzone des Mandanten.
  date       String
  closed     Boolean           @default(true)
  opensAt    String?
  closesAt   String?
  note       String?

  @@unique([scheduleId, date])
  @@index([scheduleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Regeln je Raum
// ─────────────────────────────────────────────────────────────────────────────
// Loest `ShellyGroup`/`ShellyAutomation` ab. Unterschiede zum Vorgaenger:
//
//  * Raumbezug: eine Regel haengt an einem Raum (oder gilt betriebsweit) und
//    bekommt dessen Betriebszeit und Kameras geschenkt.
//  * Betriebszeit: als Ausloeser (OPENING/CLOSING mit Offset) und als
//    Bedingung (nur waehrend / nur ausserhalb).
//  * Aktionen statt Szenen: mehrere Aktionen je Regel, und sie schalten ueber
//    `triggerDeviceAction` – damit auch Schloesser und Ventile, nicht nur
//    Shelly. Benachrichtigung und Audio sind eigene Aktionsarten.
//
// Bewusst kein Verzoegerungsfeld an der Aktion: in einer Serverless-Funktion
// laesst sich nicht zuverlaessig warten. Wer "Licht 3 Minuten" will, nutzt
// `timerSeconds` – der Timer laeuft im Geraet.

enum RuleTrigger {
  /// Feste Uhrzeit in der Zeitzone des Mandanten.
  TIME
  /// Betriebsbeginn der zustaendigen Betriebszeit, plus/minus `offsetMinutes`.
  OPENING
  /// Betriebsende, plus/minus `offsetMinutes`.
  CLOSING
  SUNRISE
  SUNSET
  /// Kamera-Ereignis im Raum (Bewegung, Person, Fahrzeug).
  MOTION
  /// Ein Geraet wird geschaltet. Erkennt nur Befehle aus diesem System:
  /// Shelly meldet Zustandswechsel nicht zurueck.
  DEVICE_SWITCHED
  /// Gewaehrter Zutritt an einem Leser.
  SCAN
  /// Seit `idleMinutes` keine Bewegung im Raum gemeldet.
  IDLE
  /// Szene: kein Ausloeser, laeuft nur von Hand (Kachel in der Raumkarte).
  MANUAL
}

/// Bedingung an die Betriebszeit.
enum RuleOperatingCondition {
  /// Betriebszeit spielt keine Rolle.
  ANY
  OPEN
  CLOSED
}

enum RuleActionKind {
  DEVICE
  NOTIFY
  AUDIO
  /// Kamera steuern: Preset anfahren, automatisch folgen an/aus.
  CAMERA
}

enum RuleNotifyChannel {
  TELEGRAM
  PUSH
  BOTH
}

model RoomRule {
  id          Int      @id @default(autoincrement())
  accountId   Int
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// `null` = betriebsweite Regel ohne Raumbezug.
  roomId      Int?
  room        KeyRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  trigger    RuleTrigger
  /// Wochentage als Bitmaske: bit0=Mo … bit6=So. 127 = jeden Tag.
  daysOfWeek Int         @default(127)

  /// "HH:mm" (nur TIME).
  timeOfDay     String?
  /// Verschiebung in Minuten (OPENING, CLOSING, SUNRISE, SUNSET).
  offsetMinutes Int     @default(0)

  /// MOTION: bestimmte Kamera; null = jede Kamera des Raums.
  cameraId  Int?
  camera    Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// MOTION: Ereignisart (PERSON, VEHICLE, MOTION); null = jede.
  eventType String?

  /// DEVICE_SWITCHED: ausloesendes Geraet.
  triggerDeviceId Int?
  triggerDevice   Device? @relation("RoomRuleTriggerDevice", fields: [triggerDeviceId], references: [id], onDelete: Cascade)
  /// DEVICE_SWITCHED: nur bei dieser Aktion; null = jede.
  triggerAction   String?

  /// SCAN: Zutrittsbereich; null = jeder Bereich.
  areaId        Int?
  area          AccessArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// SCAN: "IN", "OUT" oder null fuer beide Richtungen.
  scanDirection String?

  /// IDLE: Minuten ohne Bewegung, bevor die Regel greift.
  idleMinutes Int?

  /// Betriebszeit-Bedingung.
  operating           RuleOperatingCondition @default(ANY)
  /// Welche Betriebszeit gilt; null = die des Raums.
  operatingScheduleId Int?
  operatingSchedule   OperatingSchedule?     @relation(fields: [operatingScheduleId], references: [id], onDelete: SetNull)
  /// Auch zu Bahnmieten und Kursen (Unterprofile) der Betriebszeit?
  operatingExtent     OperatingExtent        @default(SELF)
  /// Zusaetzliches Zeitfenster "HH:mm"–"HH:mm"; Ende vor Beginn = ueber Mitternacht.
  windowStart         String?
  windowEnd           String?
  /// Nur zwischen Sonnenuntergang und -aufgang.
  onlyWhenDark        Boolean                @default(false)

  /// Sperrzeit nach dem Auslösen, verhindert Dauerfeuer bei Bewegung.
  cooldownSeconds Int       @default(60)
  lastRunAt       DateTime?

  actions RoomRuleAction[]
  runs    RoomRuleRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, trigger, isActive])
  @@index([roomId])
  @@index([cameraId])
  @@index([triggerDeviceId])
  @@index([areaId])
  @@index([operatingScheduleId])
}

model RoomRuleAction {
  id        Int            @id @default(autoincrement())
  ruleId    Int
  rule      RoomRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)
  kind      RuleActionKind

  /// DEVICE: Zielgeraet und Aktion ("open", "reset", "close", "stop", …),
  /// wie `DeviceAction` in `src/lib/device-open.ts`.
  deviceId     Int?
  device       Device? @relation("RoomRuleActionDevice", fields: [deviceId], references: [id], onDelete: Cascade)
  deviceAction String?
  /// Sekunden bis zur Selbstabschaltung; der Timer laeuft im Geraet.
  timerSeconds Int?

  /// NOTIFY: Kanal und Text.
  channel RuleNotifyChannel?
  message String?

  /// AUDIO: Zone plus entweder Durchsage oder Playlist.
  audioZoneId         Int?
  audioZone           AudioZone?         @relation(fields: [audioZoneId], references: [id], onDelete: Cascade)
  audioAnnouncementId Int?
  audioAnnouncement   AudioAnnouncement? @relation(fields: [audioAnnouncementId], references: [id], onDelete: SetNull)
  audioPlaylistId     Int?
  audioPlaylist       AudioPlaylist?     @relation(fields: [audioPlaylistId], references: [id], onDelete: SetNull)

  /// CAMERA: Zielkamera (PTZ), Preset-ID der Kamera, automatisch folgen
  /// (true = an, false = aus, null = unveraendert) und optional nach
  /// `returnAfterSeconds` zurueck aufs Preset, Folgen wieder wie vorher.
  targetCameraId     Int?
  targetCamera       Camera?  @relation("RoomRuleActionCamera", fields: [targetCameraId], references: [id], onDelete: Cascade)
  ptzPresetId        Int?
  autoTrack          Boolean?
  returnAfterSeconds Int?

  @@index([ruleId])
  @@index([deviceId])
  @@index([audioZoneId])
  @@index([targetCameraId])
}

/// Verlauf: was hat wann ausgeloest und was ist dabei passiert.
model RoomRuleRun {
  id           Int       @id @default(autoincrement())
  accountId    Int
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Bleibt als Verlauf stehen, wenn die Regel geloescht wird.
  ruleId       Int?
  rule         RoomRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Name der Regel zum Zeitpunkt des Laufs, damit der Verlauf lesbar bleibt.
  ruleName     String
  roomId       Int?
  triggeredAt  DateTime  @default(now())
  triggerKind  String
  success      Boolean
  /// Ergebnis je Aktion als JSON-Liste.
  details      Json?
  durationMs   Int?
  errorMessage String?

  @@index([accountId, triggeredAt])
  @@index([ruleId])
}

/// Klima eines Raums: eine Solltemperatur halten. Ein Fuehler (Shelly, auch
/// BLU ueber die Cloud) misst, eine oder mehrere Heizungen (Shelly-Kanaele)
/// schalten mit Hysterese. Laeuft im 5-Minuten-Takt der Cloud
/// (src/lib/room-climate.ts).
model RoomClimate {
  id                  Int                @id @default(autoincrement())
  accountId           Int
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roomId              Int                @unique
  room                KeyRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  isActive            Boolean            @default(true)
  sensorDeviceId      Int
  sensorDevice        Device             @relation("RoomClimateSensor", fields: [sensorDeviceId], references: [id], onDelete: Cascade)
  /// Shelly-Geraete, die heizen. Ohne Fremdschluessel; beim Speichern geprueft.
  heaterDeviceIds     Int[]
  /// Solltemperatur waehrend der Betriebszeit.
  targetC             Float              @default(21)
  /// Schaltet unter `targetC - hysteresisC` ein und ueber `targetC + hysteresisC` aus.
  hysteresisC         Float              @default(0.5)
  /// Ausserhalb der Betriebszeit diese Temperatur halten; null = Heizung aus.
  setbackC            Float?
  /// So viele Minuten vor Betriebsbeginn schon auf `targetC` heizen.
  preheatMinutes      Int                @default(30)
  /// So viele Minuten nach Betriebsende noch auf `targetC` heizen (Nachlauf).
  afterrunMinutes     Int                @default(0)
  /// Lueftung nach Luftfeuchte: Shelly-Geraete, die lueften. Leer = keine Lueftungsregelung.
  fanDeviceIds        Int[]              @default([])
  /// Lueftung an ab dieser Luftfeuchte (%).
  fanOnHumidity       Float              @default(65)
  /// Lueftung aus unter dieser Luftfeuchte (%).
  fanOffHumidity      Float              @default(58)
  /// So viele Minuten nach Betriebsende laeuft die Lueftung immer (Trocknen).
  fanAfterrunMinutes  Int                @default(45)
  /// Frostschutz: unter dieser Raumtemperatur wird nie gelueftet.
  fanMinTempC         Float              @default(8)
  /// Zuletzt gesendeter Zustand der Lueftung; null = noch nie geschaltet.
  fanOn               Boolean?
  lastHumidity        Float?
  /// Welche Betriebszeit gilt; null = die des Raums. Ohne beide: immer `targetC`.
  operatingScheduleId Int?
  operatingSchedule   OperatingSchedule? @relation(fields: [operatingScheduleId], references: [id], onDelete: SetNull)
  /// Auch zu Bahnmieten und Kursen (Unterprofile) der Betriebszeit heizen?
  operatingExtent     OperatingExtent    @default(SELF)

  /// Laufzustand, vom Takt geschrieben.
  lastTempC      Float?
  lastReadAt     DateTime?
  /// Zuletzt gesendeter Zustand der Heizung; null = noch nie geschaltet.
  heating        Boolean?
  lastSwitchAt   DateTime?
  /// Aktuelles Soll (targetC, setbackC oder null = aus), zur Anzeige.
  currentTargetC Float?
  /// Uebersteuern mit Ablauf: dieses Soll gilt bis `overrideUntil`, danach
  /// wieder der Plan. Der Takt raeumt abgelaufene Werte weg.
  overrideC      Float?
  overrideUntil  DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([sensorDeviceId])
  @@index([operatingScheduleId])
}

/// Aufloesung eines Klima-Messpunkts: 5 Minuten (90 Tage), Stunde (2 Jahre), Tag (unbegrenzt).
enum ClimateResolution {
  MIN5
  HOUR
  DAY
}

/// Verlauf von Temperatur und Luftfeuchte je Fuehler (src/lib/climate-history.ts).
///
/// Der Hub liest die Fuehler im LAN jede Minute und meldet 5-Minuten-Mittel
/// (POST /api/hub/climate-samples); ohne Hub-Meldung schreibt der Klima-Takt
/// der Cloud einen Punkt aus dem Shelly-Cloud-Status. Aeltere Punkte werden im
/// Cron zu Stunden und Tagen verdichtet (Mittel gewichtet nach `count`).
model ClimateSample {
  id          Int               @id @default(autoincrement())
  accountId   Int
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId    Int
  device      Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Raum des Fuehlers zum Zeitpunkt der Messung; null = ohne Raum.
  roomId      Int?
  room        KeyRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  resolution  ClimateResolution
  /// Beginn des Zeitfensters (UTC, auf die Aufloesung gerundet).
  bucketStart DateTime
  tempMin     Float?
  tempAvg     Float?
  tempMax     Float?
  humMin      Float?
  humAvg      Float?
  humMax      Float?
  /// Zahl der Einzelmessungen im Fenster (Gewicht beim Verdichten).
  count       Int               @default(1)
  /// "hub" = im LAN gelesen, "cloud" = aus dem Shelly-Cloud-Status.
  source      String            @default("hub")

  @@unique([deviceId, resolution, bucketStart])
  @@index([accountId, roomId, resolution, bucketStart])
  @@index([accountId, resolution, bucketStart])
}

/// Lufttemperatur am Standort des Betriebs je Stunde, vom Wetterdienst
/// Open-Meteo (src/lib/weather-history.ts). Grundlage fuer "Luft im Schnitt"
/// im Saisonrueckblick der Kunden-App; einen Fuehler fuer draussen gibt es nicht.
model WeatherHour {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Volle Stunde (UTC); `temp` gilt fuer diesen Zeitpunkt.
  hour      DateTime
  /// Lufttemperatur in 2 m Hoehe, Grad Celsius.
  temp      Float

  @@unique([accountId, hour])
}

/// Bewegung, gemeldet von einem Bewegungsmelder (Shelly) in einem Raum. Wird
/// im 5-Minuten-Takt aus dem Shelly-Cloud-Status gelesen und zaehlt im
/// Ereignis-Widget wie ein Personen-Ereignis einer Kamera (src/lib/room-motion.ts).
model RoomMotionEvent {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roomId    Int
  room      KeyRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Zeitpunkt der Bewegung (vom Melder, sonst Zeitpunkt der Abfrage).
  at        DateTime

  @@unique([deviceId, at])
  @@index([accountId, roomId, at])
}

/// Zugang fuer KI-Assistenten (Claude & Co.) ueber die MCP-Schnittstelle
/// /api/mcp. Gespeichert wird nur der SHA-256 des Tokens; der Klartext wird
/// beim Anlegen genau einmal angezeigt.
model McpToken {
  id         Int       @id @default(autoincrement())
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// Letzte Zeichen des Tokens zur Wiedererkennung in der Liste.
  hint       String
  /// "read" = nur lesen, "operate" = zusaetzlich Raumgeraete schalten,
  /// "access" = zusaetzlich Tueren, Tore, Schloesser. Netzwerk nie.
  level      String    @default("read")
  createdBy  String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

/// Gamification je Mandant. Ohne Zeile oder mit enabled=false wird nichts gezaehlt.
/// Was ein Skill der Kunden-App tut.
enum RiderSkillKind {
  /// Ein Geraet einschalten: Taster (Aussendusche) fuer seine eigene Dauer,
  /// Schalter und Licht fuer `minutes`, danach wieder aus.
  DEVICE
  /// Musik-Joker: die Wahl des Fahrers laeuft `minutes` lang in den Zonen
  /// der Playlist-Abstimmung.
  MUSIC
}

/// Skill der Kunden-App: zeitlich begrenztes Recht, vor Ort ein Geraet zu
/// schalten. Wird wie ein Gutschein ueber Awards, Challenges und Feiertage
/// vergeben (`RiderSkillGrant`). Regeln in `lib/rider-skill-rules.ts`.
model RiderSkill {
  id              Int               @id @default(autoincrement())
  /// Name in der App, z. B. "Außendusche".
  name            String
  description     String?
  kind            RiderSkillKind
  /// DEVICE: das Geraet (nur Taster, Schalter, Licht).
  deviceId        Int?
  device          Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// DEVICE Schalter/Licht und MUSIC: so lange laeuft es je Nutzung.
  minutes         Int               @default(5)
  /// Pause nach einer Nutzung, bevor jemand den Skill wieder ausloesen kann.
  cooldownMinutes Int               @default(2)
  /// Nur waehrend der Betriebszeit am Lift.
  onlyOperating   Boolean           @default(true)
  /// Nur, wer heute schon am Lift gestartet ist (vor Ort).
  onlyOnSite      Boolean           @default(true)
  /// Vom Personal gesperrt: in der App sichtbar, aber nicht ausloesbar.
  paused          Boolean           @default(false)
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  accountId       Int
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grants          RiderSkillGrant[]
  uses            RiderSkillUse[]
  milestones      Milestone[]       @relation("MilestoneSkill")
  challenges      Challenge[]       @relation("ChallengeSkill")
  holidays        RiderHoliday[]    @relation("HolidaySkill")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([accountId])
}

/// Gewonnener Skill eines Tickets (wie `Voucher.ownerTicketId`): so viele
/// Nutzungen bis zum Ablauf.
model RiderSkillGrant {
  id         Int             @id @default(autoincrement())
  skillId    Int
  skill      RiderSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  ticketId   Int
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uses       Int
  usedCount  Int             @default(0)
  expiresAt  DateTime?
  /// Herkunft, z. B. "Award Day One (2027)".
  source     String
  /// Vom Personal zurueckgenommen.
  disabledAt DateTime?
  accountId  Int
  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usesLog    RiderSkillUse[]
  createdAt  DateTime        @default(now())

  @@index([accountId])
  @@index([ticketId])
  @@index([skillId])
}

/// Protokoll: wer wann einen Skill ausgeloest hat und ob es geklappt hat.
model RiderSkillUse {
  id        Int              @id @default(autoincrement())
  skillId   Int
  skill     RiderSkill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  grantId   Int?
  grant     RiderSkillGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  profileId Int?
  profile   RiderProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  ok        Boolean
  error     String?
  /// MUSIC: gewaehlte Option ("p<id>"/"s<id>").
  option    String?
  /// Bis hierhin laeuft das Geraet bzw. die Musik.
  until     DateTime?
  /// Hue-Licht: Ausschalten erledigt (der Minuten-Cron schaltet ab).
  offDone   Boolean          @default(false)
  accountId Int
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([skillId, createdAt])
}

model GamificationConfig {
  id                    Int       @id @default(autoincrement())
  enabled               Boolean   @default(false)
  /// Abos, deren Tickets mitzaehlen (IDs aus Subscription).
  subscriptionIds       Int[]     @default([])
  /// Obergrenze: so viele Starts pro Tag zaehlen hoechstens fuer Meilensteine.
  startCapPerDay        Int       @default(10)
  /// Schluessel der oeffentlichen Rangliste `/rangliste/<token>`; NULL = aus.
  displayToken          String?   @unique
  /// Tagestickets (IDs aus Service), deren Gaeste die App nutzen duerfen.
  dayServiceIds         Int[]     @default([])
  /// Preise fuer den Abo-Rechner in Cent: {"<serviceId>": 2500}.
  servicePrices         Json?
  /// Abo-Preise fuer den Abo-Rechner in Cent: {"<subscriptionId>": 39000}.
  subscriptionPrices    Json?
  /// Einladung zur App, wenn ueber anny ein neues Abo gebucht wird (lib/rider-invite).
  inviteNewAbos         Boolean   @default(true)
  /// Einladung an laufende Abos, die noch nicht in der App sind (in Etappen ueber tick-5min).
  inviteExistingAbos    Boolean   @default(false)
  /// Auslastung am Lift (Fahrer der letzten 60 Min): ab hier „Gut besucht“.
  /// Gilt fuer Kunden-App und Verwaltung gleich (lib/rider-occupancy).
  occupancyMediumFrom   Int       @default(10)
  /// Ab hier „Viel los“. Bewusst hoch, damit es selten erscheint.
  occupancyHighFrom     Int       @default(25)
  /// Strandbad: geschaetzte Gaeste vor Ort = Eintritte der letzten 3 h am
  /// Eingangs-Drehkreuz × Faktor (Tageskasse geht nicht uebers Drehkreuz;
  /// Aaron 21.11.2026: Top-Tage 3000 Gaeste, 2/3 Tageskasse → 3).
  beachGuestFactor      Float     @default(3)
  /// Ab so vielen geschaetzten Gaesten „Gut besucht“ (20 % von 3000).
  beachMediumFrom       Int       @default(600)
  /// Ab so vielen geschaetzten Gaesten „Viel los“ (40 % von 3000).
  beachHighFrom         Int       @default(1200)
  /// Fuehler fuer die Wassertemperatur (Device, z. B. Shelly): Grundlage fuer
  /// Awards mit `COLD_DAYS`. Messwerte stehen in `ClimateSample`.
  waterSensorDeviceId   Int?
  waterSensorDevice     Device?   @relation("GamificationWaterSensor", fields: [waterSensorDeviceId], references: [id], onDelete: SetNull)
  /// Playlist-Abstimmung: aktive Fahrer waehlen in der Kunden-App, die
  /// Playlist mit den meisten Stimmen laeuft in den gewaehlten Zonen
  /// (lib/music-vote). Ab Werk aus.
  musicVoteEnabled      Boolean   @default(false)
  /// Zonen, in denen die Mehrheit spielt (AudioZone-IDs).
  musicVoteZoneIds      Int[]     @default([])
  /// Auswahl, zwischen der die Fahrer waehlen, in App-Reihenfolge:
  /// "p<id>" = AudioPlaylist, "s<id>" = AudioStream (Webradio).
  musicVoteOptions      String[]  @default([])
  /// So lange nach einer Wahl des Personals ruht die Abstimmung (0 = gar nicht).
  musicVoteHoldMinutes  Int       @default(60)
  /// Abstimmungsrunde in Minuten: gewechselt wird nur am Rundenende (volle
  /// Viertelstunde bei 15), die App zeigt den Countdown. 0 = sofort.
  musicVoteRoundMinutes Int       @default(15)
  /// Ende der zuletzt ausgewerteten Runde (Cron-Guard).
  musicVoteRoundAt      DateTime?
  /// Beach Pass: dieselbe Kunden-App fuer Strandbad-Kunden (lib/rider-pass).
  /// Ab Werk aus. Gezaehlt wird ein Besuchstag je Tag mit Eintritt am
  /// Strandbad-Eingang, nicht am Lift.
  beachEnabled          Boolean   @default(false)
  /// Abos, deren Tickets den Beach Pass bekommen (z. B. „Beach Abo“). Ein Abo
  /// aus `subscriptionIds` geht vor: wer am Lift faehrt, behaelt den Ride Pass.
  beachSubscriptionIds  Int[]     @default([])
  accountId             Int       @unique
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Tagessumme je Abo-Ticket: ein Besuchstag mit seinen Starts. Bewusst keine
/// Einzelzeiten – die Scans selbst unterliegen den Loeschfristen.
model RiderDayStat {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Kalendertag in Europe/Berlin.
  day          DateTime @db.Date
  starts       Int      @default(0)
  firstStartAt DateTime
  lastStartAt  DateTime
  accountId    Int
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([ticketId, day])
  @@index([accountId, day])
}

/// Stimme einer Person fuer eine Playlist oder ein Webradio, je Kalendertag (Europe/Berlin)
/// hoechstens eine. Sie zaehlt nur, solange die Person aktiv ist (zuletzt
/// am Lift gestartet vor hoechstens 2 Stunden, lib/music-vote-rules).
model RiderMusicVote {
  id        Int          @id @default(autoincrement())
  profileId Int
  profile   RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day       DateTime     @db.Date
  /// Gewaehlte Option: "p<id>" Playlist oder "s<id>" Webradio.
  option    String
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([profileId, day])
  @@index([accountId, day])
}

/// Zielgruppe in der Kunden-App: Ride Pass (Lift-Abos), Beach Pass
/// (Strandbad-Kunden) oder beide.
enum PassAudience {
  RIDE
  BEACH
  ALL
}

/// Meilenstein (Award), im Admin einstellbar. Optional mit Leistungs-Gutschein.
model Milestone {
  id               Int              @id @default(autoincrement())
  name             String
  metric           GamiMetric
  threshold        Int
  period           GamiPeriod       @default(SEASON)
  /// Leistung auf dem Gutschein; NULL = Meilenstein ohne Gutschein.
  voucherLabel     String?
  /// Gueltigkeit des Gutscheins in Tagen; NULL = unbegrenzt.
  voucherValidDays Int?
  /// Kurzform des Gutscheins fuer die Award-Kachel der Kunden-App ("Bring a Friend").
  voucherShort     String?
  /// Zugabe ohne Gutschein, z. B. "Hall-of-Fame-Wand".
  bonus            String?
  /// Fuer welchen Pass der Award gilt (Ride Pass, Beach Pass oder beide).
  audience         PassAudience     @default(RIDE)
  /// Seltenheit: bestimmt das Metall des Abzeichens in der Kunden-App.
  tier             GamiTier         @default(BRONZE)
  /// Beschreibung in der Kunden-App; NULL = aus Bedingung erzeugt.
  hint             String?
  /// Aktionstage (Europe/Berlin) fuer `EVENT_DAYS`; bei `OPENING_DAY` der von
  /// Hand festgelegte Opening-Tag eines Jahres (sonst automatisch).
  eventDays        DateTime[]       @default([]) @db.Date
  /// Grenze in Grad Celsius fuer `COLD_DAYS`: der Tag zaehlt, wenn das Wasser
  /// waehrend der Starts kaelter war.
  tempBelow        Float?
  /// Schluessel der Vorlage ("first-splash"); NULL = selbst angelegt.
  key              String?
  /// Skill als Belohnung (Kunden-App): Recht, ein Geraet zu schalten.
  skillId          Int?
  skill            RiderSkill?      @relation("MilestoneSkill", fields: [skillId], references: [id], onDelete: SetNull)
  /// So oft darf der Skill genutzt werden.
  skillUses        Int              @default(1)
  /// Gueltigkeit in Tagen; NULL = unbegrenzt.
  skillValidDays   Int?
  active           Boolean          @default(true)
  sortOrder        Int              @default(0)
  accountId        Int
  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  awards           MilestoneAward[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([accountId, key])
  @@index([accountId])
}

/// Erreichter Meilenstein eines Tickets in einem Zeitraum ("2027", "2027-06" oder "all").
model MilestoneAward {
  id          Int       @id @default(autoincrement())
  milestoneId Int
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  periodKey   String
  voucherId   Int?
  voucher     Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  awardedAt   DateTime  @default(now())
  /// Freischalt-Moment in der Kunden-App gezeigt; NULL = steht noch aus.
  seenAt      DateTime?

  @@unique([milestoneId, ticketId, periodKey])
  @@index([accountId])
  @@index([ticketId])
  @@index([voucherId])
}

enum ChallengeKind {
  /// Aufgabe erfuellt: jeder, der die Schwelle im Zeitraum erreicht, gewinnt.
  TASK
  /// Top X: nach dem Ende gewinnen die Besten.
  TOP_X
  /// Foto-Challenge: jeder laedt ein Foto hoch, die Fahrer stimmen ab, die
  /// Fotos mit den meisten Stimmen gewinnen nach dem Ende (`topCount`).
  PHOTO
  /// Abstimmung: Frage (Name) mit Antworten (`ChallengeOption`), eine Stimme
  /// je Person. Ohne Gewinn.
  POLL
}

/// Challenge mit festem Zeitraum. TASK vergibt sofort beim Erreichen der
/// Schwelle, TOP_X nach dem Ende an die besten `topCount` Fahrer.
model Challenge {
  id               Int              @id @default(autoincrement())
  name             String
  description      String?
  kind             ChallengeKind
  metric           GamiMetric
  /// TASK: Schwelle, die erreicht werden muss.
  threshold        Int?
  /// TOP_X: Anzahl der Gewinner.
  topCount         Int?
  startDate        DateTime         @db.Date
  endDate          DateTime         @db.Date
  /// Uhrzeit am Endtag ("HH:MM", Europe/Berlin), zu der die Challenge endet;
  /// NULL = mit dem Endtag (Mitternacht).
  endTime          String?
  voucherLabel     String?
  voucherValidDays Int?
  /// Skill als Belohnung (Kunden-App): Recht, ein Geraet zu schalten.
  skillId          Int?
  skill            RiderSkill?      @relation("ChallengeSkill", fields: [skillId], references: [id], onDelete: SetNull)
  /// So oft darf der Skill genutzt werden.
  skillUses        Int              @default(1)
  /// Gueltigkeit in Tagen; NULL = unbegrenzt.
  skillValidDays   Int?
  active           Boolean          @default(true)
  /// TOP_X: Zeitpunkt der Auswertung; NULL = noch nicht ausgewertet.
  settledAt        DateTime?
  /// Fuer welchen Pass die Challenge gilt (Ride Pass, Beach Pass oder beide).
  audience         PassAudience     @default(RIDE)
  /// Push an die Kunden-App gewünscht (Schalter beim Anlegen). Gesendet wird
  /// einmal, sobald die Challenge aktiv ist (siehe `rider-announce.ts`).
  pushPlanned      Boolean          @default(false)
  pushedAt         DateTime?
  /// Erreichte Geräte beim Versand.
  pushSent         Int?
  accountId        Int
  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  awards           ChallengeAward[]
  options          ChallengeOption[]
  entries          ChallengeEntry[]
  votes            ChallengeVote[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([accountId])
}

/// Gewinn einer Challenge. `rank` ist nur bei TOP_X gesetzt.
model ChallengeAward {
  id          Int       @id @default(autoincrement())
  challengeId Int
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rank        Int?
  voucherId   Int?
  voucher     Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  awardedAt   DateTime  @default(now())

  @@unique([challengeId, ticketId])
  @@index([accountId])
  @@index([ticketId])
  @@index([voucherId])
}

/// Antwort einer Abstimmung (Challenge-Art POLL).
model ChallengeOption {
  id          Int             @id @default(autoincrement())
  challengeId Int
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int             @default(0)
  votes       ChallengeVote[]
  accountId   Int
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([accountId])
}

/// Foto einer Person zu einer Foto-Challenge (eines je Person). Das Bild liegt
/// im Blob-Speicher (`imageBlob`), ohne Blob-Token als Bytes in `image`.
model ChallengeEntry {
  id          Int             @id @default(autoincrement())
  challengeId Int
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profileId   Int
  profile     RiderProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  imageBlob   String?
  image       Bytes?
  /// Vorschaubild (ca. 480 px) fuer das Raster der App; fehlt bei aelteren Fotos.
  thumbBlob   String?
  thumb       Bytes?
  /// Vom Personal ausgeblendet: fuer andere unsichtbar, zaehlt nicht.
  hidden      Boolean         @default(false)
  votes       ChallengeVote[]
  accountId   Int
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([challengeId, profileId])
  @@index([accountId])
  @@index([profileId])
}

/// Stimme einer Person: fuer ein Foto (PHOTO) oder eine Antwort (POLL).
/// Eine Stimme je Person und Challenge; bis zum Ende aenderbar.
model ChallengeVote {
  id          Int              @id @default(autoincrement())
  challengeId Int
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profileId   Int
  profile     RiderProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entryId     Int?
  entry       ChallengeEntry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  optionId    Int?
  option      ChallengeOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  accountId   Int
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([challengeId, profileId])
  @@index([accountId])
  @@index([entryId])
  @@index([optionId])
  @@index([profileId])
}

/// Angebot auf dem Dashboard der Kunden-App.
/// Art eines Eintrags in `RiderOffer`: Angebot oder News (Mitteilung wie
/// geänderte Öffnungszeiten). Beide teilen Zeitraum, Zielgruppe und Push,
/// erscheinen in Verwaltung und App aber getrennt.
enum RiderOfferKind {
  OFFER
  NEWS
}

model RiderOffer {
  id          Int       @id @default(autoincrement())
  kind        RiderOfferKind @default(OFFER)
  title       String
  text        String?
  /// Sichtbar ab/bis (Kalendertag, einschliesslich); NULL = offen.
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  /// Fuer welchen Pass das Angebot gilt (Ride Pass, Beach Pass oder beide).
  audience    PassAudience @default(RIDE)
  /// Push an die Kunden-App gewünscht; gesendet wird einmal, sobald das
  /// Angebot sichtbar ist (siehe `rider-announce.ts`).
  pushPlanned Boolean   @default(false)
  pushedAt    DateTime?
  /// Erreichte Geräte beim Versand.
  pushSent    Int?
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([accountId])
}

/// Was die Kunden-App an einem Feiertag zeigt.
enum HolidayShow {
  /// Nur ein Gruss (Ueberschrift und Text).
  GREETING
  /// Angebot wie `RiderOffer`, nur rund um den Feiertag sichtbar.
  OFFER
  /// Gruss plus Leistungs-Gutschein, einmal je Person und Jahr.
  VOUCHER
}

/// Feiertag in der Kunden-App, je Mandant und Feiertag einmal eingestellt und
/// jedes Jahr wieder gueltig. `key` ist der Schluessel aus `lib/holidays.ts`
/// (z. B. "ostermontag"); das Datum rechnet die App jedes Jahr selbst aus.
model RiderHoliday {
  id               Int                @id @default(autoincrement())
  key              String
  show             HolidayShow        @default(GREETING)
  /// Ueberschrift; NULL = Standardgruss des Feiertags.
  title            String?
  text             String?
  /// VOUCHER: Leistung auf dem Gutschein.
  voucherLabel     String?
  /// VOUCHER: Gueltigkeit in Tagen; NULL = unbegrenzt.
  voucherValidDays Int?
  /// Schon so viele Tage vor dem Feiertag zeigen (0 = nur am Tag selbst).
  daysBefore       Int                @default(0)
  /// Skill als Belohnung (Kunden-App): Recht, ein Geraet zu schalten.
  skillId          Int?
  skill            RiderSkill?        @relation("HolidaySkill", fields: [skillId], references: [id], onDelete: SetNull)
  /// So oft darf der Skill genutzt werden.
  skillUses        Int                @default(1)
  /// Gueltigkeit in Tagen; NULL = unbegrenzt.
  skillValidDays   Int?
  active           Boolean            @default(true)
  /// Push an die Kunden-App: jedes Jahr einmal, sobald der Feiertag in der
  /// App erscheint (ab 9 Uhr, siehe `rider-announce.ts`).
  pushPlanned      Boolean            @default(false)
  /// Jahr des Feiertags, fuer das der Push zuletzt ging.
  pushedYear       Int?
  pushedAt         DateTime?
  /// Erreichte Geraete beim letzten Versand.
  pushSent         Int?
  gifts            RiderHolidayGift[]
  accountId        Int
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([accountId, key])
  @@index([accountId])
}

/// Feiertags-Gutschein, der an eine Person ging: einmal je Feiertag und Jahr.
model RiderHolidayGift {
  id        Int          @id @default(autoincrement())
  holidayId Int
  holiday   RiderHoliday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  year      Int
  profileId Int
  profile   RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  voucherId Int?
  voucher   Voucher?     @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([holidayId, year, profileId])
  @@index([accountId])
  @@index([profileId])
  @@index([voucherId])
}

/// Geburtstag in der Kunden-App, eine Einstellung je Mandant: Gruß und
/// Geschenk in der App (Kunden App › Aktionen), Push am Morgen und die
/// Durchsage beim Scan am Start-Drehkreuz (Audio › Zeitpläne).
model RiderBirthday {
  id               Int      @id @default(autoincrement())
  accountId        Int      @unique
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Gruß in der App am Geburtstag.
  active           Boolean  @default(false)
  /// Ueberschrift; NULL = „Alles Gute zum Geburtstag“.
  title            String?
  text             String?
  /// Geschenk: Leistung auf dem Gutschein; NULL = nur der Gruß.
  voucherLabel     String?
  /// Gueltigkeit des Geschenks in Tagen; NULL = unbegrenzt.
  voucherValidDays Int?
  /// Push an die Geraete der Person am Geburtstag (9–21 Uhr, einmal).
  pushPlanned      Boolean  @default(false)
  /// Durchsage, wenn das Geburtstagskind am Start-Drehkreuz scannt (einmal am Tag).
  announceActive   Boolean  @default(false)
  /// Ansagetext; `{vorname}` wird ersetzt. NULL = Standardtext.
  announceText     String?
  /// Vorname in der Durchsage nennen (sonst ohne Namen).
  announceName     Boolean  @default(true)
  /// Zielzonen als AudioZone-ID-Array (leer = keine Durchsage).
  announceZoneIds  Json     @default("[]")
  announceVoice    String?
  announceChime    Boolean  @default(true)
  /// Musik unter der Durchsage (Mediathek-Titel); NULL = ohne Musik.
  announceMusicTrackId Int?
  announceMusicTrack   AudioTrack? @relation(fields: [announceMusicTrackId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Geburtstag einer Person in einem Jahr: Geschenk, Push und Durchsage je einmal.
model RiderBirthdayGift {
  id          Int          @id @default(autoincrement())
  year        Int
  profileId   Int
  profile     RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Geschenk beansprucht (vor dem Anlegen des Gutscheins, gegen doppelte Vergabe).
  giftAt      DateTime?
  voucherId   Int?
  voucher     Voucher?     @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  pushedAt    DateTime?
  pushSent    Int?
  announcedAt DateTime?
  accountId   Int
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([profileId, year])
  @@index([accountId])
  @@index([voucherId])
}

/// Kunden-App (Gamification): ein Profil je Person. Der Token im Link
/// `/app/<token>` ist die Berechtigung, wie bei der Mitarbeiter-App `/m/<token>`.
model RiderProfile {
  id                Int                     @id @default(autoincrement())
  /// Tag und Zahl der KI-Fotopruefungen (Tagesgrenze, lib/profile-photo-check).
  photoCheckDay     DateTime?               @db.Date
  photoChecks       Int                     @default(0)
  token             String                  @unique
  /// Fuer andere sichtbar (Rangliste), nie der echte Name.
  nickname          String?
  /// Einwilligung: mit Spitznamen in Ranglisten erscheinen.
  showInRanking     Boolean                 @default(false)
  lastSeenAt        DateTime?
  /// Bestätigte E-Mail-Adresse (Anmeldung per Mail-Link, klein geschrieben).
  /// Ein Profil mit Adresse gilt auch ohne Ticket (Kunde noch ohne Abo).
  email             String?
  /// bcrypt-Hash; NULL = kein Passwort gesetzt.
  passwordHash      String?
  /// Wird beim Zuruecksetzen erhoeht: alle bisherigen Sitzungen enden.
  sessionVersion    Int                     @default(0)
  loginFailures     Int                     @default(0)
  loginLockedUntil  DateTime?
  passkeys          RiderPasskey[]
  pushSubscriptions RiderPushSubscription[]
  musicVotes        RiderMusicVote[]
  skillUses         RiderSkillUse[]
  /// Familie: Erwachsene (eigener Login) sehen alle Mitglieder, Kinder haben
  /// keinen eigenen Zugang und werden von den Erwachsenen mitverwaltet.
  familyId          Int?
  family            RiderFamily?            @relation(fields: [familyId], references: [id], onDelete: SetNull)
  familyAdult       Boolean                 @default(false)
  /// Person eines Kundenkontos: wer mit den Abos faehrt. Name und
  /// Geburtsdatum gehoeren der Person; der anny-Sync ueberschreibt nur die
  /// Rohdaten am Ticket (dort steht bei Familienkonten der Kontoinhaber).
  customerId        Int?
  customer          Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName         String?
  lastName          String?
  birthDate         DateTime?
  /// Jahr der ersten Saison am Lift (traegt das Personal ein). Fuer die
  /// Treue-Awards: Saisons vor der ersten gezaehlten zaehlen so mit.
  ridingSince       Int?
  /// Profilbild, das die Person in der App selbst waehlt (Data-URL, auf
  /// 320 px verkleinert). Nur fuer die App; das Foto zum Abgleich an der
  /// Kasse bleibt `Ticket.profileImage`.
  photo             String?                 @db.Text
  accountId         Int
  account           Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tickets           Ticket[]
  holidayGifts      RiderHolidayGift[]
  challengeEntries  ChallengeEntry[]
  challengeVotes    ChallengeVote[]
  birthdayGifts     RiderBirthdayGift[]
  /// Geburtstags-Durchsage am Lift: die Person kann sie in der App abschalten.
  birthdayAnnounce  Boolean                 @default(true)
  chips             Chip[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([accountId])
  @@index([familyId])
  @@index([accountId, email])
  @@index([customerId])
}

/// Kundenkonto: eine E-Mail-Adresse je Mandant (Aaron, 20.11.2026: Abos
/// immer ueber die E-Mail). Jedes Abo mit Adresse gehoert einem Konto; wer
/// damit faehrt, sagt die Person (`RiderProfile`, `Ticket.riderProfileId`).
/// anny fuehrt ebenfalls ein Konto je Adresse; seine Kundennummern stehen
/// hier, damit das Konto einer Adressaenderung in anny folgt.
model Customer {
  id              Int            @id @default(autoincrement())
  /// Klein geschrieben, ohne Leerraum; eindeutig je Mandant.
  email           String
  /// Name des Kontoinhabers (aus anny bzw. vom ersten Abo).
  name            String?
  annyCustomerIds String[]       @default([])
  /// Weitere Adressen nach dem Zusammenlegen zweier Konten. Abos mit einer
  /// dieser Adressen landen in diesem Konto (lib/customers).
  aliasEmails     String[]       @default([])
  tickets         Ticket[]
  persons         RiderProfile[]
  accountId       Int
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([accountId, email])
  @@index([accountId])
}

/// Wem ein Bändchen (RFID-Chip) gehört.
enum ChipOwner {
  /// Bringt der Kunde selbst mit oder hat es gekauft: bleibt bei ihm, wird nie
  /// automatisch frei.
  KUNDE
  /// Leihbändchen des Betriebs: wird frei, sobald kein Ticket damit mehr gilt.
  BETRIEB
  /// Mitarbeiter-Chip (emp-control): bleibt am Mitarbeiter-Ticket.
  MITARBEITER
}

/// Bändchen (RFID-Chip) am Kunden statt am einzelnen Ticket (lib/chips.ts).
/// `Ticket.rfidCode` bleibt der Code, den die Scanner lesen; jedes Ticket der
/// Person bekommt ihn mit. Der Chip sagt, wem das Bändchen gehört und mit wem
/// es fährt, damit Historie, Starts und Awards an der Person bleiben.
model Chip {
  id             Int           @id @default(autoincrement())
  /// So, wie der Scanner ihn liefert (getrimmt).
  code           String
  owner          ChipOwner     @default(KUNDE)
  /// Person, mit der das Bändchen fährt. NULL = hängt nur an Tickets.
  riderProfileId Int?
  riderProfile   RiderProfile? @relation(fields: [riderProfileId], references: [id], onDelete: SetNull)
  /// Verloren oder kaputt: bleibt zur Nachvollziehbarkeit, gilt nicht mehr.
  blockedAt      DateTime?
  note           String?
  events         ChipEvent[]
  accountId      Int
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([accountId, code])
  @@index([accountId])
  @@index([riderProfileId])
}

/// Verlauf eines Bändchens: angelegt, einer Person gegeben, Eigentum geändert,
/// übergeben, gesperrt. Nur anhängen, nie ändern.
model ChipEvent {
  id             Int      @id @default(autoincrement())
  chipId         Int
  chip           Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)
  /// ANGELEGT | PERSON | EIGENTUM | AUSGEGEBEN | GESPERRT | UEBERNOMMEN | RUECKGAENGIG
  kind           String
  riderProfileId Int?
  ticketId       Int?
  /// Wo es passiert ist: KASSE, BACKEND, ABGLEICH, ALTBESTAND.
  source         String?
  note           String?
  accountId      Int
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([chipId])
  @@index([accountId])
}

/// Familie in der Kunden-App: buendelt Profile, gezaehlt wird weiter je Person.
model RiderFamily {
  id        Int            @id @default(autoincrement())
  members   RiderProfile[]
  accountId Int
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([accountId])
}

/// Passkey (WebAuthn) eines Fahrers fuer die Kunden-App.
model RiderPasskey {
  id           Int          @id @default(autoincrement())
  profileId    Int
  profile      RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Credential-ID, base64url.
  credentialId String       @unique
  publicKey    Bytes
  counter      Int          @default(0)
  transports   String[]     @default([])
  deviceType   String
  backedUp     Boolean      @default(false)
  name         String
  lastUsedAt   DateTime?
  accountId    Int
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([profileId])
  @@index([accountId])
}

/// Web-Push-Abo eines Fahrers (Kunden-App). Bewusst getrennt von
/// PushSubscription: dort landen die Betriebsmeldungen fuer Mitarbeiter.
model RiderPushSubscription {
  id        Int          @id @default(autoincrement())
  endpoint  String       @unique
  p256dh    String
  auth      String
  profileId Int
  profile   RiderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([profileId])
  @@index([accountId])
}

// ─── Warenwirtschaft ────────────────────────────────────────────────────────

/// Artikel der Warenwirtschaft (Getränke, Speisen, Shop-Ware). `stock` ist der
/// aktuelle Bestand; eine abgeschlossene Inventur schreibt ihn auf den
/// gezählten Wert. Preise in Cent (netto, Einkauf).
model Article {
  id                 Int             @id @default(autoincrement())
  accountId          Int
  account            Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  sku                String?
  category           String          @default("Sonstiges")
  unit               String?
  supplier           String?
  purchasePriceCents Int?
  stock              Float           @default(0)
  /// Data-URL (eigenes Foto) oder https-Adresse (Open Food Facts).
  image              String?         @db.Text
  /// Bildnachweis, z. B. „Open Food Facts, CC BY-SA 3.0“.
  imageSource        String?
  /// Bildsuche ohne passenden Treffer: nicht bei jedem Lauf erneut fragen.
  imageSearchedAt    DateTime?
  active             Boolean         @default(true)
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  stocktakeLines     StocktakeLine[]

  @@index([accountId, category])
  @@index([accountId, active])
}

enum StocktakeKind {
  /// Laufende Inventur: Teilzählung jederzeit, z. B. ein Lager oder eine Kategorie.
  ROLLING
  /// Stichtagsinventur: alle Artikel zu einem Datum, wird festgeschrieben.
  CUTOFF
}

enum StocktakeStatus {
  OPEN
  CLOSED
}

/// Eine Inventur (Zählung). Zeilen halten eine Momentaufnahme der Artikel-
/// daten, damit eine festgeschriebene Inventur später gleich bleibt, auch
/// wenn sich Preis oder Name des Artikels ändern.
model Stocktake {
  id                  Int                  @id @default(autoincrement())
  accountId           Int
  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind                StocktakeKind
  status              StocktakeStatus      @default(OPEN)
  title               String
  /// Stichtag bzw. Zähltag (Datum, 00:00 UTC).
  date                DateTime
  note                String?
  closedAt            DateTime?
  closedBy            String?
  /// Geheimnis des Zähl-Links `/zaehlen/<token>` fürs Handy (ohne Login).
  /// null = kein Link oder gesperrt. Gilt nur, solange die Inventur offen ist.
  countToken          String?              @unique
  countTokenExpiresAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lines               StocktakeLine[]
  signatures          StocktakeSignature[]
  events              StocktakeEvent[]

  @@index([accountId, kind, date])
}

/// Rolle bei der Inventur: wer zählt und wer aufschreibt (Vier-Augen-Prinzip).
enum StocktakeRole {
  COUNTER
  WRITER
}

/// Digitale Bestätigung einer Inventur durch Zähler bzw. Schreiber, mit dem
/// eigenen Login und Passkey (ersatzweise Passwort) – statt Unterschrift auf
/// Papier. `contentHash` ist die Prüfsumme der Zählliste beim Bestätigen;
/// ändert sich danach eine Menge, wird die Bestätigung gelöscht und muss neu
/// erfolgen. Festschreiben geht nur mit beiden Bestätigungen.
model StocktakeSignature {
  id          Int           @id @default(autoincrement())
  accountId   Int
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stocktakeId Int
  stocktake   Stocktake     @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  role        StocktakeRole
  adminId     Int?
  admin       Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Name und E-Mail zum Zeitpunkt der Bestätigung (bleiben, auch wenn der Login gelöscht wird).
  name        String
  email       String?
  /// "passkey" oder "password"
  method      String
  contentHash String
  signedAt    DateTime      @default(now())

  @@unique([stocktakeId, role])
  @@index([accountId])
}

/// Protokoll einer Inventur (GoBD): jede Eingabe, Bestätigung, das
/// Festschreiben und jede spätere Korrektur mit Person, Zeit, altem und
/// neuem Wert. Wird nur angehängt, nie geändert oder gelöscht.
model StocktakeEvent {
  id          Int       @id @default(autoincrement())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stocktakeId Int
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  /// CREATED, COUNT, LINE_ADDED, SIGNED, SIGNATURE_VOID, CLOSED, CORRECTION
  type        String
  /// Zeile der Inventur (kein Fremdschlüssel, damit der Eintrag bleibt).
  lineId      Int?
  lineName    String?
  /// counted, broken oder purchasePriceCents
  field       String?
  oldValue    Float?
  newValue    Float?
  /// Wer: Name des Logins bzw. beim Zähl-Link der eingegebene Name.
  actor       String
  adminId     Int?
  /// "app", "link" (Zähl-Link am Handy) oder "system"
  via         String    @default("app")
  /// Begründung (Pflicht bei Korrekturen) oder Hinweis.
  note        String?
  createdAt   DateTime  @default(now())

  @@index([stocktakeId, createdAt])
  @@index([accountId])
}

model StocktakeLine {
  id                 Int       @id @default(autoincrement())
  accountId          Int
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stocktakeId        Int
  stocktake          Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  articleId          Int?
  article            Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  name               String
  sku                String?
  category           String
  unit               String?
  purchasePriceCents Int?
  /// Bestand laut System beim Anlegen der Inventur.
  expected           Float     @default(0)
  /// Gezählter Bestand; null = noch nicht gezählt.
  counted            Float?
  /// Bruch / Schwund, wird zusätzlich bewertet.
  broken             Float?
  /// Wer zuletzt über den Zähl-Link gezählt hat (Name, den die Person eingibt).
  countedBy          String?
  updatedAt          DateTime  @updatedAt

  @@unique([stocktakeId, articleId])
  @@index([accountId])
}

/// Inventarverzeichnis (Anlagen, Geräte, Ausstattung), gegliedert wie die
/// Excel-Vorlage in Blätter (`group`, z. B. Gastronomie, Wasserski) und
/// Bereiche (`location`). Mengen je Inventurjahr in InventoryAssetCount.
model InventoryAsset {
  id             Int                   @id @default(autoincrement())
  accountId      Int
  account        Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  group          String
  location       String?
  deviceNumber   String?
  lastInspection DateTime?
  note           String?
  /// Foto als verkleinerte Data-URL (z. B. am Handy beim Zählen aufgenommen).
  image          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  counts         InventoryAssetCount[]

  @@index([accountId, group])
}

model InventoryAssetCount {
  id        Int            @id @default(autoincrement())
  accountId Int
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId   Int
  asset     InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  year      Int
  quantity  Float
  /// Wer über den Zähl-Link gezählt hat (Name, den die Person eingibt).
  countedBy String?
  updatedAt DateTime       @updatedAt

  @@unique([assetId, year])
  @@index([accountId, year])
}

/// Zähl-Link fürs Handy je Inventar-Blatt (`/zaehlen/inventar/<token>`):
/// Mitarbeiter zählen ohne Login die Mengen eines Jahres. Ein Link je Blatt.
model InventoryCountLink {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group     String
  year      Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, group])
}

// ─── Veranstaltungen (Rooftop Lounge) ──────────────────────────────────────

/// Externer Veranstaltungspartner (z. B. Caterer), der ueber einen geheimen
/// Link `/partner/<portalToken>` eigene Termine in seinen Raeumen eintraegt,
/// Personenzahl meldet und Zusatzleistungen waehlt. Er sieht nur eigene
/// Termine und Dokumente; fremde Termine nur als „belegt“.
model EventPartner {
  id            Int          @id @default(autoincrement())
  accountId     Int
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  /// Ansprechpartner beim Partner (Freitext, fuer uns).
  contactName   String?
  /// Logo des Partners (https-Bild-URL) fuer den Kopf seines Zugangs.
  logoUrl       String?
  /// Mails an den Partner (neues Dokument, Bestaetigung, Absage).
  contactEmail  String?
  /// Mails an uns (Termin eingetragen, geaendert, abgesagt). Push geht immer.
  notifyEmail   String?
  portalToken   String?      @unique
  portalEnabled Boolean      @default(false)
  /// Raeume (AccessArea.id mit eventVenue), in denen der Partner buchen darf.
  areaIds       Int[]        @default([])
  /// Bis so viele Stunden vor Beginn darf der Partner selbst aendern und
  /// absagen; danach nur noch wir. Die tatsaechliche Personenzahl darf er
  /// bis zur Schlussrechnung melden.
  editLockHours Int          @default(48)
  /// So viele Tage im Voraus darf der Partner eintragen.
  horizonDays   Int          @default(365)
  events        VenueEvent[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

enum VenueExtraUnit {
  /// Einmal je Veranstaltung.
  FLAT
  /// Je Gast (tatsaechliche Personenzahl, sonst geplante).
  PER_PERSON
  /// Stueckzahl waehlt der Partner.
  PER_PIECE
}

/// Zusatzleistung, die ein Partner zu einer Veranstaltung anklicken kann und
/// die wir weiterberechnen (z. B. Technik, Reinigung, Security).
model VenueExtra {
  id          Int               @id @default(autoincrement())
  accountId   Int
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  areaId      Int
  area        AccessArea        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Netto-Preis je Einheit in Cent.
  priceCents  Int               @default(0)
  unit        VenueExtraUnit    @default(FLAT)
  /// Aus = fuer neue Auswahl nicht mehr sichtbar, gebuchte bleiben.
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  bookings    VenueEventExtra[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([accountId, areaId])
}

enum VenueEventStatus {
  /// Vom Partner (oder uns) eingetragen, Raum ist geblockt.
  RESERVED
  /// Von uns bestaetigt (spaetestens mit der Auftragsbestaetigung).
  CONFIRMED
  CANCELED
}

/// Belegung eines Veranstaltungsraums. Zwei nicht abgesagte Termine im
/// selben Raum duerfen sich samt Puffer nicht ueberschneiden.
model VenueEvent {
  id            Int                  @id @default(autoincrement())
  accountId     Int
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  areaId        Int
  area          AccessArea           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  /// NULL = eigener Termin bzw. Sperre von uns.
  partnerId     Int?
  partner       EventPartner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  title         String
  /// Veranstalter/Kunde des Partners (z. B. Firma), nur so viel wie noetig.
  hostName      String?
  /// Tag in Berlin-Zeit (YYYY-MM-DD) und Zeiten HH:mm. Ende vor Beginn =
  /// endet am Folgetag.
  date          String
  startTime     String
  endTime       String
  startDate     DateTime
  endDate       DateTime
  /// Geplante Personenzahl.
  guestCount    Int
  /// Tatsaechliche Personenzahl, vom Partner nach der Veranstaltung gemeldet.
  actualGuests  Int?
  status        VenueEventStatus     @default(RESERVED)
  /// Fuer Partner und uns sichtbar.
  note          String?
  /// Nur fuer uns.
  internalNote  String?
  /// "PARTNER" oder "ADMIN" plus Name der Person.
  createdBy     String               @default("ADMIN")
  createdByName String?
  canceledAt    DateTime?
  canceledBy    String?
  confirmedAt   DateTime?
  /// Abgerechnet (Schlussrechnung gestellt). Danach aendert der Partner nichts mehr.
  billedAt      DateTime?
  extras        VenueEventExtra[]
  documents     VenueEventDocument[]
  changes       VenueEventChange[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([accountId, areaId, startDate])
  @@index([partnerId, startDate])
}

/// Gewaehlte Zusatzleistung mit Preis-Schnappschuss.
model VenueEventExtra {
  id             Int            @id @default(autoincrement())
  eventId        Int
  event          VenueEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  extraId        Int?
  extra          VenueExtra?    @relation(fields: [extraId], references: [id], onDelete: SetNull)
  name           String
  unit           VenueExtraUnit
  unitPriceCents Int
  /// Bei PER_PIECE die Stueckzahl; bei FLAT 1; bei PER_PERSON ungenutzt (1).
  quantity       Int            @default(1)

  @@unique([eventId, extraId])
  @@index([eventId])
}

enum VenueDocumentKind {
  ORDER_CONFIRMATION
  DEPOSIT_INVOICE
  FINAL_INVOICE
  OTHER
}

/// PDF aus DATEV (Auftragsbestaetigung, Anzahlungs-, Schlussrechnung), das
/// wir hochladen und das der Partner seines Termins sieht.
model VenueEventDocument {
  id          Int               @id @default(autoincrement())
  accountId   Int
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId     Int
  event       VenueEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind        VenueDocumentKind
  fileName    String
  size        Int
  /// Blob-Pfad (Praefix event-docs); ohne Blob-Speicher die Bytes in `pdf`.
  pdfBlob     String?
  pdf         Bytes?
  /// Rechnungsnummer o. ae. (frei).
  reference   String?
  /// Betrag brutto in Cent (optional, fuer die Uebersicht).
  amountCents Int?
  uploadedBy  String?
  /// Zuletzt vom Partner geoeffnet.
  viewedAt    DateTime?
  createdAt   DateTime          @default(now())

  @@index([accountId, eventId])
}

/// Verlauf eines Termins: wer hat wann was geaendert (fuer Rueckfragen).
model VenueEventChange {
  id      Int        @id @default(autoincrement())
  eventId Int
  event   VenueEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  at      DateTime   @default(now())
  /// "PARTNER" oder "ADMIN".
  by      String
  byName  String?
  summary String

  @@index([eventId, at])
}
