generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum DeviceType {
  RASPBERRY_PI
  SHELLY
  NUKI_SMARTLOCK
  GARDENA_VALVE
  AUDIO_PLAYER
}

enum DeviceCategory {
  DREHKREUZ
  TUER
  SENSOR
  SCHALTER
  BELEUCHTUNG
  AUDIO
  /// Markise – Antrieb mit zwei Fahrtrichtungen (Auf/Stopp/Zu).
  MARKISE
  /// Rolltor, Rollladen oder Sektionaltor – gleiche Steuerlogik wie MARKISE.
  ROLLTOR
}

enum TicketStatus {
  VALID
  REDEEMED
  INVALID
  PROTECTED
  PAUSED
  CANCELED
}

enum ValidityType {
  DATE_RANGE
  TIME_SLOT
  DURATION
}

enum ScanResult {
  GRANTED
  DENIED
  PROTECTED
}

enum NetworkDeviceType {
  SWITCH
  ROUTER
  ACCESS_POINT
  FIREWALL
  OTHER
}

enum NetworkPortStatus {
  ACTIVE
  INACTIVE
  RESERVED
  FAULTY
}

enum NetworkOutletType {
  WALL_OUTLET
  PATCH_PANEL
}

enum NetworkClientType {
  PC
  PRINTER
  CAMERA
  NAS
  PHONE
  IOT
  MONITOR
  OTHER
}

enum ApiProvider {
  ANNY
  WAKESYS
  BINARYTEC
  EMP_CONTROL
  SHELLY
  NUKI
  GARDENA
}

model Account {
  id              Int                   @id @default(autoincrement())
  subdomain       String                @unique
  name            String
  apiToken        String                @unique @default(cuid())
  isActive        Boolean               @default(true)
  // Standort für Sonnenauf-/-untergangs-Automationen (Default: Berlin).
  latitude        Float?
  longitude       Float?
  timezone        String? // IANA TZ, z.B. "Europe/Berlin"; null = Europe/Berlin
  /// JSON: Löschfristen in Tagen pro Bereich, null = unbegrenzt.
  /// Keys: vehicleSightings, personSightings, cameraEvents, scans,
  /// irrigationRuns, automationRuns, emailSends, hubTasks, discoveredDevices
  dataRetention   Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  admins          Admin[]
  devices         Device[]
  tickets         Ticket[]
  scans           Scan[]
  scanSnapshots   ScanSnapshot[]
  areas           AccessArea[]
  apiConfigs      ApiConfig[]
  monitors        MonitorConfig[]
  subscriptions   Subscription[]
  services        Service[]
  vouchers        Voucher[]
  telegramConfigs TelegramConfig[]
  shellyGroups    ShellyGroup[]
  automations     ShellyAutomation[]
  automationRuns  ShellyAutomationRun[]
  vereine         Verein[]
  lockers         Locker[]
  emailConfig     EmailConfig?
  emailRules      EmailRule[]
  emailSends      EmailSend[]
  announcements   MonitorAnnouncement[]
  slotBlocks      SlotBlock[]
  lostItems       LostItem[]
  irrigationSchedules IrrigationSchedule[]
  irrigationRuns  IrrigationRun[]
  pushSubscriptions PushSubscription[]
  infoFormTemplates InfoFormTemplate[]
  infoRequests    InfoRequest[]
  networkVlans    NetworkVlan[]
  networkDevices  NetworkDevice[]
  networkOutlets  NetworkOutlet[]
  networkClients  NetworkClient[]
  networkAreas    NetworkArea[]
  hubAgents       HubAgent[]
  hubTasks        HubTask[]
  discoveredDevices DiscoveredDevice[]
  cameras         Camera[]
  cameraEvents    CameraEvent[]
  allowedVehicles AllowedVehicle[]
  vehicleSightings VehicleSighting[]
  listedPersons   ListedPerson[]
  personSightings PersonSighting[]
  personFaceEmbeddings PersonFaceEmbedding[]
  surveillanceConfig SurveillanceConfig?
  audioZones      AudioZone[]
  audioTracks     AudioTrack[]
  audioPlaylists  AudioPlaylist[]
  audioAnnouncements AudioAnnouncement[]
  audioSchedules  AudioSchedule[]
  audioJobs       AudioJob[]
}

model Admin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(USER)
  lastLogin DateTime?
  accountId Int?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// TOTP-Secret, verschluesselt mit AUTH_SECRET (siehe src/lib/secret-box.ts).
  /// Wird schon beim Start der Einrichtung gesetzt; scharf ist der zweite
  /// Faktor erst mit twoFactorEnabledAt.
  twoFactorSecret        String?
  twoFactorEnabledAt     DateTime?
  /// bcrypt-Hashes der Wiederherstellungscodes. Ein benutzter Code wird aus
  /// der Liste entfernt, damit er kein zweites Mal funktioniert.
  twoFactorRecoveryCodes String[]  @default([])
  /// Zuletzt akzeptierter TOTP-Zeitschritt. Verhindert, dass ein abgefangener
  /// Code innerhalb seiner Gueltigkeit ein zweites Mal eingeloest wird.
  twoFactorLastStep      Int?
  twoFactorFailures      Int       @default(0)
  twoFactorLockedUntil   DateTime?

  @@index([accountId])
  @@index([email])
}

model Device {
  id              Int                 @id @default(autoincrement())
  name            String
  type            DeviceType
  category        DeviceCategory?
  ipAddress       String?
  shellyId        String?
  shellyAuthKey   String?
  /// Antriebe (MARKISE/ROLLTOR) mit zwei getrennten Relais: Shelly-Kanal, der
  /// die Fahrtrichtung "Auf" schaltet (0-basiert). NULL = Gerät ist kein
  /// Antrieb bzw. noch nicht eingerichtet.
  coverUpChannel   Int?
  /// Shelly-Kanal fuer "Zu". Muss sich von coverUpChannel unterscheiden – beide
  /// Relais duerfen nie gleichzeitig anziehen (Motor faehrt sonst gegen sich
  /// selbst). Die Verriegelung erzwingt das in `src/lib/shelly-cover.ts`.
  coverDownChannel Int?
  /// Volle Fahrzeit in Sekunden. Wird als Shelly-eigener Auto-Off-Timer
  /// mitgesendet, damit das Relais auch bei Netzwerkausfall wieder abfaellt.
  coverRuntimeSec  Int?
  /// Nuki Smart Lock ID (numerische ID aus der Nuki Web API).
  /// Wird beim Sync aus `GET /smartlock` befuellt; identifiziert das Geraet
  /// fuer `POST /smartlock/{id}/action` und Webhook-Events.
  nukiSmartlockId String?
  /// GARDENA smart system Service-ID des VALVE-Service (z. B.
  /// "ee5b3996-defe-4903-934a-a33822e85b0c:2"). Identifiziert Ventil bzw.
  /// Pumpe fuer `PUT /v1/command/{serviceId}` und den Status-Abgleich ueber
  /// die Location-Details. Wird beim Import aus der GARDENA Cloud befuellt.
  gardenaServiceId String?
  /// Verweist auf die GARDENA-Verbindung (ApiConfig, provider = GARDENA), mit
  /// der dieses Ventil/diese Pumpe gesteuert und abgefragt wird. Ermoeglicht
  /// mehrere GARDENA-Konten (Application Key/Secret) pro Mandant.
  gardenaConfigId Int?
  gardenaConfig   ApiConfig?          @relation("GardenaConfigDevices", fields: [gardenaConfigId], references: [id], onDelete: SetNull)
  /// Durchflussrate der Zone in Liter/Stunde (Bewaesserung) – so wie die
  /// GARDENA-Pumpe den Wert anzeigt. Grundlage fuer Verbrauchsstatistik und
  /// die exakte Wasserbilanz-Dauer.
  flowLph         Float?
  /// Bewaesserte Flaeche der Zone in m². Zusammen mit flowLph kann die Dauer
  /// aus dem Wasserdefizit (mm) exakt berechnet werden.
  areaSqm         Float?
  /// Optionale Zuordnung Ventil → Pumpe (beide sind GARDENA_VALVE-Geraete):
  /// wird das Ventil aktiviert, schaltet die zugeordnete Pumpe automatisch mit
  /// an. Self-Relation innerhalb der Device-Tabelle.
  pumpDeviceId    Int?
  pump            Device?             @relation("ValvePump", fields: [pumpDeviceId], references: [id], onDelete: SetNull)
  valves          Device[]            @relation("ValvePump")
  isActive        Boolean             @default(true)
  task            Int                 @default(0)
  accessIn        Int?
  accessOut       Int?
  allowReentry    Boolean             @default(false)
  /// Optionale Kamera-Zuordnung: Kamera, die diesen Zugang im Blick hat
  /// (z. B. Drehkreuz "Eingang A" → Kamera Eingang). Scans dieses Geraets
  /// werden in der UI mit der Kamera verknuepft (Live-Bild/Schnappschuss).
  cameraId        Int?
  camera          Camera?             @relation("DeviceCamera", fields: [cameraId], references: [id], onDelete: SetNull)
  firmware        String?
  schedule        Json?
  systemInfo      Json?
  lastUpdate      DateTime?
  /// Offline-Push-Tracking: Zeitpunkt, zu dem fuer die AKTUELLE Offline-
  /// Episode eine Push-Benachrichtigung gesendet wurde. NULL = Geraet gilt
  /// als online bzw. Episode beendet. Wird ausschliesslich vom Cron
  /// `/api/cron/device-offline-check` gesetzt und geloescht.
  offlineNotifiedAt DateTime?
  /// Opt-in pro Geraet: nur wenn true, prueft der Offline-Cron dieses Geraet
  /// und sendet Push-Benachrichtigungen bei offline/wieder-online.
  offlineAlertsEnabled Boolean @default(false)
  accountId       Int
  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scans           Scan[]
  groupMembers    ShellyGroupMember[]
  irrigationSchedules IrrigationSchedule[]
  irrigationRuns      IrrigationRun[]
  /// Tickets, die diesem Geraet direkt zugewiesen sind (additiv zu Bereichen).
  /// Wird vor allem fuer Mitarbeiter verwendet, die ohne Bereich-Zugehoerigkeit
  /// nur ein einzelnes Geraet bedienen sollen.
  ticketDevices   TicketDevice[]
  /// Optionale Netzwerk-Zuordnung (Switch-Port/VLAN) dieses IoT-Geraets.
  networkClient   NetworkClient?
  allowedVehicles AllowedVehicle[]
  listedPersons   ListedPerson[]
  /// Beschallungszone, die dieser Abspieler (type = AUDIO_PLAYER) bedient.
  audioZone       AudioZone?          @relation("AudioZoneDevice")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([accountId])
  @@index([accessIn])
  @@index([accessOut])
  @@index([pumpDeviceId])
  @@index([cameraId])
}

model Ticket {
  id                      Int                  @id @default(autoincrement())
  name                    String
  qrCode                  String?
  rfidCode                String?
  startDate               DateTime?
  endDate                 DateTime?
  validityType            ValidityType         @default(DATE_RANGE)
  slotStart               String? // HH:mm for TIME_SLOT
  slotEnd                 String? // HH:mm for TIME_SLOT
  validityDurationMinutes Int? // minutes for DURATION
  firstScanAt             DateTime? // auto-set on first GRANTED scan for DURATION
  accessAreaId            Int?
  subscriptionId          Int?
  serviceId               Int?
  vereinId                Int?
  status                  TicketStatus         @default(VALID)
  version                 Int                  @default(0)
  uuid                    String?              @unique
  barcode                 String?              @unique
  firstName               String?
  lastName                String?
  birthDate               DateTime?
  ticketTypeName          String?
  profileImage            String?              @db.Text
  extras                  Json?
  email                   String? // optionale Email-Adresse für automatische Mails (Aboablauf, Followup …)
  source                  ApiProvider?
  /// UUID einer Bulk-Erstellung (alle Tickets aus einem Bulk-Run teilen sich
  /// die gleiche `bulkBatchId`). Erlaubt Liste/Reprint im Backoffice.
  /// NULL = kein Bulk-Ticket (manuell oder von Anny synchronisiert).
  bulkBatchId             String?
  /// Wochenplan (gleiches Format wie `Device.schedule` -> `WeekSchedule`):
  /// {monday: {enabled, on: "HH:MM", off: "HH:MM"}, ...}
  /// Wenn gesetzt, wird ein Scan nur freigegeben, wenn die aktuelle Berliner
  /// Zeit am betreffenden Wochentag im on/off-Fenster liegt. Vor allem fuer
  /// Mitarbeiter-Tickets gedacht (Arbeitszeiten).
  weekSchedule            Json?
  /// Persoenlicher Mobile-PWA-Token. Wer den Token hat, kann auf der
  /// `/m/<token>`-Seite die ihm zugewiesenen Geraete bedienen. Wird im
  /// Mitarbeiter-Editor erzeugt/rotiert und kann per QR an den Mitarbeiter
  /// geteilt werden. NULL = noch kein Token erzeugt.
  mobileToken             String?              @unique
  /// UUID der ANNY-Booking, die bei Ticket-Verkauf erzeugt wurde (Slot-
  /// Kapazitaet in ANNY blocken). Wird gespeichert, um spaeter beim Storno
  /// die Booking in ANNY cancelen zu koennen. NULL = nicht via ANNY
  /// gebucht (Tagesticket, manuelle Eingabe, oder Sync vor diesem Feature).
  annyBookingId           String?
  /// ID der ANNY-Ressource, auf die diese Buchung laeuft (z.B. "176390" =
  /// Aquapark, "176385" = Strandbad). `accessAreaId` taugt dafuer NICHT: es
  /// wird beim Sync auf die Hauptressource des Service ueberschrieben, damit
  /// der DURATION-Timer an der richtigen Stelle startet.
  /// Kombi-Services buchen pro Gast eine Booking je Ressource; erst dieses
  /// Feld macht die zusammengehoerenden Tickets als EIN Gast erkennbar.
  /// NULL = nicht von ANNY, oder Sync vor diesem Feature.
  annyResourceId          String?
  /// Freitext-Notiz, die das Personal am Shop-Monitor zum Ticket hinterlegen
  /// kann (z. B. "kommt morgen mit Kind", "Schluessel nicht zurueckgegeben").
  /// Wird im Ticket-Overlay sichtbar/editierbar; hat keine Auswirkung auf
  /// die Zugriffslogik.
  notes                   String?              @db.Text
  /// Antworten aus einer Info-Anfrage (Gaeste-Formular), als Key-Value-JSON:
  /// {"participantName": "Lena Vogt", "sport": "Wakeboard", "schuhgroesse": "36", ...}
  /// Die Feld-Definitionen (Label, Typ, Optionen) stehen im zugehoerigen
  /// `InfoFormTemplate`. Wird im Check-in-Monitor als Badges angezeigt und
  /// kann dort auch manuell editiert werden. NULL = keine Infos erfasst.
  guestInfo               Json?
  accountId               Int
  account                 Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessArea              AccessArea?          @relation(fields: [accessAreaId], references: [id], onDelete: SetNull)
  subscription            Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  service                 Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  verein                  Verein?              @relation(fields: [vereinId], references: [id], onDelete: SetNull)
  ticketAreas             TicketArea[]
  /// Direkt zugewiesene Geraete (additiv zu `ticketAreas`).
  ticketDevices           TicketDevice[]
  vereinAccess            VereinAccessTicket[] // Vereine, die über DIESES Ticket Zutritt erhalten
  lockerRentals           LockerRental[] // Schließfach-Vermietungen, in denen dieses Ticket Mieter ist (jahresweise)
  emailSends              EmailSend[] // Historie der an dieses Ticket gesendeten Automation-Mails
  scans                   Scan[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([accountId])
  @@index([rfidCode])
  @@index([qrCode])
  @@index([barcode])
  @@index([accessAreaId])
  @@index([subscriptionId])
  @@index([serviceId])
  @@index([vereinId])
  @@index([status])
  @@index([accountId, uuid])
  @@index([accountId, status])
  @@index([accountId, source])
  @@index([accountId, bulkBatchId])
}

model Scan {
  id        Int        @id @default(autoincrement())
  code      String
  note      String?
  deviceId  Int?
  scanTime  DateTime   @default(now())
  result    ScanResult
  ticketId  Int?
  accountId Int
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ticket    Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// Kamera-Schnappschuss zum Scan-Zeitpunkt (vom Hub aufgenommen).
  snapshot  ScanSnapshot?
  createdAt DateTime   @default(now())

  @@index([accountId])
  @@index([deviceId])
  @@index([scanTime])
  @@index([code])
  @@index([ticketId])
  @@index([accountId, scanTime])
  @@index([accountId, scanTime, result])
}

/// Schnappschuss der verknuepften Kamera zum Scan-Zeitpunkt. Wird vom Hub
/// ueber den Task SCAN_SNAPSHOT aufgenommen (wenige Sekunden nach dem Scan)
/// und dem zeitlich naechsten Scan des Geraets zugeordnet. Eigene Tabelle,
/// damit Scan-Listen die Bilddaten nicht mitladen.
model ScanSnapshot {
  id         Int      @id @default(autoincrement())
  scanId     Int      @unique
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  cameraId   Int?
  camera     Camera?  @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// JPEG-Bilddaten.
  image      Bytes
  /// Zeitpunkt der Aufnahme durch den Hub.
  capturedAt DateTime @default(now())
  accountId  Int
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([cameraId])
}

model AccessArea {
  id              Int                @id @default(autoincrement())
  name            String
  parentId        Int?
  allowReentry    Boolean            @default(false)
  personLimit     Int?
  showOnDashboard Boolean            @default(true)
  openingHours    String?
  accountId       Int
  account         Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent          AccessArea?        @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        AccessArea[]       @relation("AreaHierarchy")
  tickets         Ticket[]
  ticketAreas     TicketArea[]
  subscriptions   Subscription[]
  serviceAreas    ServiceArea[]
  servicesAsMain  Service[]          @relation("ServiceMainArea")
  annyLinks       AnnyResourceLink[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([accountId])
  @@index([parentId])
}

model TicketArea {
  id           Int        @id @default(autoincrement())
  ticketId     Int
  accessAreaId Int
  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  accessArea   AccessArea @relation(fields: [accessAreaId], references: [id], onDelete: Cascade)

  @@unique([ticketId, accessAreaId])
  @@index([ticketId])
  @@index([accessAreaId])
}

/// Direkter Zugang Ticket -> Geraet (additiv zu `TicketArea`).
/// Heisst: Ein Ticket bekommt Zugang am Geraet, wenn entweder seine Bereiche
/// `Device.accessIn`/`accessOut` matchen **oder** ein passender Eintrag in
/// dieser Tabelle existiert. Vor allem fuer Mitarbeiter gedacht, die nur ein
/// einzelnes Geraet (z. B. Nebeneingang) bedienen sollen, ohne dass dafuer ein
/// eigener Bereich angelegt werden muss.
model TicketDevice {
  id        Int    @id @default(autoincrement())
  ticketId  Int
  deviceId  Int
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([ticketId, deviceId])
  @@index([ticketId])
  @@index([deviceId])
}

model Subscription {
  id                             Int           @id @default(autoincrement())
  name                           String
  annyNames                      String?
  defaultValidityType            ValidityType?
  defaultStartDate               DateTime?
  defaultEndDate                 DateTime?
  defaultSlotStart               String? // HH:mm
  defaultSlotEnd                 String? // HH:mm
  defaultValidityDurationMinutes Int?
  requiresPhoto                  Boolean       @default(false)
  requiresRfid                   Boolean       @default(false)
  accountId                      Int
  account                        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  areas                          AccessArea[]
  tickets                        Ticket[]
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  @@index([accountId])
}

/// Art der Schließfach-Sicherung.
enum LockerType {
  /// Klassisches Schlüsselschloss – meist 2 Schlüssel pro Schließfach.
  KEY
  /// Vorhängeschloss – wird häufig nur als ein Stück ausgegeben.
  PADLOCK
}

/// Schließfach (locker). Vermietung läuft jahresweise über `LockerRental`
/// (1 Mieter-Ticket pro Schließfach pro Jahr) – damit ergibt sich automatisch
/// eine Historie, welcher Mieter das Schließfach in welchem Jahr hatte.
model Locker {
  id         Int            @id @default(autoincrement())
  /// Bezeichnung des Schließfachs (frei wählbar, z. B. „Spind 12“).
  name       String
  /// Optionaler Standort (z. B. „Umkleide UG“, „Halle Ost“).
  location   String?
  /// Schließfach-Nummer (frei: „A12“, „007“ etc.). Eindeutig pro Account.
  number     String
  /// Optionale Notiz / Kommentar (z. B. Schloss-Code).
  notes      String?
  /// Art der Sicherung (Schlüssel- oder Vorhängeschloss).
  lockType   LockerType     @default(KEY)
  /// Wie viele Schlüssel/Vorhängeschlösser gehören insgesamt zu diesem
  /// Schließfach (Soll-Bestand). Default: 2 für Schlüssel, 1 für Vorhänge.
  keyCount   Int            @default(2)
  /// Aufgedruckte Schloss-/Zylindernummer (nur sinnvoll bei Schlüsselschloss).
  lockNumber String?
  accountId  Int
  account    Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rentals    LockerRental[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([accountId, number])
  @@index([accountId])
}

/// Eine Vermietung eines Schließfachs an einen Mieter (Abo-Ticket) für ein
/// bestimmtes Kalenderjahr. Pro `(lockerId, year)` ist nur ein Eintrag möglich.
/// Beim Löschen des Tickets verschwindet auch der Vermietungs-Eintrag (Cascade);
/// der Verlauf für andere Jahre bleibt erhalten.
model LockerRental {
  id           Int       @id @default(autoincrement())
  lockerId     Int
  /// Optional: verknuepftes Mieter-Ticket (Abo). Mindestens eines von
  /// `ticketId` oder `renterName` muss gesetzt sein (App-Validator).
  /// Wird das Ticket geloescht, bleibt die Vermietung als Historie erhalten
  /// (ticketId -> NULL); fuer Anzeige greift dann `renterName` (sofern gesetzt).
  ticketId     Int?
  /// Manuell eingegebener Mietername (Fallback ohne Abo-Ticket).
  renterName   String?
  /// Vermietungsjahr als Kalenderjahr (z. B. 2026).
  year         Int
  /// Optionale Notiz für genau diese Vermietungs-Periode.
  notes        String?
  /// Anzahl bei Mietbeginn ausgegebener Schlüssel/Vorhängeschlösser.
  keysIssued   Int       @default(0)
  /// Anzahl davon, die bisher zurückgegeben wurden.
  keysReturned Int       @default(0)
  /// Zeitpunkt der Schlüssel-/Schlossausgabe (NULL = noch nicht ausgegeben).
  issuedAt     DateTime?
  /// Zeitpunkt der vollständigen Rücknahme (NULL = noch nicht zurück).
  returnedAt   DateTime?
  locker       Locker    @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  ticket       Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([lockerId, year])
  @@index([lockerId])
  @@index([ticketId])
  @@index([year])
}

model ServiceArea {
  id                             Int           @id @default(autoincrement())
  serviceId                      Int
  accessAreaId                   Int
  defaultValidityType            ValidityType?
  defaultStartDate               DateTime?
  defaultEndDate                 DateTime?
  defaultSlotStart               String? // HH:mm
  defaultSlotEnd                 String? // HH:mm
  defaultValidityDurationMinutes Int?
  service                        Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  area                           AccessArea    @relation(fields: [accessAreaId], references: [id], onDelete: Cascade)

  @@unique([serviceId, accessAreaId])
  @@index([serviceId])
  @@index([accessAreaId])
}

model Service {
  id                             Int           @id @default(autoincrement())
  name                           String
  annyNames                      String?
  defaultValidityType            ValidityType?
  defaultStartDate               DateTime?
  defaultEndDate                 DateTime?
  defaultSlotStart               String? // HH:mm
  defaultSlotEnd                 String? // HH:mm
  defaultValidityDurationMinutes Int?
  allowReentry                   Boolean       @default(false)
  allowManualCheckin             Boolean       @default(true)
  requiresPhoto                  Boolean       @default(false)
  requiresRfid                   Boolean       @default(false)
  /// Hauptressource des Service. Wenn gesetzt, wird sie beim Verkauf als
  /// `Ticket.accessAreaId` (Hauptressource) verwendet - die anderen
  /// `serviceAreas` werden als Transit/Nebenressourcen behandelt. Beispiel
  /// "Wake&Ski 2 Stunden": Hauptressource = Seilbahn A, Nebenressourcen
  /// = Strandbad. Nach Ablauf der DURATION wird nur die Hauptressource
  /// blockiert; das Strandbad bleibt als Tagesticket-Aequivalent offen.
  /// MUSS Teil der `serviceAreas` sein - wird im API/Frontend abgesichert.
  /// NULL = Service hat keine eindeutige Hauptressource (Fallback: erste
  /// `serviceArea` nach ID).
  mainAccessAreaId               Int?
  mainAccessArea                 AccessArea?   @relation("ServiceMainArea", fields: [mainAccessAreaId], references: [id], onDelete: SetNull)
  accountId                      Int
  account                        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceAreas                   ServiceArea[]
  tickets                        Ticket[]
  slotBlocks                     SlotBlock[]
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  @@index([accountId])
  @@index([mainAccessAreaId])
}

/// Manuelle Slot-Sperre vom Shop-/Check-in-Monitor. Beim Anlegen wird die
/// volle Restkapazitaet des Slots in ANNY per Platzhalter-Buchung belegt
/// (`annyBookingIds`), damit der Slot auch in ANNY nicht mehr buchbar ist.
/// Beim Aufheben werden diese ANNY-Buchungen storniert.
model SlotBlock {
  id             Int      @id @default(autoincrement())
  accountId      Int
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceId      Int?
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Snapshot des Service-Namens fuer die Anzeige (falls Service spaeter
  /// umbenannt/geloescht wird).
  serviceName    String
  /// Tag der Sperre in Berlin-Zeit (YYYY-MM-DD).
  date           String
  /// Slot-Start/-Ende als HH:mm (Berlin), zum Matchen gegen die Slot-Liste.
  slotStart      String
  slotEnd        String
  /// Exakte Start-/Endzeit der gesperrten Buchung (ISO mit Offset).
  startDate      DateTime
  endDate        DateTime
  /// Wieviele Plaetze in ANNY belegt wurden (= Restkapazitaet beim Sperren).
  quantity       Int      @default(1)
  /// Optionaler Sperrgrund (Anzeige + ANNY-Beschreibung).
  reason         String?
  /// JSON-Array der in ANNY angelegten Booking-UUIDs (fuer Storno beim
  /// Aufheben). "[]" wenn ANNY beim Anlegen nicht erreichbar war.
  annyBookingIds String?
  /// UUID des ANNY-Orders (Diagnose).
  annyOrderId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, date])
  @@index([serviceId, date, slotStart])
}

model MonitorConfig {
  id        Int      @id @default(autoincrement())
  name      String
  token     String   @unique @default(cuid())
  type      String   @default("MONITOR") // MONITOR | CHECKIN | RESOURCE_MONITOR | SCANNER
  deviceIds Json     @default("[]")
  // Optionale Bereichs-Eingrenzung fuer Scan-Monitore (Typ MONITOR), deren
  // Personenliste sonst nur ueber die Geraete-Bereiche gefiltert wird. Damit
  // laesst sich ein Monitor auch fuer Bereiche OHNE eigenes Scan-Geraet
  // erstellen (z.B. Seilbahn B / Uebungslift). Enthaelt AccessArea-IDs.
  areaIds   Json     @default("[]")
  isActive  Boolean  @default(true)
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([token])
}

/// Kurznachricht, die ein Mitarbeiter vom Shop-/Check-in-Monitor an alle
/// Public-Monitore desselben Accounts schickt (z. B. "Anfaengerkurs gleich an
/// Seilbahn A"). Wird im Public-Monitor als Banner oben angezeigt, bis ein
/// Mitarbeiter dort manuell auf X klickt -> `dismissedAt` wird gesetzt und
/// der Banner verschwindet auf allen Monitoren.
model MonitorAnnouncement {
  id          Int       @id @default(autoincrement())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  message     String
  /// Optional: Name des Quell-Monitors (Shop-Monitor), rein informativ fuer
  /// die Anzeige ("Hinweis vom Shop"). Wird kein Fremdschluessel, weil der
  /// Monitor zwischenzeitlich umbenannt / geloescht werden koennte.
  sourceLabel String?
  createdAt   DateTime  @default(now())
  /// Wenn != null, wurde der Hinweis manuell geschlossen und ist fuer alle
  /// Public-Monitore aus dem Banner verschwunden.
  dismissedAt DateTime?

  @@index([accountId, dismissedAt])
}

// ── Email-Automationen ───────────────────────────────────────────────────────

/// Pro Account genau eine Konfiguration. Aktuell wird Resend (HTTP API) als
/// Provider unterstützt – das Feld `provider` ist als Erweiterungspunkt für
/// SMTP o. ä. vorbereitet.
model EmailConfig {
  id         Int      @id @default(autoincrement())
  accountId  Int      @unique
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "GMAIL" (default, SMTP via App-Passwort). Erweiterungspunkt fuer weitere
  /// Provider in Zukunft.
  provider   String   @default("GMAIL")
  /// Provider-Credential. Bei GMAIL: das Google-App-Passwort. Wir behandeln
  /// es analog zum Telegram-Bot-Token (Klartext-Spalte, RLS-isoliert).
  apiKey     String?
  /// Optionaler Bot-Mail-Absender, z. B. "no-reply@deindomain.de".
  fromEmail  String
  fromName   String?
  replyTo    String?
  isActive   Boolean  @default(true)
  /// Branding-Farbe für HTML-Templates (Hex, z. B. "#4F46E5").
  brandColor String?
  /// Optionale Logo-URL und Website (für Footer/Header in HTML).
  logoUrl    String?
  websiteUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId])
}

/// Welcher Lebenszyklus-Event triggert die Mail?
enum EmailRuleTrigger {
  /// Tage VOR `Ticket.endDate` einer Subscription (Aboablauf-Erinnerung).
  SUBSCRIPTION_EXPIRING
  /// Tage NACH `Ticket.endDate` einer Subscription (Win-Back).
  SUBSCRIPTION_EXPIRED
  /// Tage NACH dem ersten Scan eines Tagestickets (Followup mit Voucher).
  DAY_VISIT_FOLLOWUP
  /// Tage NACH `Ticket.createdAt` (Welcome / Onboarding).
  TICKET_WELCOME
}

/// Eine Regel definiert, wann an welche Tickets eine Email automatisch
/// verschickt wird. Templates verwenden Platzhalter wie `{{firstName}}`.
model EmailRule {
  id                     Int              @id @default(autoincrement())
  accountId              Int
  account                Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                   String
  trigger                EmailRuleTrigger
  /// Tage relativ zum Trigger-Ereignis. Beispiel:
  ///   SUBSCRIPTION_EXPIRING, daysOffset=7  → 7 Tage vor endDate
  ///   DAY_VISIT_FOLLOWUP,    daysOffset=2  → 2 Tage nach erstem Scan
  daysOffset             Int              @default(0)
  /// Optionaler Filter: nur Tickets mit dieser Subscription bzw. Service.
  subscriptionId         Int?
  serviceId              Int?
  /// Subject + HTML-Body. Body wird in einen Mail-Wrapper eingebettet.
  subject                String
  bodyHtml               String           @db.Text
  /// Wenn true, wird vor dem Versand ein `Voucher` mit `discountPercent` und
  /// optionalem Verfallsdatum erzeugt – Code/Url stehen in den Platzhaltern
  /// `{{voucherCode}}` und `{{voucherUrl}}` zur Verfügung.
  createVoucher          Boolean          @default(false)
  voucherDiscountPercent Int?
  voucherValidDays       Int?
  voucherTicketTypeName  String?
  /// Optionale URL, z. B. zum Abo-Renew-Formular. `{{renewUrl}}` im Template.
  renewUrl               String?
  isActive               Boolean          @default(true)
  /// Mindest-Abstand in Tagen zwischen 2 Sends derselben Regel an dasselbe
  /// Ticket. Verhindert Doppel-Versand bei Cron-Reruns oder Datenkorrekturen.
  cooldownDays           Int              @default(30)
  /// Rückwärts-Fenster in Tagen, in dem verpasste Trigger-Tage nachgeholt werden.
  /// `lookbackDays = 0` ⇒ Mail geht NUR am exakten Soll-Sendetag raus (altes Verhalten).
  /// `lookbackDays = 7` ⇒ Mail geht auch noch raus, wenn der Soll-Sendetag bis zu
  /// 7 Tage in der Vergangenheit liegt (z. B. weil Cron einen Tag verpasst hat
  /// oder die Regel später aktiviert wurde). Cooldown sichert Idempotenz.
  lookbackDays           Int              @default(7)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  emailSends             EmailSend[]

  @@index([accountId])
  @@index([accountId, isActive])
  @@index([trigger, isActive])
}

/// Persistentes Versand-Log, dient zugleich als Idempotenz-Guard.
model EmailSend {
  id           Int        @id @default(autoincrement())
  accountId    Int
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId       Int?
  rule         EmailRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ticketId     Int?
  ticket       Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  voucherId    Int?
  voucher      Voucher?   @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  /// Empfänger (kopiert, falls Ticket gelöscht wird).
  to           String
  subject      String
  /// "SENT" | "FAILED" | "TEST"
  status       String
  errorMessage String?
  sentAt       DateTime   @default(now())

  @@index([accountId, sentAt])
  @@index([ticketId])
  @@index([ruleId])
  @@index([accountId, ruleId, ticketId])
}

/// Wiederverwendbare Formular-Definition fuer Info-Anfragen an Gaeste
/// (z. B. Ferienkurs: Wasserski/Wakeboard, Schuhgroesse, Level, Neopren).
/// `fields` ist ein JSON-Array von Feld-Definitionen:
///   [{ key, label, type: "choice"|"text"|"number"|"boolean",
///      options?: string[], required?: boolean, showIfKey?: string }]
/// `showIfKey` blendet das Feld nur ein, wenn das referenzierte
/// boolean-Feld mit "Ja" beantwortet wurde (z. B. Neopren-Groesse).
model InfoFormTemplate {
  id           Int           @id @default(autoincrement())
  accountId    Int
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  /// Einleitungstext, der im oeffentlichen Formular ueber den Feldern steht.
  introText    String?       @db.Text
  fields       Json
  /// Wenn true, wird pro Platz zusaetzlich der Teilnehmername abgefragt
  /// (Ticket-Name ist oft der buchende Elternteil, nicht das Kind).
  askParticipantName Boolean @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  infoRequests InfoRequest[]

  @@index([accountId])
}

/// Eine versendete Info-Anfrage an EINE Email-Adresse. Buendelt alle
/// Wochen-Tickets (Kursplaetze) dieser Adresse: der Empfaenger beantwortet
/// das Formular pro Ticket, die Antworten landen in `Ticket.guestInfo`.
/// `token` ist das Zugriffsgeheimnis der oeffentlichen /info/<token>-Seite.
model InfoRequest {
  id           Int              @id @default(autoincrement())
  accountId    Int
  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  templateId   Int
  template     InfoFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  token        String           @unique
  /// Empfaenger-Adresse (Snapshot).
  email        String
  /// JSON-Array der Ticket-IDs, die diese Anfrage abdeckt.
  ticketIds    Json
  /// "SENT" | "COMPLETED" | "FAILED"
  status       String           @default("SENT")
  sentAt       DateTime         @default(now())
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([accountId])
  @@index([accountId, status])
  @@index([token])
}

/// Web-Push-Abonnement eines Browsers/PWA-Geraets (Dashboard). Ein Admin kann
/// auf mehreren Geraeten abonnieren – jede Kombination Browser+Geraet erzeugt
/// einen eigenen Endpoint. Abgelaufene Endpoints (HTTP 404/410 beim Senden)
/// werden vom Versand-Helper automatisch geloescht.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  /// Push-Service-URL (FCM/Mozilla/APNs-Proxy) – eindeutig pro Abo.
  endpoint  String   @unique
  /// Client-Public-Key (ECDH) fuer die Payload-Verschluesselung.
  p256dh    String
  /// Auth-Secret des Clients fuer die Payload-Verschluesselung.
  auth      String
  /// User-Agent beim Abonnieren – rein informativ ("welches Geraet ist das?").
  userAgent String?
  /// Admin, der das Abo erstellt hat (informativ, kein FK-Zwang noetig).
  adminId   Int?
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model TelegramConfig {
  id              Int      @id @default(autoincrement())
  botToken        String
  chatId          String
  isActive        Boolean  @default(true)
  dailyReport     Boolean  @default(true)
  dailyReportTime String   @default("20:00") // HH:mm Berlin time
  accountId       Int
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
}

model AnnyResourceLink {
  id                Int        @id @default(autoincrement())
  accessAreaId      Int
  accessArea        AccessArea @relation(fields: [accessAreaId], references: [id], onDelete: Cascade)
  annyResourceId    String
  annyName          String
  label             String
  isPublic          Boolean    @default(false)
  splitSlots        Boolean    @default(false)
  bookingInterval   Int?
  priceLabel        String?
  priceLabelWeekend String?
  accountId         Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([accessAreaId, annyName])
  @@index([accountId])
  @@index([accessAreaId])
}

model Voucher {
  id                      Int          @id @default(autoincrement())
  code                    String       @unique
  ticketTypeName          String?
  serviceId               Int?
  accessAreaId            Int?
  validityType            ValidityType @default(DATE_RANGE)
  validityDurationMinutes Int?
  sourceTicketId          Int?
  redeemedAt              DateTime?
  redeemedTicketId        Int?
  /// Optionaler Rabatt-Anteil (z. B. 10 = 10% Rabatt). Nur informativ – wird beim
  /// nächsten Besuch manuell durch das Personal eingelöst (kein Auto-Redeem).
  discountPercent         Int?
  /// Optionales Verfallsdatum (z. B. 60 Tage nach Versand). NULL = unbegrenzt.
  expiresAt               DateTime?
  /// Freitextnotiz, etwa "Followup Tagesgast 04/2026".
  notes                   String?
  /// Wenn gesetzt: Gutschein wurde manuell deaktiviert (z. B. als
  /// ungueltig erklaert). Beim Scan wird er wie "bereits eingeloest"
  /// behandelt und erlaubt keine Ticket-Erstellung mehr.
  disabledAt              DateTime?
  accountId               Int
  account                 Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  emailSends              EmailSend[]
  createdAt               DateTime     @default(now())

  @@index([accountId])
  @@index([code])
  @@index([accountId, expiresAt])
}

model ApiConfig {
  id             Int         @id @default(autoincrement())
  provider       ApiProvider
  /// Optionales Label, um mehrere Verbindungen desselben Providers zu
  /// unterscheiden (v. a. GARDENA: mehrere Konten pro Mandant).
  name           String?
  token          String
  eventId        String?
  baseUrl        String?
  extraConfig    String?
  lastUpdate     DateTime?
  lastPostUpdate DateTime?
  accountId      Int
  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gardenaDevices Device[]    @relation("GardenaConfigDevices")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([accountId])
  @@index([provider])
  @@index([accountId, provider])
}

// ── Shelly-Automationen ──────────────────────────────────────────────────────

enum ShellyAction {
  ON
  OFF
  TOGGLE
  /// Antriebe (MARKISE/ROLLTOR): auffahren.
  OPEN
  /// Antriebe: zufahren.
  CLOSE
  /// Antriebe: beide Fahrtrichtungen abschalten.
  STOP
}

enum AutomationTrigger {
  SCHEDULE
  SUNRISE
  SUNSET
  /// Kamera-Ereignis (z. B. PERSON) loest eine Szene aus.
  CAMERA_EVENT
}

/// Eine Gruppe fungiert als Szene: mehrere Shelly-Geräte mit jeweils eigener
/// Aktion (ON/OFF/TOGGLE) und optionalem Timer. Gruppen können manuell per
/// Button oder über Automationen ausgeführt werden.
model ShellyGroup {
  id          Int                 @id @default(autoincrement())
  accountId   Int
  account     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int                 @default(0)
  members     ShellyGroupMember[]
  automations ShellyAutomation[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([accountId])
}

model ShellyGroupMember {
  id           Int          @id @default(autoincrement())
  groupId      Int
  group        ShellyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deviceId     Int
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action       ShellyAction @default(ON)
  /// Optionaler Auto-Off-Timer in Sekunden (Shelly-native `timer`-Param bei ON).
  timerSeconds Int?
  sortOrder    Int          @default(0)

  @@unique([groupId, deviceId])
  @@index([groupId])
  @@index([deviceId])
}

/// Eine Automation triggert eine Gruppe (Szene) nach einem Zeitplan,
/// relativ zu Sonnenauf-/Sonnenuntergang oder bei einem Kamera-Ereignis.
model ShellyAutomation {
  id            Int                   @id @default(autoincrement())
  accountId     Int
  account       Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId       Int
  group         ShellyGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  isActive      Boolean               @default(true)
  trigger       AutomationTrigger
  /// Wochentage als Bitmaske: bit0=Mo, bit1=Di, …, bit6=So. 127 = jeden Tag.
  daysOfWeek    Int                   @default(127)
  /// "HH:mm" (nur relevant für trigger=SCHEDULE).
  timeOfDay     String?
  /// Offset in Minuten zum Sonnenauf/-untergang (nur SUNRISE/SUNSET).
  /// Negativ = vor dem Ereignis, positiv = danach.
  offsetMinutes Int                   @default(0)
  /// Kamera fuer trigger=CAMERA_EVENT.
  cameraId      Int?
  camera        Camera?               @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// Ereignistyp: "MOTION" | "PERSON" | "VEHICLE" | "ANIMAL" | "OTHER".
  eventType     String?
  /// Aktives Zeitfenster "HH:mm"–"HH:mm" (Account-TZ). end < start = ueber Mitternacht.
  windowStart   String?
  windowEnd     String?
  /// Mindestabstand zwischen zwei Ausloesungen (Kamera-Events flackern oft).
  cooldownMinutes Int                 @default(5)
  /// Letzter Lauf – dient als Idempotenz-Guard im Cron (verhindert Doppel-Ausführung).
  lastRunAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  runs          ShellyAutomationRun[]

  @@index([accountId, isActive])
  @@index([groupId])
  @@index([cameraId])
}

/// Vereinigung mehrerer Mitglieds-Tickets. Über `VereinAccessTicket` werden
/// dem Verein ein oder mehrere "Zutritts-Tickets" (z. B. Bahnmiete) zugeordnet
/// – alle Mitglieder erben beim Scan automatisch die Areas dieser Tickets.
/// Mitglieder bleiben eigenständige Tickets (eigener QR/RFID).
model Verein {
  id            Int                  @id @default(autoincrement())
  name          String
  description   String?
  accountId     Int
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members       Ticket[] // Mitglieds-Tickets via Ticket.vereinId
  accessTickets VereinAccessTicket[] // Zutritts-Tickets, deren Areas alle Mitglieder erben
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

/// Verknüpfung Verein ↔ Ticket: Mitglieder des Vereins erben beim Scan die
/// Areas dieses Tickets (eigener accessAreaId + alle ticketAreas), sofern
/// das Ticket aktuell gültig ist (Status, Datumsrange, TIME_SLOT, DURATION).
/// Restriktionen werden direkt vom Ticket selbst übernommen.
model VereinAccessTicket {
  id       Int    @id @default(autoincrement())
  vereinId Int
  ticketId Int
  verein   Verein @relation(fields: [vereinId], references: [id], onDelete: Cascade)
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([vereinId, ticketId])
  @@index([vereinId])
  @@index([ticketId])
}

enum LostItemKind {
  FOUND
  LOST_REPORT
}

/// Fundsache: wird im Backend oder am Shop-/Check-in-Monitor angelegt und
/// verwaltet. Bild als Base64-Data-URL (gleiches Muster wie Ticket.profileImage).
/// LOST_REPORT = jemand meldet einen verlorenen Gegenstand (Name + Rückrufnummer).
model LostItem {
  id            Int           @id @default(autoincrement())
  kind          LostItemKind  @default(FOUND)
  description   String
  foundDate     DateTime
  image         String?       @db.Text
  contact       String?
  reporterName  String?
  callbackPhone String?
  pickedUp      Boolean       @default(false)
  pickedUpAt    DateTime?
  accountId     Int
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([accountId, kind, pickedUp])
}

/// Automatischer Bewässerungs-Zeitplan fuer ein GARDENA-Ventil/eine Pumpe
/// (Device mit type = GARDENA_VALVE). Wird vom Cron (`/api/cron/irrigation`,
/// alle 5 Min) ausgewertet: passt der aktuelle Wochentag + die Startzeit und
/// wird nicht wegen Regen ausgesetzt, startet der Cron die Bewässerung fuer
/// `durationMinutes`. `lastRunAt` dient als Idempotenz-Guard.
model IrrigationSchedule {
  id              Int      @id @default(autoincrement())
  accountId       Int
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId        Int
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Wochentage als Bitmaske: bit0=Mo, bit1=Di, …, bit6=So. 127 = jeden Tag.
  daysOfWeek      Int      @default(127)
  /// "HH:mm" Startzeit in Berliner Zeit.
  startTime       String
  /// Bewässerungsdauer in Minuten.
  durationMinutes Int      @default(15)
  isActive        Boolean  @default(true)
  /// Bei erwartetem Regen (Wetter-Check) aussetzen.
  skipOnRain      Boolean  @default(true)
  /// Smart-Regen: Dauer anhand der Wetterlage skalieren (heiss → laenger,
  /// Regenrisiko → kuerzer). Unabhaengig vom harten skipOnRain-Aussetzer.
  smartRain       Boolean  @default(false)
  /// GARDENA SENSOR-Service-ID (Bodenfeuchte-Sensor). Wenn gesetzt, prueft der
  /// Cron vor dem Lauf die Bodenfeuchte und passt die Bewässerung smart an.
  sensorServiceId String?
  /// Boden ist "feucht genug" ab dieser Bodenfeuchte in Prozent – der Lauf wird
  /// dann uebersprungen. Bei trockenerem Boden wird die Dauer skaliert.
  moistureThresholdPct Int?
  /// Geordnete Ventil-Sequenz (Device-IDs). Wenn gesetzt, ist deviceId die
  /// Pumpe und die Ventile laufen nacheinander je durationMinutes.
  valveSequence   Json?
  /// Laufender Sequenz-Plan (vom Cron abgearbeitet):
  /// { startedAt, steps: [{ deviceId, minutes, offsetMin, startedAt? }] }
  runState        Json?
  /// Letzter erfolgreicher Lauf – verhindert Doppel-Ausführung im 5-Min-Cron.
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  runs            IrrigationRun[]

  @@index([accountId, isActive])
  @@index([deviceId])
}

/// Protokolliert jeden erfolgreichen Bewässerungs-Lauf eines Ventils (Dauer,
/// Quelle, geschaetzter Verbrauch). Basis fuer die Statistik-Ansicht.
model IrrigationRun {
  id              Int                 @id @default(autoincrement())
  accountId       Int
  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId        Int
  device          Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scheduleId      Int?
  schedule        IrrigationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  startedAt       DateTime            @default(now())
  /// Geplante Laufzeit in Minuten (wie an GARDENA gesendet).
  durationMinutes Int
  /// "schedule" = Cron-Zeitplan, "schedule_now" = Zeitplan „Jetzt", "manual" = UI-Knopf/Smart-Run
  source          String
  /// Geschaetzter Verbrauch in Liter (Durchfluss × Laufzeit), null wenn unbekannt.
  litersEstimate  Float?

  @@index([accountId, startedAt])
  @@index([deviceId, startedAt])
  @@index([scheduleId])
}

model ShellyAutomationRun {
  id           Int               @id @default(autoincrement())
  automationId Int?
  automation   ShellyAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  /// Auch manuelle Gruppen-Ausführungen werden hier geloggt – dann ohne Automation.
  groupId      Int?
  accountId    Int
  account      Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  triggeredAt  DateTime          @default(now())
  /// "schedule" | "sunrise" | "sunset" | "manual"
  triggerKind  String
  success      Boolean
  /// Strukturierte Member-Ergebnisse: [{ deviceId, deviceName, action, ok, error? }]
  details      Json?
  durationMs   Int?
  errorMessage String?

  @@index([accountId, triggeredAt])
  @@index([automationId])
  @@index([groupId])
}

// ── Netzwerk-Verwaltung ──────────────────────────────────────────────────────

/// VLAN (Netz-Segment), z. B. Management, IoT, Gaeste-WLAN.
model NetworkVlan {
  id          Int             @id @default(autoincrement())
  /// IEEE 802.1Q VLAN-ID (1-4094).
  vlanId      Int
  name        String
  /// CIDR-Notation, z. B. "192.168.10.0/24".
  subnet      String?
  gateway     String?
  description String?
  accountId   Int
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Ports mit diesem VLAN als untagged/PVID.
  ports       NetworkPort[]
  /// Ports, auf denen dieses VLAN tagged anliegt (Trunk).
  taggedPorts NetworkPortVlan[]
  clients     NetworkClient[]
  areas       NetworkArea[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([accountId, vlanId])
  @@index([accountId])
}

/// Physischer/organisatorischer Bereich innerhalb eines VLANs
/// (z. B. „Imbisscontainer“, „Imbiss“, „Strandbad“ im VLAN Kassen).
model NetworkArea {
  id          Int             @id @default(autoincrement())
  name        String
  /// Sortierung in der UI (aufsteigend).
  sortOrder   Int             @default(0)
  description String?
  /// Typischerweise einem VLAN zugeordnet (kann leer sein).
  vlanId      Int?
  vlan        NetworkVlan?    @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  /// Optionale IP-Range fuer Auto-Zuordnung (inklusive), z. B. 192.168.20.10 .. 192.168.20.39.
  ipFrom      String?
  ipTo        String?
  accountId   Int
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clients     NetworkClient[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
  @@index([vlanId])
}

/// Netzwerk-Infrastruktur-Hardware (Switch, Router, Access Point, Firewall).
/// Beim Anlegen eines Switches werden die Ports automatisch aus `portCount`
/// generiert (API-Logik).
model NetworkDevice {
  id         Int               @id @default(autoincrement())
  name       String
  type       NetworkDeviceType @default(SWITCH)
  vendor     String?
  model      String?
  ipAddress  String?
  macAddress String?
  /// Freitext-Standort, z. B. "Serverraum", "Technikraum Nord".
  location   String?
  notes      String?
  /// Zuletzt vom Hub-Netzwerk-Scan gesehen (MAC-Abgleich). Basis fuer den
  /// Online-/Offline-Status in der UI.
  lastSeenAt DateTime?
  accountId  Int
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ports      NetworkPort[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([accountId])
}

/// Physischer Port eines Switches/Routers.
model NetworkPort {
  id          Int               @id @default(autoincrement())
  /// Port-Nummer am Geraet (1..n).
  number      Int
  /// Optionale Beschriftung (Aufdruck/Etikett).
  label       String?
  deviceId    Int
  device      NetworkDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Untagged VLAN (PVID) des Ports.
  vlanId      Int?
  vlan        NetworkVlan?      @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  /// Tagged VLANs (Trunk-Konfiguration).
  taggedVlans NetworkPortVlan[]
  poe         Boolean           @default(false)
  /// Uplink/Zuleitung: Verbindung zu einem anderen Switch/Router statt zu
  /// einem Endgeraet - wird in der Port-Matrix gesondert dargestellt.
  uplink      Boolean           @default(false)
  status      NetworkPortStatus @default(ACTIVE)
  /// Verkabelung: mit welcher Dose / welchem Patchfeld-Port verbunden.
  outletId    Int?              @unique
  outlet      NetworkOutlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)
  notes       String?
  client      NetworkClient?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([deviceId, number])
  @@index([deviceId])
  @@index([vlanId])
}

/// m:n Port <-> VLAN fuer tagged VLANs (Trunk-Ports).
model NetworkPortVlan {
  id     Int         @id @default(autoincrement())
  portId Int
  port   NetworkPort @relation(fields: [portId], references: [id], onDelete: Cascade)
  vlanId Int
  vlan   NetworkVlan @relation(fields: [vlanId], references: [id], onDelete: Cascade)

  @@unique([portId, vlanId])
  @@index([portId])
  @@index([vlanId])
}

/// Physischer Anschluss: Wanddose oder Patchpanel-Port.
model NetworkOutlet {
  id        Int               @id @default(autoincrement())
  /// Beschriftung, z. B. "Dose 2.OG-14" oder "Patch A-07".
  label     String
  /// Raum/Bereich, z. B. "Shop", "Technikraum".
  location  String?
  type      NetworkOutletType @default(WALL_OUTLET)
  notes     String?
  accountId Int
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  port      NetworkPort?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([accountId, label])
  @@index([accountId])
}

/// Endgeraet im Netzwerk (Kassen-PC, Drucker, Kamera, NAS, ...). Kann
/// optional auf ein bestehendes IoT-`Device` verweisen – dann kommen Name/
/// IP/Status aus dem Device-Datensatz und hier wird nur die Netzwerk-
/// Zuordnung (Port/VLAN) gepflegt.
model NetworkClient {
  id         Int               @id @default(autoincrement())
  name       String
  type       NetworkClientType @default(OTHER)
  ipAddress  String?
  macAddress String?
  /// true = feste IP, false = DHCP.
  isStatic   Boolean           @default(false)
  /// Optionaler Link auf ein bestehendes IoT-/Zutritts-Geraet.
  deviceId   Int?              @unique
  device     Device?           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// An welchem Switch-Port das Geraet haengt (NULL = WLAN/unbekannt).
  portId     Int?              @unique
  port       NetworkPort?      @relation(fields: [portId], references: [id], onDelete: SetNull)
  /// Logisch zugeordnetes VLAN (auch ohne Port-Zuordnung moeglich, z. B. WLAN).
  vlanId     Int?
  vlan       NetworkVlan?      @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  /// Physischer Bereich (Imbiss, Container, Strandbad, …).
  areaId     Int?
  area       NetworkArea?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Zuletzt vom Hub-Netzwerk-Scan gesehen (MAC-Abgleich).
  lastSeenAt DateTime?
  notes      String?
  accountId  Int
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([accountId])
  @@index([vlanId])
  @@index([areaId])
}

// ── Lokaler Hub (On-Site-Agent) ──────────────────────────────────────────────

/// Ein lokal (z. B. auf einem iMac/Mini-PC) laufender Agent, der sich per
/// Account-API-Token mit der Cloud verbindet: Heartbeat, Task-Abholung,
/// Netzwerk-Scans, spaeter Kameras/lokale KI. Online-Status ergibt sich aus
/// `lastSeenAt` (gleiches 5-Minuten-Muster wie bei den Pi-Geraeten).
model HubAgent {
  id         Int      @id @default(autoincrement())
  /// Eindeutiger Name des Agents pro Account (z. B. "imac-technikraum").
  name       String
  hostname   String?
  /// Git-Commit/Version des laufenden Hub-Codes (fuer Update-Diagnose).
  version    String?
  /// Aktivierte Module, z. B. ["network-scan", "tasks"].
  modules    Json?
  lastSeenAt DateTime?
  accountId  Int
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

/// Task-Queue Cloud -> Hub. Die Cloud (UI/Cron) legt Tasks an, der Hub holt
/// sie per Polling ab (PENDING -> RUNNING) und meldet das Ergebnis zurueck
/// (DONE/FAILED). `type` z. B. "PING", "NETWORK_SCAN", "WAKE_ON_LAN".
model HubTask {
  id         Int      @id @default(autoincrement())
  type       String
  payload    Json?
  /// "PENDING" | "RUNNING" | "DONE" | "FAILED"
  status     String   @default("PENDING")
  result     Json?
  error      String?
  accountId  Int
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([accountId, status])
  @@index([accountId, createdAt])
}

/// IP-Kamera (Reolink) im lokalen Netz. Der Hub spricht sie ueber die
/// CGI-HTTP-API an: Event-Polling (Bewegung/KI) und Schnappschuesse.
/// Zugangsdaten werden nur vom Hub verwendet.
model Camera {
  id         Int           @id @default(autoincrement())
  name       String
  /// Geraetetyp: "REOLINK" (CGI-Polling) | "DOORBIRD" (LAN-API, Klingel + Tueroeffner).
  kind       String        @default("REOLINK")
  /// IP oder Hostname im lokalen Netz.
  host       String
  /// MAC-Adresse (vom Hub automatisch gelernt). Erlaubt IP-Re-Mapping bei
  /// DHCP-Wechsel: Hub sucht die MAC im ARP-Scan und aktualisiert `host`.
  macAddress String?
  httpPort   Int           @default(80)
  https      Boolean       @default(false)
  username   String
  password   String
  /// Kanal: 0 bei Einzelkameras, 0..n hinter einem NVR/Home Hub.
  channel    Int           @default(0)
  enabled    Boolean       @default(true)
  /// Fahrzeug-Erkennung (Burst + Plate-OCR + Sichtungen) auf dieser Kamera.
  vehicleDetection Boolean @default(true)
  notes      String?
  /// Letzter Schnappschuss (JPEG) + Zeitpunkt.
  snapshot   Bytes?
  snapshotAt DateTime?
  /// Zuletzt vom Hub erfolgreich erreicht (Basis fuer Online-Status).
  lastSeenAt DateTime?
  accountId  Int
  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events     CameraEvent[]
  automations ShellyAutomation[]
  vehicleSightings VehicleSighting[]
  allowedVehicles AllowedVehicle[] @relation("VehicleTriggerCamera")
  doorbirdVehicles AllowedVehicle[] @relation("VehicleDoorbird")
  listedPersons   ListedPerson[]
  personSightings PersonSighting[]
  surveillanceCameras SurveillanceCamera[]
  /// Zugangsgeraete (Drehkreuze/Tueren), denen diese Kamera zugeordnet ist.
  devices         Device[]      @relation("DeviceCamera")
  scanSnapshots   ScanSnapshot[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

/// Account-weiter Überwachungsmodus: manuell und/oder per Zeitplan scharf,
/// Push bei PERSON/VEHICLE auf ausgewählten Kameras.
model SurveillanceConfig {
  id              Int      @id @default(autoincrement())
  accountId       Int      @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Manueller Schalter (AN = scharf, unabhängig vom Zeitplan).
  manualArmed     Boolean  @default(false)
  /// Zeitplan aktiv: in Fenster + Wochentag ebenfalls scharf.
  scheduleEnabled Boolean  @default(false)
  /// Bitmaske: Bit0=Mo … Bit6=So.
  daysOfWeek      Int      @default(127)
  windowStart     String?
  windowEnd       String?
  cooldownMinutes Int      @default(5)
  alertOnPerson   Boolean  @default(true)
  alertOnVehicle  Boolean  @default(true)
  /// Bei Sighting mit Snapshot per Telegram (Foto + Caption) benachrichtigen.
  alertTelegram   Boolean  @default(true)
  /// JSON-Map letzter Pushes: { "10:PERSON": "ISO8601", ... }
  lastPushByKey   Json?
  cameras         SurveillanceCamera[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SurveillanceCamera {
  configId Int
  cameraId Int
  config   SurveillanceConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  camera   Camera             @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([configId, cameraId])
  @@index([cameraId])
}

/// Erlaubtes Fahrzeug (Kennzeichen-Whitelist). Bei Erkennung kann ein
/// Shelly geschaltet werden (z. B. Tor oeffnen).
model AllowedVehicle {
  id              Int       @id @default(autoincrement())
  accountId       Int
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Anzeige-Kennzeichen, z. B. "BOR-AB 123".
  plate           String
  /// Normalisiert fuer Abgleich (ohne Leerzeichen/Bindestriche, Grossbuchstaben).
  plateNormalized String
  name            String
  isActive        Boolean   @default(true)
  notes           String?
  /// Nur diese Kamera darf den Shelly ausloesen. null = alle Kameras.
  cameraId        Int?
  camera          Camera?   @relation("VehicleTriggerCamera", fields: [cameraId], references: [id], onDelete: SetNull)
  /// DoorBird, deren Tueroeffner bei Erkennung geschaltet wird (Hub-Task).
  doorbirdCameraId Int?
  doorbird        Camera?   @relation("VehicleDoorbird", fields: [doorbirdCameraId], references: [id], onDelete: SetNull)
  /// Shelly, der bei Erkennung geschaltet wird.
  shellyDeviceId  Int?
  shellyDevice    Device?   @relation(fields: [shellyDeviceId], references: [id], onDelete: SetNull)
  /// ON | OFF | TOGGLE
  shellyAction    String    @default("ON")
  /// Optionaler Auto-Off-Timer in Sekunden (sinnvoll fuer Tore/Impulse).
  timerSeconds    Int?
  /// Mindestabstand zwischen zwei Ausloesungen (Minuten).
  cooldownMinutes Int       @default(2)
  lastTriggeredAt DateTime?
  /// Bei Kennzeichen-Match Web-Push an Account-Geraete senden.
  notifyOnDetection Boolean @default(false)
  sightings       VehicleSighting[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountId, plateNormalized])
  @@index([accountId, isActive])
  @@index([shellyDeviceId])
  @@index([cameraId])
}

/// Historie: wann ein Fahrzeug (ggf. mit Kennzeichen) gesehen wurde.
model VehicleSighting {
  id               Int             @id @default(autoincrement())
  accountId        Int
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cameraId         Int?
  camera           Camera?         @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// Rohes Kennzeichen falls bekannt.
  plate            String?
  plateNormalized  String?
  allowedVehicleId Int?
  allowedVehicle   AllowedVehicle? @relation(fields: [allowedVehicleId], references: [id], onDelete: SetNull)
  /// CAMERA_VEHICLE | CAMERA_PLATE | MANUAL
  source           String          @default("CAMERA_VEHICLE")
  matched          Boolean         @default(false)
  shellyTriggered  Boolean         @default(false)
  shellyOk         Boolean?
  /// Schnappschuss bei Fahrzeugerkennung (JPEG).
  snapshot         Bytes?
  seenAt           DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([accountId, seenAt])
  @@index([cameraId, seenAt])
  @@index([plateNormalized])
  @@index([allowedVehicleId])
}

/// Person auf White- oder Blacklist (z. B. VIP / Hausverbot).
/// Ohne Gesichtserkennung: Automatik nur "jede Person an Kamera X";
/// namentliche Zuordnung erfolgt manuell oder spaeter per Face-ID.
model ListedPerson {
  id                 Int       @id @default(autoincrement())
  accountId          Int
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  /// WHITELIST | BLACKLIST
  listType           String
  isActive           Boolean   @default(true)
  notes              String?
  /// Optionale bevorzugte/Heim-Kamera (Face-Match gilt immer account-weit).
  cameraId           Int?
  camera             Camera?   @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  /// PERSON-Ereignisse in die Historie schreiben (alle Kameras).
  trackHistory       Boolean   @default(true)
  /// Bei Face-Match dieser Person Shelly ausloesen.
  triggerOnDetection Boolean   @default(false)
  /// Bei Face-Match Web-Push an Account-Geraete senden.
  notifyOnDetection  Boolean   @default(false)
  shellyDeviceId     Int?
  shellyDevice       Device?   @relation(fields: [shellyDeviceId], references: [id], onDelete: SetNull)
  shellyAction       String    @default("ON")
  timerSeconds       Int?
  cooldownMinutes    Int       @default(5)
  lastTriggeredAt    DateTime?
  sightings          PersonSighting[]
  faceEmbeddings     PersonFaceEmbedding[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([accountId, listType, isActive])
  @@index([cameraId])
  @@index([shellyDeviceId])
}

/// Face-Embedding (ArcFace/buffalo_l) einer List-Person fuer lokales Matching am Hub.
model PersonFaceEmbedding {
  id               Int          @id @default(autoincrement())
  accountId        Int
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  listedPersonId   Int
  listedPerson     ListedPerson @relation(fields: [listedPersonId], references: [id], onDelete: Cascade)
  /// Float32-Vektor (typ. 512 dims) als Bytes.
  embedding        Bytes
  model            String       @default("buffalo_l")
  sourceSightingId Int?
  createdAt        DateTime     @default(now())

  @@index([accountId, listedPersonId])
  @@index([listedPersonId])
}

/// Historie von Personenerkennungen (anonym oder einer ListedPerson zugeordnet).
model PersonSighting {
  id              Int           @id @default(autoincrement())
  accountId       Int
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cameraId        Int?
  camera          Camera?       @relation(fields: [cameraId], references: [id], onDelete: SetNull)
  listedPersonId  Int?
  listedPerson    ListedPerson? @relation(fields: [listedPersonId], references: [id], onDelete: SetNull)
  /// CAMERA_PERSON | MANUAL
  source          String        @default("CAMERA_PERSON")
  /// WHITELIST | BLACKLIST falls zugeordnet, sonst null
  listType        String?
  matched         Boolean       @default(false)
  /// Cosine-Similarity 0..1 bei Face-Match.
  matchScore      Float?
  /// FACE_EMBEDDING | MANUAL | null
  matchMethod     String?
  shellyTriggered Boolean       @default(false)
  shellyOk        Boolean?
  notes           String?
  /// Schnappschuss bei klarer Personen-/Gesichtserkennung (JPEG).
  snapshot        Bytes?
  seenAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([accountId, seenAt])
  @@index([cameraId, seenAt])
  @@index([listedPersonId])
  @@index([listType, seenAt])
}

/// Bewegungs-/KI-Ereignis einer Kamera, vom Hub per Polling gemeldet.
model CameraEvent {
  id        Int       @id @default(autoincrement())
  cameraId  Int
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  /// "MOTION" | "PERSON" | "VEHICLE" | "ANIMAL" | "OTHER"
  type      String
  startedAt DateTime
  endedAt   DateTime?
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([accountId, startedAt])
  @@index([cameraId, startedAt])
}

/// Vom Hub automatisch entdecktes Geraet im lokalen Netz (ARP-Scan).
/// Wird per (accountId, macAddress) upserted; `lastSeenAt` zeigt, wann das
/// Geraet zuletzt in einem Scan auftauchte.
model DiscoveredDevice {
  id          Int       @id @default(autoincrement())
  macAddress  String
  ipAddress   String?
  /// Netzwerk-Interface des Hubs, auf dem das Geraet gesehen wurde (z. B. "en0").
  iface       String?
  /// Hostname aus Reverse-DNS/mDNS (falls aufloesbar).
  hostname    String?
  /// Hersteller aus dem MAC-OUI-Praefix (falls bekannt).
  vendor      String?
  /// Offene TCP-Ports, z. B. [22, 80, 443].
  openPorts   Json?
  /// Vermuteter Geraetetyp aus offenen Ports/Hostname (Heuristik).
  deviceType  String?
  /// Antwortzeit des letzten Pings in Millisekunden.
  responseMs  Int?
  /// true, wenn das Geraet im letzten Scan auf Ping/Port geantwortet hat.
  reachable   Boolean   @default(true)
  /// Wie oft das Geraet in Folge beim Hub-Scan gefehlt hat (bei Treffer = 0).
  /// Unzugeordnete Eintraege werden ab 2 entfernt.
  absentScans Int       @default(0)
  /// Fruehere IP-Adressen (neueste zuerst): [{ ip, seenUntil }]. Wird beim
  /// IP-Wechsel gefuellt; eine IP "gehoert" immer nur dem zuletzt gesehenen
  /// Geraet, aeltere Eintraege geben sie hierhin ab.
  ipHistory   Json?
  /// Name des Hubs, der das Geraet zuletzt gemeldet hat.
  hubName     String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, macAddress])
  @@index([accountId, lastSeenAt])
}

// ── Audio: Musik & Durchsagen ────────────────────────────────────────────────

/// Dauerquelle, die eine Zone im Hintergrund abspielt.
enum AudioSourceKind {
  SILENCE
  PLAYLIST
  STREAM
}

enum AudioTrackKind {
  MUSIC
  JINGLE
  /// Gong/Signal vor einer Durchsage.
  CHIME
  /// Fertige Ansage – hochgeladen oder aus TTS gerendert.
  ANNOUNCEMENT
}

enum AudioAnnouncementSource {
  /// Text wird serverseitig zu Sprache gerendert und als Track gecacht.
  TTS
  /// Vorproduzierte Datei aus der Bibliothek.
  FILE
  /// Im Browser aufgenommene Live-Durchsage (Push-to-Talk).
  LIVE
}

enum AudioJobKind {
  ANNOUNCE
  PLAY
  STOP
  VOLUME
  /// Zone soll ihren lokalen Dateicache mit der Bibliothek abgleichen.
  SYNC_LIBRARY
}

enum AudioJobStatus {
  PENDING
  SENT
  PLAYING
  DONE
  FAILED
}

enum AudioScheduleAction {
  ANNOUNCE
  PLAY
  STOP
  VOLUME
}

/// Eine Beschallungszone = ein Raspberry-Pi-Abspieler mit angeschlossenem
/// Verstaerker. Haelt Soll-Zustand (Quelle, Lautstaerken) und den vom Pi
/// gemeldeten Ist-Zustand.
model AudioZone {
  id                 Int             @id @default(autoincrement())
  accountId          Int
  account            Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  /// Abspieler-Geraet (Device.type = AUDIO_PLAYER). Zonen koennen auch ohne
  /// Hardware angelegt werden (Planung) – sie spielen dann nichts ab.
  deviceId           Int?            @unique
  device             Device?         @relation("AudioZoneDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  sortOrder          Int             @default(0)
  isActive           Boolean         @default(true)
  /// Snapcast-Gruppe: Zonen mit demselben Namen spielen synchron. Noetig, wenn
  /// sich Bereiche akustisch ueberlappen (Aussengelaende). null = eigenstaendig.
  syncGroup          String?
  /// Grundlautstaerke der Musik (0–100).
  volume             Int             @default(50)
  /// Lautstaerke der Durchsage selbst (0–100).
  announcementVolume Int             @default(85)
  /// Musiklautstaerke waehrend einer Durchsage (Ducking, 0–100).
  duckVolume         Int             @default(15)
  sourceKind         AudioSourceKind @default(SILENCE)
  playlistId         Int?
  playlist           AudioPlaylist?  @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  /// Webradio-/Stream-URL fuer sourceKind = STREAM.
  streamUrl          String?
  /// Ruhezeit "HH:mm"–"HH:mm" (Account-TZ): in diesem Fenster laeuft keine
  /// Musik, Durchsagen aber weiterhin. end < start = ueber Mitternacht.
  quietFrom          String?
  quietTo            String?
  /// Ist-Zustand, vom Pi im Heartbeat gemeldet.
  isPlaying          Boolean         @default(false)
  currentTitle       String?
  reportedVolume     Int?
  lastStateAt        DateTime?
  jobs               AudioJob[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([accountId, sortOrder])
  @@index([playlistId])
}

/// Audiodatei in der Mediathek. Die Datei liegt im Blob-Storage; die Zonen-Pis
/// laden sie einmal herunter und halten sie lokal vor, damit die Wiedergabe
/// auch ohne Internetverbindung funktioniert.
model AudioTrack {
  id            Int                 @id @default(autoincrement())
  accountId     Int
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title         String
  artist        String?
  kind          AudioTrackKind      @default(MUSIC)
  url           String
  /// Blob-Pfad, damit die Datei beim Loeschen des Tracks mit entfernt wird.
  blobPathname  String?
  contentType   String?
  sizeBytes     Int?
  durationSec   Int?
  /// Cache-Schluessel fuer TTS: Hash aus Text + Stimme. Gleicher Text ergibt
  /// denselben Track, sodass keine erneuten TTS-Kosten anfallen.
  ttsHash       String?
  playlistItems AudioPlaylistItem[]
  announcements AudioAnnouncement[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([accountId, ttsHash])
  @@index([accountId, kind])
}

model AudioPlaylist {
  id           Int                 @id @default(autoincrement())
  accountId    Int
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  shuffle      Boolean             @default(true)
  /// Uebergangszeit zwischen zwei Titeln in Sekunden (0 = hart schneiden).
  crossfadeSec Int                 @default(3)
  items        AudioPlaylistItem[]
  zones        AudioZone[]
  schedules    AudioSchedule[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId])
}

model AudioPlaylistItem {
  id         Int           @id @default(autoincrement())
  playlistId Int
  playlist   AudioPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    Int
  track      AudioTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)

  @@index([playlistId, sortOrder])
  @@index([trackId])
}

/// Eine Durchsage – entweder als wiederverwendbare Vorlage (Betriebsschluss,
/// Kursbeginn) oder einmalig aus dem Dashboard abgeschickt.
model AudioAnnouncement {
  id           Int                     @id @default(autoincrement())
  accountId    Int
  account      Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  source       AudioAnnouncementSource @default(TTS)
  /// Ansagetext fuer source = TTS.
  text         String?
  /// Stimmen-ID des TTS-Anbieters. null = Account-Standard.
  voice        String?
  /// Gerenderte bzw. hochgeladene Audiodatei. Bei TTS wird sie beim ersten
  /// Abspielen erzeugt und danach wiederverwendet.
  trackId      Int?
  track        AudioTrack?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  /// Gong vor der Ansage abspielen.
  chime        Boolean                 @default(true)
  repeatCount  Int                     @default(1)
  /// Hoehere Prioritaet unterbricht eine laufende Durchsage (Notfall = 100).
  priority     Int                     @default(0)
  /// Zielzonen als AudioZone-ID-Array. Leeres Array = alle aktiven Zonen.
  zoneIds      Json                    @default("[]")
  /// Vorlage = im Dashboard als Schnellwahl sichtbar und in Zeitplaenen nutzbar.
  isTemplate   Boolean                 @default(false)
  lastPlayedAt DateTime?
  schedules    AudioSchedule[]
  jobs         AudioJob[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([accountId, isTemplate])
  @@index([trackId])
}

/// Zeitgesteuerte Aktion: Oeffnungsmusik, Kursdurchsage, Betriebsschluss.
/// Wird vom selben Cron-Muster ausgewertet wie die Shelly-Automationen.
model AudioSchedule {
  id             Int                 @id @default(autoincrement())
  accountId      Int
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean             @default(true)
  action         AudioScheduleAction
  /// Wochentage als Bitmaske: bit0=Mo, bit1=Di, …, bit6=So. 127 = jeden Tag.
  daysOfWeek     Int                 @default(127)
  /// "HH:mm" in der Account-Zeitzone.
  timeOfDay      String
  /// Zielzonen als AudioZone-ID-Array. Leeres Array = alle aktiven Zonen.
  zoneIds        Json                @default("[]")
  announcementId Int?
  announcement   AudioAnnouncement?  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  playlistId     Int?
  playlist       AudioPlaylist?      @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  /// Ziellautstaerke fuer action = VOLUME (0–100).
  volume         Int?
  /// Letzter Lauf – Idempotenz-Guard im Cron gegen Doppelausfuehrung.
  lastRunAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([accountId, isActive])
  @@index([announcementId])
  @@index([playlistId])
}

/// Kommando an eine Zone plus Verlaufseintrag. Der Zonen-Pi holt offene Jobs
/// ueber den Realtime-Kanal ab und meldet den Status zurueck.
model AudioJob {
  id             Int                @id @default(autoincrement())
  accountId      Int
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  zoneId         Int
  zone           AudioZone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  kind           AudioJobKind
  status         AudioJobStatus     @default(PENDING)
  announcementId Int?
  announcement   AudioAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  /// Kommandoparameter, z. B. { url, volume, playlistId, trackUrls, chime }.
  payload        Json?
  /// Ausloeser: "MANUAL" | "SCHEDULE" | "MONITOR" | "EMERGENCY".
  triggerKind    String             @default("MANUAL")
  errorMessage   String?
  createdAt      DateTime           @default(now())
  sentAt         DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([accountId, createdAt])
  @@index([zoneId, status])
  @@index([announcementId])
}
