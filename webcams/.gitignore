# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lokale Konfiguration (enthält Cam-Passwörter und Doorbird-Secrets)
/config.json
/config.json.tmp
/infra/go2rtc.yaml

# Lokale Logs
/logs/
*.log

# go2rtc binary (vom setup.sh heruntergeladen)
/bin/go2rtc
/bin/*.zip

# pnpm Store (lokal, niemals committen)
/.pnpm-store/

# YOLO-Modellgewichte (werden von ultralytics automatisch geladen)
*.pt

# Python (Tracker-Sidecar)
__pycache__/
*.pyc
/tracker/.venv/
/Ultralytics/
