{
  "regions": ["fra1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/devices/pi/route.ts": {
      "maxDuration": 5,
      "memory": 512
    },
    "src/app/api/devices/pi/scan/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/monitor/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/email/info-requests/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/monitor/public/[token]/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/integrations/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/tick-5min/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/cron/cleanup/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/cron/anny-sync/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/integrations/anny/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/checkin/public/[token]/anny-sync/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/audio-schedules",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/tick-5min",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/anny-sync",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/email-automations",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 1 * * *"
    }
  ]
}
