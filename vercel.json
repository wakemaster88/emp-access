{
  "regions": ["fra1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/devices/pi/route.ts": {
      "maxDuration": 5,
      "memory": 512
    },
    "src/app/api/devices/pi/scan/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/monitor/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/email/info-requests/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/monitor/public/[token]/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/integrations/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/telegram-report",
      "schedule": "0,15,30,45 * * * *"
    },
    {
      "path": "/api/cron/anny-sync",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/shelly-automations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/irrigation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/email-automations",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-tickets",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/cleanup-retention",
      "schedule": "45 1 * * *"
    },
    {
      "path": "/api/cron/device-offline-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/audio-schedules",
      "schedule": "*/5 * * * *"
    }
  ]
}
